<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The same manifest the application ships, for the same reason: measured in a process that is
         not per-monitor DPI aware, these numbers would describe a differently scaled desktop from
         the one the application lays itself out on. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>LayoutProbe</AssemblyName>
    <RootNamespace>LayoutProbe</RootNamespace>
    <!-- The probe supplies its own Application and entry point; the SDK must not look for App.xaml. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OverTranslate\OverTranslate.csproj" />
    <!-- RapidOcrNet brings the CPU onnxruntime 1.27 back in transitively; keep only the DirectML one. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" ExcludeAssets="all" />
  </ItemGroup>

</Project>
