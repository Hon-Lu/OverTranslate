<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WgcProbe</AssemblyName>
    <RootNamespace>WgcProbe</RootNamespace>
    <!-- Same reason as the application: the manifest is the only DPI mechanism that takes effect
         here, because ApplicationConfiguration.Initialize is never called. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OverTranslate\OverTranslate.csproj" />
    <!-- RapidOcrNet brings the CPU onnxruntime 1.27 back in transitively; keep only the DirectML one. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.0" ExcludeAssets="all" />
  </ItemGroup>

</Project>
