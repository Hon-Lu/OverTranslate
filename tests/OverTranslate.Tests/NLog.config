<?xml version="1.0" encoding="utf-8" ?>
<!--
  Overrides the copy of NLog.config that arrives from the OverTranslate project reference.

  Without this, a test run inherits the shipped configuration and writes into
  %AppData%/OverTranslate/logs/app.log — the user's real log. That is not merely untidy: several
  suites exercise failure paths on purpose (SettingsParsingTests feeds malformed JSON, the OCR
  suites drive the engine to its limits), so the log fills with warnings about problems the user
  never had, and those lines compete for the same 15MB archive budget as the diagnostics someone
  reporting a genuine fault will be looking for.

  Nothing is written anywhere. A failing test reports through the test runner, which is where anyone
  running the suite is already looking; a log file would be a second place to remember to check.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      throwConfigExceptions="true">

  <rules>
    <logger name="*" minlevel="Off" final="true" />
  </rules>

</nlog>
