<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Mirror of Strings.zh-Hant.xaml in Korean. Same keys, same {0} placeholders in the same
         meaning — StringsParityTests fails the build if the dictionaries drift apart.

         Written as Korean software rather than as a translation of the Chinese: the sentences are
         rebuilt, not reordered word by word. Feature names are fixed — 캡처 번역, 빠른 조회,
         빠른 번역, 실시간 번역, 텍스트 번역, 플로팅 바 — and a screen that invents its own wording
         for one of them is the thing to catch in review. -->

