<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Mirror of Strings.zh-Hant.xaml in Japanese. Same keys, same {0} placeholders in the same
         meaning — StringsParityTests fails the build if the dictionaries drift apart.

         Written as Japanese software rather than as a translation of the Chinese: the sentences
         are rebuilt, not reordered word by word. Feature names are fixed — キャプチャ翻訳,
         クイック辞書, クイック翻訳, リアルタイム翻訳, テキスト翻訳, フローティングバー — and a
         screen that invents its own wording for one of them is the thing to catch in review. -->

