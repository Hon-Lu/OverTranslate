<UserControl x:Class="OverTranslate.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">

    <UserControl.Resources>
        <!-- One of the eight colours under the picker. The colour is the button's Background; the
             ring round it says it is the colour the picker is on now (Tag "Selected", set in code),
             and its faint twin says where the pointer is. -->
        <Style x:Key="PresetSwatch" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring"
                                     StrokeThickness="2"
                                     Stroke="{DynamicResource AppInputFocusBorder}"
                                     Opacity="0"/>
                            <Ellipse Margin="4"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{DynamicResource ToolbarSwatchEdge}"
                                     StrokeThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The two handles: white rings, so they read on every colour under them, with a hairline of
             shadow for the white end of the square. -->
        <Style x:Key="PickerThumb" TargetType="Ellipse">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.6" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Saturation across, value up: the pure hue at the top right fading to white on the left,
             and everything darkening to black at the bottom. Three layers rather than one brush,
             because WPF has no two-way gradient; the hue is the only one that changes. -->
        <Grid x:Name="SquareArea"
              Height="140"
              Background="Transparent"
              Cursor="Cross"
              MouseLeftButtonDown="Area_MouseLeftButtonDown"
              MouseMove="Area_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp"
              LostMouseCapture="Area_LostMouseCapture"
              SizeChanged="Area_SizeChanged">
            <Border x:Name="HueFill" CornerRadius="8" Background="Red"/>
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FFFFFFFF"/>
                        <GradientStop Offset="1" Color="#00FFFFFF"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border CornerRadius="8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000"/>
                        <GradientStop Offset="1" Color="#FF000000"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="SquareThumb" Width="16" Height="16" Style="{StaticResource PickerThumb}"/>
            </Canvas>
        </Grid>

        <!-- The hue strip. Taller than its bar so the handle, which overhangs it, is all hit area. -->
        <Grid x:Name="HueArea"
              Height="18"
              Margin="0,10,0,0"
              Background="Transparent"
              Cursor="Hand"
              MouseLeftButtonDown="Area_MouseLeftButtonDown"
              MouseMove="Area_MouseMove"
              MouseLeftButtonUp="Area_MouseLeftButtonUp"
              LostMouseCapture="Area_LostMouseCapture"
              SizeChanged="Area_SizeChanged">
            <Border Height="12" CornerRadius="6" VerticalAlignment="Center">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#FF0000"/>
                        <GradientStop Offset="0.1667" Color="#FFFF00"/>
                        <GradientStop Offset="0.3333" Color="#00FF00"/>
                        <GradientStop Offset="0.5" Color="#00FFFF"/>
                        <GradientStop Offset="0.6667" Color="#0000FF"/>
                        <GradientStop Offset="0.8333" Color="#FF00FF"/>
                        <GradientStop Offset="1" Color="#FF0000"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HueThumb" Width="18" Height="18" Style="{StaticResource PickerThumb}"/>
            </Canvas>
        </Grid>

        <!-- What the picker is on, its code, and 返回. -->
        <DockPanel Margin="0,12,0,0" Height="30" LastChildFill="True">
            <Border x:Name="DraftSwatch"
                    DockPanel.Dock="Left"
                    Width="30"
                    CornerRadius="7"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ToolbarSwatchEdge}"/>

            <Button x:Name="UndoBtn"
                    DockPanel.Dock="Right"
                    Style="{StaticResource FlatButton}"
                    Width="30"
                    Height="30"
                    Padding="0"
                    Focusable="False"
                    ToolTip="{DynamicResource S.ColorPicker.Undo}"
                    AutomationProperties.Name="{DynamicResource S.ColorPicker.Undo}"
                    Click="UndoBtn_Click">
                <Path Width="14" Height="14"
                      Stretch="None"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.3"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Data="M5,3.5 L2,6.5 L5,9.5 M2,6.5 H8.5 A3.5,3.5 0 0 1 8.5,13.5 H7"/>
            </Button>

            <Border x:Name="HexField"
                    Margin="8,0"
                    Background="{DynamicResource AppInputBg}"
                    BorderBrush="{DynamicResource AppInputBorder}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Cursor="IBeam"
                    MouseLeftButtonDown="HexField_MouseLeftButtonDown">
                <DockPanel Margin="10,0,6,0">
                    <TextBlock DockPanel.Dock="Left"
                               Text="HEX"
                               VerticalAlignment="Center"
                               FontFamily="Consolas, Cascadia Mono"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondary}"/>
                    <TextBox x:Name="HexBox"
                             Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             BorderThickness="0"
                             Background="Transparent"
                             FontFamily="Consolas, Cascadia Mono"
                             FontSize="13"
                             Foreground="{DynamicResource AppTextPrimary}"
                             CaretBrush="{DynamicResource AppTextPrimary}"
                             SelectionBrush="{DynamicResource AppAccent}"
                             CharacterCasing="Upper"
                             MaxLength="7"
                             InputMethod.IsInputMethodEnabled="False"
                             AutomationProperties.Name="{DynamicResource S.ColorPicker.Hex}"
                             PreviewMouseLeftButtonDown="HexBox_PreviewMouseLeftButtonDown"
                             PreviewTextInput="HexBox_PreviewTextInput"
                             PreviewKeyDown="HexBox_PreviewKeyDown"
                             TextChanged="HexBox_TextChanged"
                             GotKeyboardFocus="HexBox_GotKeyboardFocus"
                             LostKeyboardFocus="HexBox_LostKeyboardFocus"
                             DataObject.Pasting="HexBox_Pasting"/>
                </DockPanel>
            </Border>
        </DockPanel>

        <UniformGrid x:Name="PresetGrid" Columns="8" Margin="-2,10,-2,0"/>
    </StackPanel>
</UserControl>
