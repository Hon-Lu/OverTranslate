<Popup x:Class="OverTranslate.Controls.ToolbarLabel"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:ctl="clr-namespace:OverTranslate.Controls"
       Placement="Relative" AllowsTransparency="True" StaysOpen="True"
       Focusable="False" IsHitTestVisible="False" PopupAnimation="None">
    <!-- No transform, animated or otherwise: it comes and goes by fading only. See Place for why. -->
    <ctl:ToolbarLabelPanel x:Name="LabelPanel" IsHitTestVisible="False">

        <Grid>
            <!-- Shadow on an empty twin, as on the bars themselves. -->
            <Border Background="{DynamicResource TooltipBg}" CornerRadius="9">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270"
                                      Opacity="0.35" Color="#000000"/>
                </Border.Effect>
            </Border>
            <Border Background="{DynamicResource TooltipBg}"
                    BorderBrush="{DynamicResource TooltipBorder}"
                    BorderThickness="1" CornerRadius="9"
                    Padding="12,7,12,8"
                    RenderOptions.ClearTypeHint="Enabled">
                <StackPanel MaxWidth="260">
                    <!-- A DockPanel rather than a horizontal StackPanel, which measures its children
                         at any width they like: a name longer than the card — 暫停 in Russian is —
                         ran off its edge there instead of wrapping. -->
                    <DockPanel>
                        <Path x:Name="LabelTick" Visibility="Collapsed" DockPanel.Dock="Left"
                              Width="14" Height="14" Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource AppSuccess}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Data="M3.2,9.6 L7.2,13.4 L14.8,4.6"/>
                        <TextBlock x:Name="LabelName"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TooltipFg}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock x:Name="LabelDescription"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource TooltipFgDim}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- The point at the button, drawn pointing up; the panel turns it over for a card above the
             button, and lays it a pixel over the card's edge so its fill opens the border where the
             two meet. -->
        <Canvas Width="12" Height="7">
            <Path Data="M0,7 L6,1 L12,7 Z" Fill="{DynamicResource TooltipBg}"/>
            <Path Data="M0,6.5 L6,0.5 L12,6.5"
                  Stroke="{DynamicResource TooltipBorder}" StrokeThickness="1"/>
        </Canvas>
    </ctl:ToolbarLabelPanel>
</Popup>
