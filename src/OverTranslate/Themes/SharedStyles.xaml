<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:OverTranslate.Controls">

    <!-- ═══════════════════════════════════════════ -->
    <!--  FONTS / SIZES                              -->
    <!-- ═══════════════════════════════════════════ -->
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI, Sans-Serif</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="AppFontSize">13</sys:Double>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SECTION HEADER                             -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppSectionHeader}"/>
        <Setter Property="Margin"      Value="0,0,0,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  FIELD LABEL                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"          Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,12,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  FIELD HINT                                 -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="FieldHint" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"     Value="11"/>
        <Setter Property="Foreground"   Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Margin"       Value="2,3,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CARD BORDER                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppCardBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="16,12"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  INNER GROUP BORDER                         -->
    <!--  A group inside a card: same rounding, no   -->
    <!--  fill of its own, so nesting one inside a   -->
    <!--  card reads as grouping rather than as a    -->
    <!--  second card that happens to be smaller.    -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="InnerGroupBorder" TargetType="Border">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TOGGLE ROW BORDER                          -->
    <!--  One switchable option inside a group: an   -->
    <!--  icon, a name, a line of explanation and a  -->
    <!--  switch. Filled rather than outlined, so a  -->
    <!--  row reads as one clickable thing next to   -->
    <!--  the group that holds it.                   -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ToggleRowBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppSurfaceBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Margin"          Value="0,0,0,8"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TOGGLE ROW GLYPH                           -->
    <!--  The picture in front of the name on such   -->
    <!--  a row. Secondary rather than accented, so  -->
    <!--  a column of them reads as a way of telling -->
    <!--  the rows apart at a glance and not as the  -->
    <!--  thing on the row worth looking at.         -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ToggleRowGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"          Value="18"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="2,0,14,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  INFO CARD BORDER                           -->
    <!--  A note the reader is not being asked to    -->
    <!--  act on. Tinted with the accent rather than -->
    <!--  outlined like the groups around it, so it  -->
    <!--  reads as information at a glance instead   -->
    <!--  of as one more control that happens to     -->
    <!--  hold sentences.                            -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="InfoCardBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppInfoBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="Margin"          Value="0,0,0,14"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CARD HEADER ICON                           -->
    <!--  The glyph in front of a card's heading.    -->
    <!--  Accent-coloured so the headings can be     -->
    <!--  found by shape when the page is a grid of  -->
    <!--  cards rather than one column to read down. -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="CardHeaderIcon" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"          Value="18"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppAccent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="0,0,9,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CARD TITLE                                 -->
    <!--  What a card is about. A size up from       -->
    <!--  SectionHeader and in the primary colour,   -->
    <!--  because on a page laid out as a grid of    -->
    <!--  cards these are the landmarks the reader   -->
    <!--  navigates by; SectionHeader stays as it is -->
    <!--  for the sub-headings inside a card.        -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"          Value="15"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TRANSLATION SERVICE MARKS                  -->
    <!--                                             -->
    <!--  Transcribed from the vendors' own SVGs in  -->
    <!--  docs/assets/service-icons — WPF has no     -->
    <!--  SVG loader, and the path data is the whole -->
    <!--  of these files. Re-transcribe rather than  -->
    <!--  redraw if a vendor ships a new mark.       -->
    <!--                                             -->
    <!--  Sized by width in the tiles, not height:    -->
    <!--  DeepL's mark is narrow and tall and         -->
    <!--  OpenAI's is square, so equal heights make   -->
    <!--  the DeepL one the smaller of the two. The   -->
    <!--  width is set against a fixed square that    -->
    <!--  paints nothing — see the tiles: Uniform     -->
    <!--  only shrinks to fit, so without a bounded   -->
    <!--  height a small geometry stays at its own    -->
    <!--  size, which is 19 units for DeepL.          -->
    <!--                                              -->
    <!--  F1 is the nonzero fill rule the SVGs use;   -->
    <!--  WPF geometry defaults to even-odd, which   -->
    <!--  would punch the wrong holes in both.       -->
    <!--                                             -->
    <!--  OpenAI ships a black mark and a white one -->
    <!--  and gets whichever the theme calls for;    -->
    <!--  DeepL ships one drawn in currentColor and  -->
    <!--  is meant to take the colour it is given.   -->
    <!--  Either way the fill is the theme's         -->
    <!--  AppDeepLMark / AppOpenAiMark, never an     -->
    <!--  accent — a mark recoloured to a palette is -->
    <!--  no longer the mark.                        -->
    <!-- ═══════════════════════════════════════════ -->
    <Geometry x:Key="DeepLMarkGeometry">F0 M11.563 0c.24 0 .475.065.682.187l8.197 4.756a1.383 1.383 0 01.683 1.197v9.528c0 .495-.26.949-.683 1.196l-4.79 2.78.01-.002-.155.087-.23.133a.69.69 0 00-.3.563v.386l-.16-.683-2.572 1.493a1.35 1.35 0 01-1.366 0l-8.195-4.757A1.384 1.384 0 012 15.668V6.14c0-.482.26-.936.684-1.183l8.195-4.77c.207-.122.443-.187.684-.187zm-1.27 14.023a1.405 1.405 0 00-2.038-.073 1.43 1.43 0 00.984 2.464c.368 0 .722-.144.985-.401a1.428 1.428 0 00.396-1.384l3.674-2.137-.683-.386-3.317 1.917zM9.24 6.164c-.368 0-.72.145-.983.402a1.43 1.43 0 00-.326 1.592c.075.177.187.338.326.47a1.405 1.405 0 002.021-.055l3.745 2.173.013-.009a1.427 1.427 0 00.368 1.48 1.403 1.403 0 001.967 0 1.428 1.428 0 000-2.063 1.403 1.403 0 00-1.986.02l-3.77-2.201a1.427 1.427 0 00-.39-1.407 1.405 1.405 0 00-.985-.402z M14.978 24v-3.959l-4.781 1.182</Geometry>
    <Geometry x:Key="OpenAiMarkGeometry">F1 M508.749 317.399C516.777 287.314 508.991 253.884 485.389 230.282C461.788 206.681 428.36 198.895 398.273 206.923C376.231 184.928 343.39 174.956 311.148 183.596C278.906 192.234 255.45 217.292 247.36 247.361C217.291 255.451 192.233 278.91 183.595 311.149C174.957 343.391 184.927 376.232 206.924 398.274C198.896 428.359 206.683 461.789 230.284 485.391C253.885 508.992 287.313 516.779 317.401 508.75C339.442 530.745 372.286 540.717 404.525 532.079C436.767 523.441 460.223 498.384 468.313 468.315C498.383 460.224 523.44 436.766 532.078 404.526C540.716 372.285 530.747 339.443 508.749 317.402V317.399ZM470.899 244.776C486.892 260.77 493.488 282.601 490.687 303.412L415.577 260.046C412.411 258.218 408.509 258.218 405.345 260.046L317.401 310.82V277.526C317.401 275.191 318.652 273.005 320.676 271.837L387.644 233.174C414.178 218.353 448.346 222.223 470.901 244.776H470.899ZM357.837 311.144L398.275 334.491V381.185L357.837 404.532L317.398 381.185V334.491L357.837 311.144ZM264.776 269.693C265.207 239.305 285.644 211.649 316.453 203.393C338.3 197.54 360.505 202.744 377.127 215.573L302.014 258.937C298.848 260.764 296.898 264.144 296.898 267.798V369.346L268.065 352.699C266.043 351.531 264.776 349.353 264.776 347.017V269.691V269.693ZM203.391 316.454C209.244 294.608 224.854 277.978 244.276 269.999V356.73C244.276 360.384 246.226 363.763 249.392 365.591L337.337 416.365L308.503 433.013C306.481 434.181 303.961 434.188 301.939 433.02L234.971 394.357C208.868 378.789 195.138 347.261 203.391 316.454ZM244.775 470.9C228.781 454.906 222.186 433.075 224.986 412.264L300.096 455.63C303.263 457.457 307.164 457.457 310.328 455.63L398.273 404.856V438.149C398.273 440.485 397.022 442.671 394.997 443.839L328.029 482.502C301.495 497.322 267.327 493.452 244.772 470.9H244.775ZM450.897 445.982C450.466 476.371 430.029 504.027 399.22 512.283C377.373 518.136 355.168 512.932 338.547 500.102L413.659 456.738C416.826 454.911 418.775 451.532 418.775 447.877V346.329L447.609 362.977C449.631 364.145 450.897 366.323 450.897 368.659V445.985V445.982ZM512.282 399.221C506.429 421.068 490.819 437.697 471.397 445.676V358.946C471.397 355.292 469.448 351.912 466.281 350.085L378.336 299.311L407.17 282.663C409.192 281.495 411.712 281.487 413.734 282.655L480.702 321.318C506.805 336.887 520.536 368.415 512.282 399.221Z</Geometry>

    <!-- ═══════════════════════════════════════════ -->
    <!--  DRAWN MARKS                                -->
    <!--                                             -->
    <!--  The four feature icons and the play-pause  -->
    <!--  mark, drawn rather than taken from an icon -->
    <!--  font. Segoe has no single glyph for any of -->
    <!--  them, and the near-misses it does have     -->
    <!--  disagree with each other in weight and     -->
    <!--  optical size once they sit in one column.  -->
    <!--  Drawn to one grid they read as a set, and  -->
    <!--  Windows 10 gets the same picture as 11 —   -->
    <!--  the Fluent codepoints that come closest    -->
    <!--  are simply absent from Segoe MDL2 Assets,  -->
    <!--  which is the font Windows 10 falls back to.-->
    <!-- ═══════════════════════════════════════════ -->

    <!-- All five are drawn on the same 16×16 grid at their natural size — no Stretch, because
         Stretch scales the geometry and leaves StrokeThickness where it was, which is how a set
         like this drifts out of weight. A caller that needs a different size gets it by editing
         the grid, not by stretching one mark. -->
    <Style x:Key="DrawnMark" TargetType="Path">
        <!-- Follows inherited Foreground the way a glyph TextBlock would, so NavItem's IsChecked
             trigger recolours icon and label together with one setter. Call sites that sit on an
             accent tile set Stroke outright instead. -->
        <Setter Property="Stroke"
                Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
        <Setter Property="StrokeThickness"     Value="1.2"/>
        <Setter Property="StrokeLineJoin"      Value="Round"/>
        <Setter Property="StrokeStartLineCap"  Value="Round"/>
        <Setter Property="StrokeEndLineCap"    Value="Round"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>

    <!-- 截圖翻譯: framing corners around a crosshair — the gesture the feature actually asks for
         (drag a region), not a camera, which would promise a photo rather than a translation. -->
    <Geometry x:Key="CaptureMarkGeometry">M1.4,5 V2.8 A1.4,1.4 0 0 1 2.8,1.4 H5 M11,1.4 H13.2 A1.4,1.4 0 0 1 14.6,2.8 V5 M14.6,11 V13.2 A1.4,1.4 0 0 1 13.2,14.6 H11 M5,14.6 H2.8 A1.4,1.4 0 0 1 1.4,13.2 V11 M8,5.4 V10.6 M5.4,8 H10.6</Geometry>

    <!-- 取詞翻譯: a magnifier with a letter in it. The lens alone reads as search; the letter is
         what makes it "look this word up". -->
    <Geometry x:Key="QuickLookupMarkGeometry">M0.8,6.9 A6.1,6.1 0 1 1 13,6.9 A6.1,6.1 0 1 1 0.8,6.9 Z M11.3,11.3 L15.2,15.2 M4.95,9.3 L6.9,3.9 L8.85,9.3 M5.42,8 H8.38</Geometry>

    <!-- The ⓘ that opens a note under a settings row. Drawn rather than set as Segoe's E946,
         which is the only way to know where it is: a glyph is positioned inside a line box by its
         font's own metrics, so aligning it with the text beside it means aligning two boxes whose
         contents sit at different heights within them — and it moves again on any machine that
         falls back to another icon font. A path has no metrics but its own coordinates.

         Twelve units rather than the sixteen the feature marks use, because that is the size it is
         drawn at. The circle reaches the edges of that box, so the box centre is the mark's centre,
         and the row can place it by measurement — see the note rows in SettingsPage.xaml. -->
    <Geometry x:Key="InfoMarkGeometry">M0.55,6 A5.45,5.45 0 1 0 11.45,6 A5.45,5.45 0 1 0 0.55,6 Z M6,3.15 L6,3.25 M6,5.3 L6,8.9</Geometry>

    <!-- 快速翻譯: A and 文 each on their own tile, with an arrow curving from one to the other and
         back. Converted from the drawing this feature's icon was designed as, scaled into the same
         16-unit square the marks around it are drawn in.

         Three layers because the tiles are filled and the letters are knocked out of them, which no
         single Path can do: the fill, the letters, then the arrows over both. They are stacked in
         SettingsPage.xaml, which is the only place they are used, and each one is given the same
         explicit 16x16 box there — a Shape left to size itself is placed by its own bounds, and
         three layers with different bounds would each sit somewhere else.

         No frame around the whole thing, unlike a shipped app icon: 設定's rows put every mark on a
         tile already.

         The two tiles. -->
    <Geometry x:Key="QuickTranslateTilesGeometry">M1.951 1.311 H6.672 A1.246 1.246 0.0 0 1 7.918 2.557 V7.279 A1.246 1.246 0.0 0 1 6.672 8.525 H1.951 A1.246 1.246 0.0 0 1 0.705 7.279 V2.557 A1.246 1.246 0.0 0 1 1.951 1.311 Z M9.328 8.525 H14.049 A1.246 1.246 0.0 0 1 15.295 9.77 V14.492 A1.246 1.246 0.0 0 1 14.049 15.738 H9.328 A1.246 1.246 0.0 0 1 8.082 14.492 V9.77 A1.246 1.246 0.0 0 1 9.328 8.525 Z</Geometry>

    <!-- A and 文, knocked out of the tiles above them. F1 is the nonzero fill rule the drawing was
         authored with; the counter of the A is a hole only under that rule. -->
    <Geometry x:Key="QuickTranslateGlyphsGeometry">F1 M2.158 7.213 H3.153 L3.498 5.952 H5.085 L5.43 7.213 H6.465 L4.892 2.295 H3.731 ZM3.711 5.189 3.857 4.651 C4.003 4.14 4.142 3.583 4.275 3.045 H4.302 C4.448 3.569 4.58 4.14 4.733 4.651 L4.879 5.189 Z M11.158 9.794 C11.273 10.009 11.387 10.293 11.442 10.497 H9.324 V11.08 H10.112 C10.381 11.783 10.729 12.386 11.178 12.884 C10.66 13.288 10.012 13.572 9.23 13.766 C9.349 13.906 9.529 14.185 9.593 14.329 C10.396 14.095 11.068 13.761 11.622 13.313 C12.15 13.756 12.793 14.085 13.58 14.294 C13.67 14.13 13.849 13.871 13.984 13.736 C13.231 13.567 12.603 13.268 12.085 12.874 C12.528 12.391 12.867 11.798 13.121 11.08 H13.889 V10.497 H11.716 L12.14 10.363 C12.08 10.158 11.93 9.839 11.796 9.605 ZM11.631 12.466 C11.248 12.072 10.949 11.603 10.729 11.08 H12.454 C12.249 11.628 11.98 12.087 11.631 12.466 Z</Geometry>

    <!-- The two arrows, stroked rather than filled. The drawing's own 2.8 comes to 0.92 once
         scaled; the row draws them at 1.05 instead, because every mark beside this one is a 1.2
         outline and arrows a third lighter than their neighbours read as a different set. -->
    <Geometry x:Key="QuickTranslateArrowsGeometry">M13.0 6.623 V4.951 C13.0 2.918 11.557 1.574 9.459 1.574 H8.705 M9.852 0.459 L8.705 1.574 L9.852 2.689 M2.213 9.377 V11.049 C2.213 13.082 3.656 14.426 5.754 14.426 H6.508 M5.361 13.311 L6.508 14.426 L5.361 15.541</Geometry>

    <!-- 文字翻譯: a letter in a field — text you type in, as against text the app goes and finds
         for you. -->
    <Geometry x:Key="TextTranslateMarkGeometry">M4.2,1.2 H11.8 A3,3 0 0 1 14.8,4.2 V11.8 A3,3 0 0 1 11.8,14.8 H4.2 A3,3 0 0 1 1.2,11.8 V4.2 A3,3 0 0 1 4.2,1.2 Z M5.6,5.5 H10.4 M8,5.5 V10.5</Geometry>

    <!-- 即時翻譯: a running waveform. The one mark in the set that says "still going" rather than
         "happens once", which is the only thing separating this from the other three. -->
    <Geometry x:Key="RealtimeMarkGeometry">M3,5.8 V10.2 M5.5,3.4 V12.6 M8,1.9 V14.1 M10.5,4.4 V11.6 M13,6.4 V9.6</Geometry>

    <!-- 暫停/繼續. Segoe has Play (E768) and Pause (E769) and nothing that shows both, but the
         設定 row names one shortcut that does either, so neither glyph on its own is honest. The
         gap after the triangle is wider than the one between the bars, so the mark reads as two
         symbols rather than one crowded shape.

         The triangle's corners are curved in the geometry rather than left to StrokeLineJoin,
         which only ever rounds by half the stroke width — 0.6 here, against the 1.4 corners of
         截圖翻譯 and the 3.0 of 文字翻譯. Read next to those, a join-rounded triangle is the one
         hard shape in the set. Curve radius 1.2 softens the apex without blunting it — 1.8
         was tried and goes blobby, and a filled triangle reads as a foreign body in a set
         that is otherwise all outline.

         The triangle is 7.0 wide and 11.6 tall, and the bars are held to 10.2 — shorter than
         the triangle rather than level with it. A triangle carries less optical weight than a
         bar of the same height, so drawing all three to one height makes the play half look
         undersized next to the pause half. The whole mark still sits a little shorter than the
         other four, which stand about 13: play-pause is a wide shape, and matching their
         height outright would make it the loudest row in the list. -->
    <Geometry x:Key="PlayPauseMarkGeometry">M3.57,3.83 L7.49,7.08 Q8.6,8 7.49,8.92 L3.57,12.17 Q1.6,13.8 1.6,11.25 L1.6,4.75 Q1.6,2.2 3.57,3.83 Z M11.9,2.9 V13.1 M14.5,2.9 V13.1</Geometry>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SERVICE TILE                               -->
    <!--  One translation service that has something -->
    <!--  to configure. Filled rather than outlined  -->
    <!--  like a card, so a row of them reads as a   -->
    <!--  set of choices inside the card holding     -->
    <!--  them and not as more cards.                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ServiceTileBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppSurfaceBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="14,12"/>
    </Style>

    <!-- The tile's state word. The fill and the text colour say which state it is, so both are
         written from code-behind; everything that is the same in all three states lives here. -->
    <Style x:Key="ServiceBadgeBorder" TargetType="Border">
        <Setter Property="CornerRadius"       Value="4"/>
        <Setter Property="Padding"            Value="7,2"/>
        <Setter Property="VerticalAlignment"  Value="Center"/>
    </Style>

    <Style x:Key="ServiceBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="11"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TRANSPARENCY CHECKER                       -->
    <!--  Backdrop for the subtitle preview: it says -->
    <!--  "whatever is behind this" without claiming -->
    <!--  to know what that is.                      -->
    <!--                                             -->
    <!--  Two fixed mid-greys in both themes, not    -->
    <!--  theme brushes. The real backdrop is a game -->
    <!--  or a video, and a checker that went light  -->
    <!--  in the light theme would make a white band -->
    <!--  look invisible and a black one look far    -->
    <!--  heavier than it is. Mid-grey lies about    -->
    <!--  neither, which is the same reason the flat -->
    <!--  grey it replaces was fixed too.            -->
    <!-- ═══════════════════════════════════════════ -->
    <DrawingBrush x:Key="TransparencyChecker"
                  TileMode="Tile"
                  Viewport="0,0,16,16"
                  ViewportUnits="Absolute"
                  Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#6E6E6E">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#636363">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8"/>
                            <RectangleGeometry Rect="8,8,8,8"/>
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TOGGLE SWITCH                              -->
    <!--  For a setting that turns something on, as  -->
    <!--  opposed to ModernCheckBox's "this box is   -->
    <!--  ticked". The knob follows the text colour  -->
    <!--  when off and the accent's foreground when  -->
    <!--  on, so it stays legible in both themes.    -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- The knob slides and the two states cross-fade, which is what a switch is: the same object
         moving rather than one picture replaced by another. Built as two stacked tracks and two
         stacked knobs whose opacity is animated, because the colours come from the theme as shared
         brushes and a ColourAnimation cannot touch those. The knob's travel is the track's width
         less the knob and its two margins: 44 - 16 - 3 - 3. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor"             Value="Hand"/>
        <Setter Property="VerticalAlignment"  Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="44" Height="24" Background="Transparent">
                        <Border x:Name="TrackOff"
                                CornerRadius="12"
                                Background="{DynamicResource AppButtonBg}"
                                BorderBrush="{DynamicResource AppButtonBorder}"
                                BorderThickness="1"/>
                        <Border x:Name="TrackOn"
                                CornerRadius="12"
                                Background="{DynamicResource AppAccent}"
                                BorderBrush="{DynamicResource AppAccent}"
                                BorderThickness="1"
                                Opacity="0"/>
                        <Border x:Name="TrackHover"
                                CornerRadius="12"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AppInputFocusBorder}"
                                BorderThickness="1"
                                Opacity="0"/>
                        <Grid x:Name="KnobHost"
                              Width="16" Height="16"
                              HorizontalAlignment="Left"
                              Margin="3,0,0,0">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Grid.RenderTransform>
                            <Border x:Name="KnobOff"
                                    CornerRadius="8"
                                    Background="{DynamicResource AppTextPrimary}"/>
                            <Border x:Name="KnobOn"
                                    CornerRadius="8"
                                    Background="{DynamicResource AppToggleKnobOn}"
                                    Opacity="0"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="22" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobOn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="KnobOff"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.16"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackHover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ICON + TEXT BUTTON                         -->
    <!--  A borderless action that sits beside real  -->
    <!--  controls: no chrome at rest, and a hover   -->
    <!--  box that wraps its own content rather than -->
    <!--  the whole cell it happens to occupy.       -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="IconTextButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="30"/>
        <Setter Property="Padding"         Value="10,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TEXTBOX (single-line)                      -->
    <!--  TextBox applies Padding to its content;    -->
    <!--  don't repeat it on the ScrollViewer.       -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="FontFamily"              Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"                Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"              Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"              Value="{DynamicResource AppInputBg}"/>
        <Setter Property="CaretBrush"              Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="SelectionBrush"          Value="{DynamicResource AppAccent}"/>
        <Setter Property="BorderBrush"             Value="{DynamicResource AppInputBorder}"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="Height"                  Value="34"/>
        <Setter Property="Padding"                 Value="9,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppInputFocusBorder}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TEXTBOX (multi-line, in a settings field)  -->
    <!--  ModernTextBox with the content host let    -->
    <!--  out of its single-line centring.           -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="SettingsMultilineTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="Height"                   Value="Auto"/>
        <Setter Property="MinHeight"                Value="96"/>
        <Setter Property="Padding"                  Value="14,10"/>
        <!-- Prose, not a value: lines need room to be read as a paragraph. -->
        <Setter Property="TextBlock.LineHeight"     Value="21"/>
        <Setter Property="AcceptsReturn"            Value="True"/>
        <Setter Property="TextWrapping"             Value="Wrap"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppInputFocusBorder}"/>
                            <Setter TargetName="Root" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  PROMPT ROLE BLOCK                          -->
    <!--  One titled panel per chat role — System    -->
    <!--  Prompt above, User Prompt below — used by  -->
    <!--  both the preview beside the prompt list    -->
    <!--  and the editor card, so the two read as    -->
    <!--  the same object seen twice.                -->
    <!--                                             -->
    <!--  The title sits on the panel's own header    -->
    <!--  strip, the same shape the parameter table  -->
    <!--  uses, rather than on a filled bar of the   -->
    <!--  accent colour: two of those stacked would  -->
    <!--  be the loudest thing on a page whose point -->
    <!--  is the prose underneath. The accent is on  -->
    <!--  the word instead, which is enough to name  -->
    <!--  a region without competing with it.        -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- The model and its three sampling parameters, above the two prompt panels. Four small cards
         rather than four rows of label-and-value text: this pane answers "what is this setting", and
         as prose the answer read as a form someone had not finished filling in. A card with an icon
         on it is a thing; a label with a value beside it is a field. -->
    <Style x:Key="ProfileCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppInputBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="10"/>
    </Style>

    <!-- The tinted square an icon sits in. AppAccentSubtle rather than the accent at an opacity,
         because opacity on the well would take the glyph inside down with it. -->
    <Style x:Key="ProfileCardIconWell" TargetType="Border">
        <Setter Property="Background"   Value="{DynamicResource AppAccentSubtle}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Width"        Value="34"/>
        <Setter Property="Height"       Value="34"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ProfileCardIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- What the value underneath is. Small and quiet: on four cards read together, four labels at
         the same weight as their values would be half the ink saying nothing new. -->
    <Style x:Key="ProfileCardLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"    Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"      Value="11"/>
        <Setter Property="Foreground"    Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="TextTrimming"  Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="ProfileCardValue" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"     Value="15"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Margin"       Value="0,1,0,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- A model name is an identifier: it is copied from a guide and matched character by character
         against what is installed, which is the one job a fixed pitch does better. Smaller than the
         numbers beside it because it is long, and a name that wraps stops being one line to compare. -->
    <Style x:Key="ProfileCardMono" TargetType="TextBlock" BasedOn="{StaticResource ProfileCardValue}">
        <Setter Property="FontFamily" Value="Consolas, Cascadia Mono"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- The mark beside an advanced parameter's name. What the parameter does is a paragraph, and a
         paragraph under every row would push the three rows apart until the fold read as a page;
         asked for rather than displayed is the right trade for prose that is read once. The tooltip
         itself is set per row, since that is the only thing that differs between them. -->
    <Style x:Key="ParamInfo" TargetType="TextBlock">
        <Setter Property="Text"       Value="&#xE946;"/>
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"     Value="6,0,0,0"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
        <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
    </Style>

    <!-- The group the prompt panels live in, in the editor. The label, the sentence under it and the
         two panels were four things stacked at the same level, which read as four unrelated rows;
         one border around them says they are one field with parts. -->


    <!-- Multi-line textbox (translation content area) -->
    <Style x:Key="MultilineTextBox" TargetType="TextBox">
        <Setter Property="FontFamily"              Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"                Value="14"/>
        <Setter Property="Foreground"              Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"              Value="{DynamicResource AppSurfaceBg}"/>
        <Setter Property="CaretBrush"              Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="SelectionBrush"          Value="{DynamicResource AppAccent}"/>
        <Setter Property="BorderThickness"         Value="0"/>
        <Setter Property="Padding"                 Value="14,12"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextWrapping"            Value="Wrap"/>
        <Setter Property="AcceptsReturn"           Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Auto"
                                      Focusable="False"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  FLAT BUTTON                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"      Value="{DynamicResource AppButtonBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="9,0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ACCENT BUTTON                              -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="AccentButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppAccentFg}"/>
        <Setter Property="Background"      Value="{DynamicResource AppAccent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="16,0"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  DEEP ACCENT BUTTON                         -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- An accent button that carries white text in both themes. AppAccent cannot: in the dark
         theme it is a pale cyan that takes black text, and white on it lands at 1.97:1 — well
         under the 4.5:1 a label needs. The ToolbarPrimary* brushes are named for the first place
         that hit this, but what they actually are is "a blue deep enough for white text, and the
         accent itself in the light theme", which is exactly what is needed here too, so they are
         reused rather than duplicated under a second name.

         The one structural difference from AccentButton: the ContentPresenter stretches, so the
         content can pin something to the button's own edge instead of everything being centred. -->
    <Style x:Key="DeepAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Foreground" Value="{DynamicResource ToolbarPrimaryFg}"/>
        <Setter Property="Background" Value="{DynamicResource ToolbarPrimaryBg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarPrimaryHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarPrimaryPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ICON BUTTON                                -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="32"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  COMBOBOX                                   -->
    <!--  Key fix: ContentPresenter Margin="9,0,28,0"-->
    <!--  (right=28 leaves room for the 24px arrow)  -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- The toggle button draws the border + arrow; no Content needed -->
    <ControlTemplate x:Key="ComboBoxToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="Root"
                Background="{DynamicResource AppInputBg}"
                BorderBrush="{DynamicResource AppInputBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <Path x:Name="Arrow"
                  Data="M0,0 L4,4 L8,0"
                  Stroke="{DynamicResource AppTextSecondary}"
                  StrokeThickness="1.5"
                  Width="8" Height="4"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0"
                  Stretch="None"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background"
                        Value="{DynamicResource AppButtonHoverBg}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Root" Property="BorderBrush"
                        Value="{DynamicResource AppInputFocusBorder}"/>
                <Setter TargetName="Root" Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════ -->
    <!--  COMBO BOX SEARCH FIELD                     -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- What a searchable picker turns into while its list is open: the closed box's own label
         replaced by a caret, in the same place, at the same size. See ComboBoxSearch for what
         drives it.

         Chrome-less on purpose — no border, no background, no corner of its own. It is laid over the
         spot where the selected language was, inside the border the toggle button is already
         drawing, so opening the list does not redraw the control, it only changes what the control
         is showing. Anything of its own here would be a second box inside the first.

         In the picker rather than in the dropdown, and that is not a cosmetic choice: a WPF Popup is
         a window Windows never activates, so Win32 focus stays on the main window while the list is
         down. An IME asks the focused window where the caret is, and a window with no caret answers
         with nothing — which is why a 注音 user composing into a field inside the popup got the
         composition box parked in the corner of the screen instead of under their cursor. Typed here,
         in the window that actually holds focus, composition is inline like every other field.

         The placeholder is inside the template because this field appears already focused and empty;
         the label saying what to type has to be where the typing will go, and has to leave the
         moment anything arrives. No MinWidth: the field is exactly as wide as the picker, and a
         query longer than that scrolls the way any other text box's does. -->
    <Style x:Key="ComboSearchBox" TargetType="TextBox">
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="Padding"                  Value="0"/>
        <Setter Property="Foreground"               Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="CaretBrush"               Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="SelectionBrush"           Value="{DynamicResource AppAccent}"/>
        <Setter Property="FontFamily"               Value="{DynamicResource AppFont}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <!-- The glyph belongs to the placeholder, not to the field: it goes when
                             the first character arrives, along with the words beside it. Keeping it
                             would mean indenting what is typed past it, and this field is laid over
                             the spot where the selected language was — text that starts anywhere
                             else makes the label appear to jump when the list opens. -->
                        <StackPanel x:Name="Placeholder"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.Common.SearchLanguage}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      Focusable="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The line the list is replaced by when a query matches nothing. Its own element rather than a
         list entry, because an entry is something the user can land on and pick. -->
    <Style x:Key="ComboSearchEmptyText" TargetType="TextBlock">
        <Setter Property="Text"                Value="{DynamicResource S.Common.SearchNoMatch}"/>
        <Setter Property="FontFamily"          Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"            Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"          Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Margin"              Value="12,10,12,12"/>
        <Setter Property="TextWrapping"        Value="Wrap"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Visibility"          Value="Collapsed"/>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily"              Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"                Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"              Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"              Value="{DynamicResource AppInputBg}"/>
        <Setter Property="BorderBrush"             Value="{DynamicResource AppInputBorder}"/>
        <Setter Property="BorderThickness"         Value="1"/>
        <Setter Property="Height"                  Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- ItemTemplate replaces DisplayMemberPath so SelectionBoxItemTemplate is populated
             and the selected-item ContentPresenter shows text instead of LangItem.ToString() -->
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding Display}"
                               FontFamily="{DynamicResource AppFont}"
                               TextTrimming="CharacterEllipsis"/>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="FontFamily"  Value="{DynamicResource AppFont}"/>
                    <Setter Property="FontSize"    Value="{StaticResource AppFontSize}"/>
                    <Setter Property="Foreground"  Value="{DynamicResource AppTextPrimary}"/>
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="Padding"     Value="9,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="ItemRoot"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="4"
                                        Margin="3,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemRoot" Property="Background"
                                                Value="{DynamicResource AppButtonHoverBg}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ItemRoot" Property="Background"
                                                Value="{DynamicResource AppAccentSubtle}"/>
                                    </Trigger>
                                    <!-- Arrowing out of a searchable picker's search box lands
                                         keyboard focus on an entry, and focus is not IsHighlighted:
                                         without this the list looks unchanged and the user cannot
                                         tell what Enter is about to pick. Last, so it wins over the
                                         selected entry's own colour — the entry about to be chosen
                                         is the one that has to be legible. -->
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="ItemRoot" Property="Background"
                                                Value="{DynamicResource AppButtonHoverBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- The toggle button provides the visual border + arrow -->
                        <ToggleButton x:Name="ToggleButton"
                                      Template="{StaticResource ComboBoxToggleTemplate}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"/>

                        <!-- Selected item text: right margin=28 clears the 24px arrow + gap -->
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="9,0,28,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>

                        <!-- Sits exactly where the selected item's label was, and replaces it while
                             the list is down. Inside the toggle button's border rather than in the
                             dropdown — see ComboSearchBox for why the IME needs it in this window. -->
                        <TextBox x:Name="PART_SearchBox"
                                 Style="{StaticResource ComboSearchBox}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Margin="9,0,28,0"
                                 Visibility="Collapsed"/>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="PART_DropDown"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource AppCardBg}"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0,4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                                                      Opacity="0.15" Color="#000000"/>
                                </Border.Effect>
                                <!-- The empty-search line shares the list's space rather than taking
                                     a row of its own: it is only ever shown when every entry is
                                     hidden, which is exactly when the list takes no room. The names
                                     are duplicated in QuickLookup's QuietComboBox rather than shared
                                     — the behaviour finds them through the ComboBox's own template,
                                     and a name inside another template's namescope is not findable
                                     from there. -->
                                <Grid>
                                    <ScrollViewer x:Name="PART_ItemsScroll"
                                                  CanContentScroll="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>

                                    <TextBlock x:Name="PART_NoResults"
                                               Style="{StaticResource ComboSearchEmptyText}"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="ctl:ComboBoxSearch.IsEnabled" Value="True">
                            <!-- Pixel scrolling while filtering. Item scrolling counts the panel's
                                 children, collapsed ones included, so a list with most of its
                                 entries hidden scrolls in jumps of items that are not there. -->
                            <Setter TargetName="PART_ItemsScroll" Property="CanContentScroll" Value="False"/>
                        </Trigger>
                        <!-- The field is only there while the list is: a picker sitting closed is a
                             label, not something to type into, and leaving a text box in the closed
                             state would put a caret in every language picker in the app. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ctl:ComboBoxSearch.IsEnabled" Value="True"/>
                                <Condition Property="IsDropDownOpen" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_SearchBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </MultiTrigger>
                        <!-- MinWidth already ties the list's floor to the picker; this ties the
                             ceiling to it as well, which is the whole of "same width". Pixel
                             scrolling for the same reason the filtered lists use it — a horizontal
                             scrollbar over logical scrolling moves in units of whole items. -->
                        <Trigger Property="ctl:ComboBoxDropDown.FitsControlWidth" Value="True">
                            <Setter TargetName="PART_DropDown" Property="MaxWidth"
                                    Value="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_ItemsScroll" Property="CanContentScroll" Value="False"/>
                            <Setter TargetName="PART_ItemsScroll" Property="HorizontalScrollBarVisibility"
                                    Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  RADIO BUTTON (theme selector pill style)   -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="DebugScopeRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="18" Height="18" Margin="0,0,10,0">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource AppInputBorder}" StrokeThickness="1.5"/>
                            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource AppAccentFg}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeRadioButton" TargetType="RadioButton">
        <Setter Property="FontFamily"  Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Margin"      Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource AppButtonBg}"
                            BorderBrush="{DynamicResource AppButtonBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Indicator"
                                     Width="13" Height="13"
                                     Margin="0,0,7,0"
                                     Stroke="{DynamicResource AppInputBorder}"
                                     StrokeThickness="1.5"
                                     Fill="Transparent"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Indicator" Property="Fill"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Indicator" Property="Stroke"
                                    Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SEGMENTED RADIO (compact value picker)     -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- For a small set of short, mutually exclusive values (1 / 2 / 3) where the value itself is
         the label. ThemeRadioButton spends a 13px indicator on saying "this is a choice", which for
         a row of numerals is more chrome than content — here the filled state carries that instead. -->
    <!-- ── Stepper ─────────────────────────────────────────────────────────────────────────────
         A read-only number with a button either side, for a value that lives in a range of two or
         three. The number is a TextBlock rather than a TextBox on purpose: a field that accepts
         typing invites 0, 99, empty and "一", each of which then needs a rule and an error state,
         and none of that buys anything for a value with three legal settings.

         Shaped like the app's other inputs — same corner radius, same border, same height as
         ModernComboBox — so it reads as one of them rather than as a pair of loose buttons. -->
    <Style x:Key="StepperBorder" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppInputBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppInputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Height"          Value="34"/>
    </Style>

    <Style x:Key="StepperButton" TargetType="Button">
        <!-- Segoe's own plus and minus glyphs rather than the characters: they are drawn to the
             same optical weight as the rest of the icon set, where a text "−" is a different
             thickness and sits off the centre line. -->
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Width"      Value="34"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="5" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonBg}"/>
                        </Trigger>
                        <!-- At the ends of the range the button stays in place and goes quiet,
                             rather than disappearing and shifting the number sideways. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="StepperValue" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"            Value="{StaticResource AppFontSize}"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="Foreground"          Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment"       Value="Center"/>
        <!-- Fixed, so stepping never nudges the buttons in and out by a digit's width -->
        <Setter Property="MinWidth"            Value="28"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  NUMBERED STEP                              -->
    <!--  A card that is one step of an ordered set: -->
    <!--  the badge and what the step is down the    -->
    <!--  left, the controls for it on the right.    -->
    <!--  The number is the whole point — a page of  -->
    <!--  cards says these are settings, a page of   -->
    <!--  numbered cards says do this one first.     -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="StepBadge" TargetType="Border">
        <Setter Property="Width"        Value="22"/>
        <Setter Property="Height"       Value="22"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Background"   Value="{DynamicResource AppAccent}"/>
    </Style>

    <Style x:Key="StepBadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily"           Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"             Value="12"/>
        <Setter Property="FontWeight"           Value="SemiBold"/>
        <Setter Property="Foreground"           Value="{DynamicResource AppAccentFg}"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
    </Style>

    <Style x:Key="StepLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"          Value="12"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppAccent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="8,0,0,0"/>
    </Style>

    <Style x:Key="StepTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"    Value="15"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Margin"      Value="0,8,0,0"/>
    </Style>

    <Style x:Key="StepDescription" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
        <Setter Property="Margin"       Value="0,8,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight"   Value="18"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CHOICE TILE                                -->
    <!--  One option of a small set, chosen by       -->
    <!--  looking rather than by reading: an icon in -->
    <!--  its own tile, the name beside it, a line   -->
    <!--  under the name saying what it does, and a  -->
    <!--  radio mark at the far end. All of it is    -->
    <!--  one press target.                          -->
    <!--                                             -->
    <!--  The mark is drawn in both states rather    -->
    <!--  than appearing on the chosen one: an       -->
    <!--  empty ring is what tells the reader the    -->
    <!--  other tile is also selectable, which a     -->
    <!--  tile with nothing on it does not.          -->
    <!--                                             -->
    <!--  Only the icon takes the accent when chosen.-->
    <!--  The name stays as it was: it is the same   -->
    <!--  word either way, and recolouring it makes  -->
    <!--  the two tiles read as different kinds of   -->
    <!--  thing rather than as one choice.           -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ChoiceTile" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{DynamicResource AppInputBg}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>

                            <!-- A ring, thickened into a filled disc when chosen, so the two states
                                 are the same shape in the same place and only the weight changes. -->
                            <Border x:Name="Mark"
                                    Grid.Column="1"
                                    Width="18" Height="18"
                                    Margin="12,0,2,0"
                                    CornerRadius="9"
                                    BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AppTextSecondary}"
                                    Background="Transparent"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtle}"/>
                            <Setter TargetName="Mark" Property="BorderBrush"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Mark" Property="BorderThickness" Value="5"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppButtonBorder}"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The icon's own tile. Its fill has to follow the tile's state, and it lives in the content
         rather than the template because each tile draws a different glyph — so it asks the
         RadioButton above it what state it is in instead of being told. -->
    <Style x:Key="ChoiceTileIconBox" TargetType="Border">
        <Setter Property="Width"              Value="40"/>
        <Setter Property="Height"             Value="40"/>
        <Setter Property="CornerRadius"       Value="8"/>
        <Setter Property="Background"         Value="{DynamicResource AppButtonBg}"/>
        <Setter Property="VerticalAlignment"  Value="Center"/>
        <Setter Property="Margin"             Value="0,0,14,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                         Value="True">
                <Setter Property="Background" Value="{DynamicResource AppAccentSubtleHover}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChoiceTileGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily"           Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"             Value="19"/>
        <Setter Property="Foreground"           Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                         Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChoiceTileTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  VERTICAL SEPARATOR (toolbar divider)       -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="VerticalSeparator" TargetType="Separator">
        <Setter Property="Width"      Value="1"/>
        <Setter Property="Height"     Value="18"/>
        <Setter Property="Margin"     Value="5,0"/>
        <Setter Property="Background" Value="{DynamicResource AppSeparator}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Fill="{TemplateBinding Background}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  TOOLBAR VARIANTS (compact height=28)       -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ToolbarComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
        <Setter Property="Height"      Value="30"/>
        <Setter Property="FontSize"    Value="12"/>

        <!-- The list shows a language both ways, the closed box shows one. The pair is there to be
             scanned: someone hunting through thirty languages wants to find theirs by either name.
             Once it is chosen there is nothing left to scan, and "繁體中文 Traditional Chinese" sitting
             in a 132px box was a label that could not even finish saying itself — it was shown as
             "繁體中文 Traditi…". The name alone fits, and the bar gets the rest of the width back.

             One template does both, because ComboBox draws the closed box from ItemTemplate as well
             as the list. The two are told apart by what is above them: an item in the list is inside
             a ComboBoxItem, the closed box is not, so a missing ancestor is what says "this is the
             closed one". Nothing about the list changes — open it and it is the same list as before.

             ToolbarComboBox only. The settings pages keep the pair everywhere, where there is room
             for it and the pickers are read rather than glanced at. -->
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock x:Name="Label"
                               Text="{Binding Display}"
                               FontFamily="{DynamicResource AppFont}"
                               TextTrimming="CharacterEllipsis"/>
                    <DataTemplate.Triggers>
                        <DataTrigger Value="{x:Null}"
                                     Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}}">
                            <Setter TargetName="Label" Property="Text" Value="{Binding ShortName}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CAPTURE TOOLBAR                            -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- The one button on the capture toolbar that starts work. A full-radius pill rather than the
         6px corner every other button here has: colour alone stopped separating it once the actions
         beside it grew their own icons, and shape survives being looked at out of the corner of an
         eye, which is how a bar floating over the user's own screen is read. -->
    <Style x:Key="ToolbarPrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Height"     Value="32"/>
        <Setter Property="Padding"    Value="14,0"/>
        <Setter Property="FontSize"   Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource ToolbarPrimaryFg}"/>
        <Setter Property="Background" Value="{DynamicResource ToolbarPrimaryBg}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- A little of the pill's own colour cast on the bar under it, so it reads
                             as sitting on the bar rather than as a shape laid over it. On a twin
                             behind the button rather than on the button: an Effect rasterises what
                             it is set on, and ClearType cannot run over that - which would have cost
                             this label the crispness the whole bar was just given. Hardcoded because
                             an Effect takes a Color and not a Brush, so it cannot follow a themed
                             resource; it is the same blue in both themes. -->
                        <Border Background="{TemplateBinding Background}"
                                Margin="3"
                                CornerRadius="13">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.5" Color="#3B82F6"/>
                            </Border.Effect>
                        </Border>

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}"
                                RenderOptions.ClearTypeHint="Enabled">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarPrimaryHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarPrimaryPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A secondary action on the capture toolbar: its icon over its name, both centred. The label
         stays because none of these icons is standard enough to be read cold — and a toolbar the
         user meets mid-task, over their own screen, is the wrong place to make them hover to find
         out. The icon carries the accent and the label stays plain text, so a row of them reads as
         one rhythm instead of five coloured words.

         Stacked rather than side by side because the row grew to five: laid out in a line each
         action was as wide as its own name, and a bar that already carries three pickers and a
         segmented switch could not absorb another one of those. Over the name the icon costs no
         width at all, the actions come out near enough the same size as each other to scan as a
         set, and the bar gets back roughly what the fifth action took. -->

    <!-- The slot an action's icon is drawn into, above its name. Fixed on both axes and identical on
         every button, which is the entire reason it exists: a typed glyph's line box and a drawn
         14×14 icon are different heights, and dropped straight into the stack each would put the
         label under it at its own height — five actions, five baselines, a row that will not sit
         still. One slot size makes the five labels one line. -->
    <Style x:Key="ToolbarActionIcon" TargetType="Grid">
        <Setter Property="Width"               Value="20"/>
        <Setter Property="Height"              Value="20"/>
        <Setter Property="Margin"              Value="0,0,0,2"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- A typed icon inside that slot. Centred both ways rather than laid out from the top, because
         what the slot is holding is the glyph's ink, not its line box. -->
    <Style x:Key="ToolbarActionGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"            Value="16"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Foreground"          Value="{DynamicResource AppAccent}"/>
    </Style>

    <!-- The canvas every action icon is drawn on: 18×18, centred in the 20 slot. The paths are
         written against it in absolute coordinates and left at Path's default Stretch of None —
         scaling a 1.4px stroke is what turns a crisp icon soft — so they need a box of exactly the
         size they were drawn for.

         One canvas for all five, which is the point of it: an icon set is read as a set, and a set
         is what a row stops being the moment one mark is a third larger than its neighbour. The
         four typed glyphs this row used to carry could not be held to that — a font's ink fills its
         em box by its own rules, and a shared FontSize only makes the boxes equal, not the marks
         inside them. -->
    <Style x:Key="ToolbarActionDrawing" TargetType="Grid">
        <Setter Property="Width"               Value="18"/>
        <Setter Property="Height"              Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>

    <!-- The one pen every one of those icons is drawn with. Outlines rather than solids, and one
         weight across the row: five marks at one thickness read as one family, and the accent is
         carried by the strokes alone so the labels under them can stay plain text. -->
    <Style x:Key="ToolbarActionStroke" TargetType="Path">
        <Setter Property="Stroke"              Value="{DynamicResource AppAccent}"/>
        <Setter Property="StrokeThickness"     Value="1.4"/>
        <Setter Property="StrokeLineJoin"      Value="Round"/>
        <Setter Property="StrokeStartLineCap"  Value="Round"/>
        <Setter Property="StrokeEndLineCap"    Value="Round"/>
    </Style>

    <!-- The same pen again, for an icon that stands for a tool rather than for an action: it takes
         the colour of the button it is drawn on, which means neutral while the tool is on the shelf
         and accent while it is the one in hand.

         Why the two differ. On the capture bar every icon is something to do, all six are equally
         available, and painting them all accent makes the row read as one set of actions. In the
         標記 panel one of the three is being held — that is the panel's whole state — and a row of
         identically accented tools would leave the outlined plate to say it on its own. Colour is
         the stronger signal of the two, so it goes to the tool that is in hand. -->
    <Style x:Key="ToolbarToolStroke" TargetType="Path" BasedOn="{StaticResource ToolbarActionStroke}">
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
    </Style>

    <Style x:Key="ToolbarStackButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <!-- An edge that is there but invisible, so the one action in this row that can be
             switched on — 標記, which shows its state as an outline — is not a hair wider than
             the four beside it that cannot. -->
        <Setter Property="BorderThickness" Value="1"/>
        <!-- Wide enough that a two-character name still leaves the icon above it room to breathe.
             The height is the stack's 37 — a 20 icon slot, 2 of gap and one 11px line — plus a
             margin of its own, so the surface that appears on hover reads as a button around the
             two lines rather than as a box drawn tight against them. -->
        <Setter Property="MinWidth"        Value="50"/>
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Padding"         Value="8,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The same shape again for an action that is either on or off — 標記 on the capture bar, and
         the three tools inside its panel. Checked it takes an outlined, tinted plate: the row it
         sits in is otherwise flat, so an outline is the one thing in it that cannot be mistaken for
         a hover. The label goes accent along with the icon, which is the only place on these bars
         where that happens and is exactly why it reads as a state rather than as emphasis. -->
    <Style x:Key="ToolbarStackToggleButton" TargetType="ToggleButton">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="Transparent"/>
        <Setter Property="MinWidth"        Value="50"/>
        <Setter Property="Height"          Value="46"/>
        <Setter Property="Padding"         Value="8,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover is for the unchecked state only: over the checked plate it would be
                             a second surface laid on the one already there. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One colour in the 標記 palette. The mark of the chosen one is a ring drawn outside the disc,
         not a tick laid over it: a tick has to be a colour, and any colour it could be is one of the
         eight underneath it — white on white, black on black. A ring set off the edge stays legible
         against every swatch because it never touches one. -->
    <Style x:Key="AnnotationSwatchButton" TargetType="ToggleButton">
        <Setter Property="Width"   Value="30"/>
        <Setter Property="Height"  Value="30"/>
        <Setter Property="Margin"  Value="3,0"/>
        <Setter Property="Cursor"  Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Ellipse x:Name="Ring"
                                 Stroke="{DynamicResource AppAccent}"
                                 StrokeThickness="2"
                                 Visibility="Collapsed"/>
                        <!-- The hairline is what keeps the white swatch on a light bar and the black
                             one on a dark bar from disappearing into it. -->
                        <Ellipse x:Name="Disc"
                                 Margin="5"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{DynamicResource ToolbarSwatchEdge}"
                                 StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Disc" Property="Margin" Value="3.5"/>
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square raised tile for the one control on the bar that carries no name: the speaker at
         the head of it. Everything else in the action row says what it is in a word underneath, so a
         bare glyph sitting among them would read as a name that failed to load. Given a surface and
         an edge instead, it reads as its own thing — which is what it is: it belongs to the source
         picker beside it, not to the row of actions at the far end. -->
    <Style x:Key="ToolbarTileButton" TargetType="Button" BasedOn="{StaticResource ToolbarStackButton}">
        <Setter Property="Background"      Value="{DynamicResource ToolbarGroupBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource ToolbarBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth"        Value="0"/>
        <Setter Property="Width"           Value="38"/>
        <Setter Property="Height"          Value="38"/>
        <Setter Property="Padding"         Value="0"/>
        <!-- Its own template, for the same reason ToastIconButton has one: BasedOn cannot reach the
             hover and pressed brushes named inside the inherited one, and the bar's steps are
             measured against the bar — against this raised surface the light theme's would be a
             four-value change nobody can see. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarGroupHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarGroupPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One half of a two-way switch on a floating toolbar: the tray around it is the same raised
         tray the realtime bar groups its two buttons in, and the chosen half is marked by a pill
         that slides between them rather than by a fill on the button itself.

         Which is why this template paints nothing while it is checked. The pill is a separate Border
         behind both halves — the only way a moving marker can be animated at all, since a background
         on the button can only appear and disappear — so a checked background here would cover it.
         The button contributes the label, the hover step, and nothing else.

         The 偵錯工具 card in 設定 now says its either/or the same way, with a style of its own for
         the halves: same mechanism, but sized and spaced for a page rather than for a bar the
         user meets over their own screen. -->
    <Style x:Key="ToolbarSegmentButton" TargetType="RadioButton">
        <Setter Property="FontFamily"         Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"           Value="11"/>
        <Setter Property="Foreground"         Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Height"             Value="26"/>
        <Setter Property="Padding"            Value="10,0"/>
        <Setter Property="Cursor"             Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover is for the half that is not chosen: on the chosen one it would be a
                             second surface laid over the pill already there. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked"   Value="False"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarGroupHoverBg}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        </MultiTrigger>
                        <!-- Colour only. Weight was the obvious other half of this and had to go: the
                             two halves share a width, that width is the wider label's, and a label
                             that grows when it is chosen changes which label is wider. The whole bar
                             sizes to its content and re-centres on the selection, so in English the
                             act of choosing moved the bar four pixels sideways under the pointer. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor"  Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The direction mark in front of a segment's label: strokes standing for lines of text, the
         last one short the way a last line is. The two are the same drawing a quarter turn apart,
         and the short stroke lands where that script's last line really is — the bottom for
         horizontal text, the left for vertical, which is also what says the columns run right to
         left. Drawn rather than typed because no icon font ships either shape. -->
    <Style x:Key="ToolbarSegmentGlyph" TargetType="Path">
        <Setter Property="Width"              Value="14"/>
        <Setter Property="Height"             Value="14"/>
        <Setter Property="Stretch"            Value="None"/>
        <Setter Property="StrokeThickness"    Value="1.5"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap"   Value="Round"/>
        <Setter Property="VerticalAlignment"  Value="Center"/>
        <Setter Property="Margin"             Value="0,0,6,0"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
    </Style>

    <Style x:Key="ToolbarFlatButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Height"      Value="28"/>
        <Setter Property="Padding"     Value="10,0"/>
        <Setter Property="FontSize"    Value="12"/>
    </Style>

    <Style x:Key="ToolbarAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Height"      Value="28"/>
        <Setter Property="Padding"     Value="10,0"/>
        <Setter Property="FontSize"    Value="12"/>
    </Style>

    <Style x:Key="ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width"       Value="28"/>
        <Setter Property="Height"      Value="28"/>
        <Setter Property="FontSize"    Value="13"/>
    </Style>

    <!-- Icon buttons that sit inside a raised group tray rather than directly on the bar. Their
         template is repeated rather than inherited for the same reason ToastIconButton repeats it:
         BasedOn cannot reach the hover and pressed brushes named inside it, and against the tray the
         bar's own steps are too close to its surface to be seen. -->
    <Style x:Key="ToolbarGroupIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarGroupHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToolbarGroupPressedBg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The toast is dark in both themes, so its buttons need their own brushes rather than the
         themed ones IconButton carries. Its template is repeated instead of inherited because
         BasedOn cannot reach the hover and pressed brushes named inside that template. -->
    <Style x:Key="ToastIconButton" TargetType="Button" BasedOn="{StaticResource ToolbarIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource ToastIconFg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToastIconHoverBg}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource ToastIconFgHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource ToastIconPressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle accent (tonal): a lighter accent than the solid primary button, so it shares the
         accent hue for an alternating rhythm but never competes with the one true primary action.
         Fills with the solid accent on hover. -->
    <Style x:Key="ToolbarSubtleAccentButton" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppAccent}"/>
        <Setter Property="Background"      Value="{DynamicResource AppAccentSubtle}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppAccent}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,0"/>
        <Setter Property="Height"          Value="28"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AppAccentFg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentPressed}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AppAccentFg}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  CHECKBOX                                   -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="ModernCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily"              Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"                Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"              Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Cursor"                  Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Width="16" Height="16"
                                CornerRadius="3"
                                BorderBrush="{DynamicResource AppInputBorder}"
                                BorderThickness="1.5"
                                Background="Transparent"
                                Margin="0,0,8,0">
                            <TextBlock x:Name="Check"
                                       Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{DynamicResource AppAccentFg}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background"   Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Box" Property="BorderBrush"  Value="{DynamicResource AppAccent}"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush"  Value="{DynamicResource AppInputFocusBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SLIM PROGRESS BAR (flat, rounded)          -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="SlimProgressBar" TargetType="ProgressBar">
        <Setter Property="Height"      Value="6"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppAccent}"/>
        <Setter Property="Background"  Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="3"/>
                            <!-- Deliberately NOT named PART_GlowRect: ProgressBar claims that name
                                 and replaces its RenderTransform with one it never animates, which
                                 leaves the bar frozen. Driving it from the template instead. -->
                            <Rectangle x:Name="IndeterminateGlow"
                                       Width="90"
                                       HorizontalAlignment="Left"
                                       RadiusX="3" RadiusY="3"
                                       Fill="{TemplateBinding Foreground}"
                                       Visibility="Collapsed">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="-90"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator"    Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="IndeterminateGlow" Property="Visibility" Value="Visible"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="GlowLoop">
                                    <Storyboard RepeatBehavior="Forever">
                                        <!-- Travels past the widest bar this style is used at; the
                                             surrounding Grid clips the overshoot. -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndeterminateGlow"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="-90" To="460" Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="GlowLoop"/>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  PAGE HEADER (shell content pages)          -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Foreground"   Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Margin"       Value="0,4,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SHELL SURFACES                             -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- The two panels the shell window is built from: the nav rail and the page. Both are cards
         floating on the window's own surface with a gap between them, rather than two regions
         meeting at a seam — so no edge here is ever drawn on the side that faces the other panel,
         and the boundary the user sees is the gap itself.

         Opaque, not tinted: the page card is what the content transition's bitmap cache renders
         into, and ClearType cannot run over a surface WPF believes may be transparent. -->
    <Style x:Key="ShellCard" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppCardBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  WINDOW CAPTION BUTTONS                     -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- Windows' own geometry — 46x32, glyph-only, square, flush to the window's top-right corner —
         because this strip is the one part of an application nobody wants redesigned. Only the
         colours are the application's.

         Square, unlike every other control here: these run to the window's edges, and a rounded
         corner would leave a wedge of window background outside a button that the user still
         expects to hit. -->
    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="FontFamily"  Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Width"       Value="46"/>
        <Setter Property="Height"      Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rail's show/hide switch, at the caption strip's leading edge. Deliberately not one of
         the caption buttons opposite it: those are the system's strip, square and flush to the
         window's corner because that is what every window does with that corner. This one belongs
         to the application, so it takes the application's shape — a 6-radius tile, inset from the
         edge, sized to the 40 strip with room left around it.

         Quieter than the caption glyphs until it is pointed at: it is a preference about the
         window's layout, and one that sits beside the app's own name and icon. Hover brings it to
         full strength, so the strip does not carry a control at full contrast that most sessions
         never touch. -->
    <Style x:Key="WindowSidebarToggle" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"   Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Width"      Value="32"/>
        <Setter Property="Height"     Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AppTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close is the one caption button with a colour of its own, and it is the system's red rather
         than the application's accent: it means "this is the destructive one" in every window the
         user has ever closed, and the accent means "this is the one we would like you to press". -->
    <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F1707A"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SIDEBAR NAV                                -->
    <!--  Selected state lives on RadioButton's      -->
    <!--  IsChecked, so grouping is free. Icon and   -->
    <!--  label inherit Foreground so one trigger    -->
    <!--  recolours both.                            -->
    <!-- ═══════════════════════════════════════════ -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily"  Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Margin="8,2"
                            Padding="12,0"
                            Height="40">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtle}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AppAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The rail's "there is a newer version" badge, under the version number it contradicts.
         A badge rather than a nav row: it states a fact about this copy of the application, which
         is what that corner of the rail is already for, and it is absent whenever the fact is not
         true. Sizing follows the version label it hangs off (11px) rather than the nav items, so it
         reads as an annotation on the brand block instead of a fourth destination.

         Tonal fill with no accent outline. RailQuickTool's accent-tinted icon tile is what the
         快速工具 rows use to claim the rail's actions, and competing with it here would have news
         out-shouting the buttons the user actually came for. The border is one step up the same
         tonal ramp — just enough to give the fill an edge on the sidebar's own background.

         Fully rounded, unlike every other surface in the app at 6. That is the point: a pill is the
         shape of a label, a 6px rectangle is the shape of a button, and this is a statement about
         the application that happens to be clickable rather than a control the rail is offering.

         Hover and press walk AppAccentSubtle's own steps rather than the neutral button greys: a
         tinted surface that turns grey under the pointer reads as a different control appearing. -->
    <Style x:Key="RailUpdateChip" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppAccent}"/>
        <Setter Property="Background"      Value="{DynamicResource AppAccentSubtle}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppAccentSubtleHover}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9.5"
                            Padding="9,0"
                            Height="19">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtleHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtlePressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same visuals, no selected state — for actions that open a dialog
         rather than switching pages (關於) -->
    <Style x:Key="NavActionItem" TargetType="Button">
        <Setter Property="FontFamily"  Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"    Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Margin="8,2"
                            Padding="12,0"
                            Height="36">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 快速工具 rows (截圖翻譯, 取詞翻譯) — the rail's actions, as opposed to the destinations
         NavItem carries below them. A card rather than a bare row is what says so: a neutral
         surface lifted one step off the rail's own background, with the accent living only in the
         icon tile, so two of these side by side stay a group instead of two walls of colour.

         Both rows carry the identical treatment on purpose. Neither one is the primary — the shell
         is the only place either shortcut is named, and ranking them here would leave the loser
         looking like a lesser copy of the winner.

         Deliberately NOT ToolbarSubtleAccentButton's flip to a solid accent fill on hover: at
         full-rail width that is a wall of colour. Hover walks the accent's own tonal ramp and
         brings the border with it, so the card lights up without changing material.

         No drop shadow, and no effect anywhere in the template: any element carrying an Effect
         pushes its whole subtree through an intermediate render surface, where ClearType sub-pixel
         antialiasing cannot run — text inside a shadowed Border came out visibly soft next to the
         nav items. Same trap ShellWindow's page transition documents for BitmapCache. -->
    <Style x:Key="RailQuickTool" TargetType="Button">
        <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"        Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"      Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="Background"      Value="{DynamicResource AppCardBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 8 margin + 1 border + 11 of padding = 20, which is where NavItem's own
                         12 puts its glyph: one left edge down the whole rail. -->
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Margin="8,3"
                            Padding="11,0"
                            Height="46">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtle}"/>
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource AppAccentSubtleHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppAccentSubtlePressed}"/>
                        </Trigger>
                        <!-- 截圖翻譯 is switched off for the length of a realtime session, and its
                             tooltip is then the only place that reason exists — so the card has to
                             read as unavailable rather than as missing. -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The accent-tinted square behind a 快速工具 row's glyph. A tile here and a bare glyph on the
         nav items below is what separates the rail's two halves at a glance, without a second
         divider or a second type size. -->
    <Style x:Key="RailQuickToolIcon" TargetType="Border">
        <Setter Property="Width"               Value="30"/>
        <Setter Property="Height"              Value="30"/>
        <Setter Property="CornerRadius"        Value="7"/>
        <Setter Property="Background"          Value="{DynamicResource AppAccentSubtle}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource AppAccentSubtleHover}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="Margin"              Value="0,0,10,0"/>
    </Style>

    <Style x:Key="RailQuickToolGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily"          Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"            Value="15"/>
        <Setter Property="Foreground"          Value="{DynamicResource AppAccent}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
    </Style>

    <!-- The shortcut trailing a 快速工具 row: a reference the user reads once, not a second label
         competing with the row's name. -->
    <Style x:Key="RailQuickToolHotkey" TargetType="TextBlock">
        <Setter Property="FontFamily"        Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"          Value="11"/>
        <Setter Property="Foreground"        Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin"            Value="8,0,0,0"/>
    </Style>

    <!-- Circular close button for the modal overlay -->
    <Style x:Key="OverlayCloseButton" TargetType="Button">
        <Setter Property="FontFamily"  Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="Foreground"  Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background"  Value="{DynamicResource AppButtonBg}"/>
        <Setter Property="Width"       Value="30"/>
        <Setter Property="Height"      Value="30"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Content"     Value="&#xE711;"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonHoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource AppButtonPressedBg}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SCROLLBAR (Win11-style auto-expand)        -->
    <!--  Implicit style: applies to every scrolling -->
    <!--  surface (translation panes, combo popups). -->
    <!--  Outer width stays 12 in both states so the -->
    <!--  expansion never reflows the text beside it -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Click-on-track paging areas; invisible but hit-testable -->
    <Style x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="IsTabStop"  Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="IsTabStop"  Value="False"/>
        <Setter Property="Background" Value="{DynamicResource AppScrollThumb}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- CornerRadius 4 pills the thumb at both 3px and 8px widths -->
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppScrollThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppScrollThumbPressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border x:Name="TrackBg"
                    Background="{DynamicResource AppScrollTrack}"
                    CornerRadius="6"
                    Margin="1,0"
                    Opacity="0"/>
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                  Style="{StaticResource ScrollBarPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="ScrollThumb"
                           Style="{StaticResource ScrollBarThumb}"
                           Width="3" MinHeight="28"
                           HorizontalAlignment="Center"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                  Style="{StaticResource ScrollBarPageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- Bound to the ScrollViewer, not the ScrollBar: the bar expands as soon as
                 the pointer enters the scrolling area, so it is already grabbable -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                         Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScrollThumb"
                                             Storyboard.TargetProperty="Width"
                                             To="8" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TrackBg"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.13"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScrollThumb"
                                             Storyboard.TargetProperty="Width"
                                             To="3" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TrackBg"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.13"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Border x:Name="TrackBg"
                    Background="{DynamicResource AppScrollTrack}"
                    CornerRadius="6"
                    Margin="0,1"
                    Opacity="0"/>
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand"
                                  Style="{StaticResource ScrollBarPageButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb x:Name="ScrollThumb"
                           Style="{StaticResource ScrollBarThumb}"
                           Height="3" MinWidth="28"
                           VerticalAlignment="Center"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand"
                                  Style="{StaticResource ScrollBarPageButton}"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                         Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScrollThumb"
                                             Storyboard.TargetProperty="Height"
                                             To="8" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TrackBg"
                                             Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.13"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ScrollThumb"
                                             Storyboard.TargetProperty="Height"
                                             To="3" Duration="0:0:0.13">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TrackBg"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.13"/>
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Width"       Value="12"/>
        <Setter Property="MinWidth"    Value="12"/>
        <Setter Property="Template"    Value="{StaticResource VerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="MinWidth"  Value="0"/>
                <Setter Property="Height"    Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template"  Value="{StaticResource HorizontalScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!--  SLIDER                                     -->
    <!-- ═══════════════════════════════════════════ -->
    <!-- Templated rather than left to the stock one, which draws itself from the Windows classic
         palette and would arrive as a grey Win95 track in both of this app's themes. The parts are
         the standard ones — a Track with two RepeatButtons and a Thumb — so keyboard, page-click and
         drag all keep working; only the paint is ours. -->
    <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Background"            Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <!-- Transparent rather than absent, so clicking anywhere along the track still
                         reaches the RepeatButton and pages towards the click. -->
                    <Border Background="{TemplateBinding Background}"
                            Height="4"
                            CornerRadius="2"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width"  Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="Dot"
                             Fill="{DynamicResource AppAccent}"
                             Stroke="{DynamicResource AppCardBg}"
                             StrokeThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AppAccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AppAccentPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppSlider" TargetType="Slider">
        <Setter Property="Height"               Value="24"/>
        <Setter Property="SmallChange"          Value="1"/>
        <Setter Property="LargeChange"          Value="10"/>
        <!-- A click on the track jumps to that point rather than paging towards it. For a value the
             user is judging by eye against a preview, "put it there" is the whole interaction. -->
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="4"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppInputBorder}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <!-- The filled half: the same bar as the track, painted accent, so
                                     how far along the value sits reads without the number. -->
                                <RepeatButton Command="Slider.DecreaseLarge"
                                              Style="{StaticResource SliderTrackFill}"
                                              Background="{DynamicResource AppAccent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge"
                                              Style="{StaticResource SliderTrackFill}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slider on the 標記 panel, with its name over it and its two ends named underneath. Three
         styles rather than three copies of the same properties, because the panel now carries two of
         these side by side and they have to be the same object twice, not two similar ones. -->
    <Style x:Key="AnnotationSliderTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Margin"     Value="1,0,0,2"/>
    </Style>

    <Style x:Key="AnnotationSlider" TargetType="Slider" BasedOn="{StaticResource AppSlider}">
        <Setter Property="Width"      Value="118"/>
        <Setter Property="Minimum"    Value="0"/>
        <Setter Property="Maximum"    Value="1"/>
        <Setter Property="SmallChange" Value="0.1"/>
        <Setter Property="LargeChange" Value="0.25"/>
    </Style>

    <!-- Dimmer and a size down from the name above: these two are read once, to learn which way the
         slider runs, and never again. At the same weight as the name they would compete with it for
         a control that only has one thing to say. -->
    <Style x:Key="AnnotationSliderEnd" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="10.5"/>
        <Setter Property="Margin"     Value="1,1,1,0"/>
    </Style>


    <!-- Nothing is painted under the pointer, only the words brighten: this sits alone between
         the fields and the prompt, and a filled box coming up around two characters there reads
         as damage rather than as a control. Its own template because FlatButton is built the
         other way round — a surface that fills. -->
    <Style x:Key="AdvancedToggleRow" TargetType="Button">
        <Setter Property="FontFamily"          Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"            Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"          Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Height"              Value="30"/>
        <Setter Property="Padding"             Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Transparent rather than left unpainted: an unpainted Border is only
                         hit-testable where its child's own strokes are, so the pointer would
                         find the row between the letters and nowhere else. -->
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ══════════ Prompt tab ══════════ -->
    <!-- A page header, not a control to set: the underline is the whole of the selected look,
         so nothing here can be mistaken for a switch that is on. -->
    <Style x:Key="PromptTab" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Height"     Value="42"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="12,0"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        <!-- Drawn even while unselected, in nothing: it holds the two pixels
                             the selected tab needs, so selecting one does not lift its label. -->
                        <Border x:Name="Underline"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Underline" Property="Background"
                                    Value="{DynamicResource AppAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PromptGroupBorder" TargetType="Border">
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="14,12"/>
    </Style>

    <Style x:Key="PromptRoleFrame" TargetType="Border">
        <Setter Property="BorderBrush"   Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"  Value="6"/>
        <!-- The header fills to the corners, so the frame has to cut it. -->
        <Setter Property="ClipToBounds"  Value="True"/>
        <Setter Property="Background"    Value="{DynamicResource AppInputBg}"/>
    </Style>

    <!-- AppHeaderBg rather than AppSurfaceBg, for the reason the parameter table gives: the light
         theme paints surface and card the same white, so that one would separate nothing there. -->
    <Style x:Key="PromptRoleHeaderBar" TargetType="Border">
        <Setter Property="Background"      Value="{DynamicResource AppHeaderBg}"/>
        <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <!-- One less than the frame's, which is the inside of a 1px border. Set here rather than
             left to the frame's ClipToBounds: a Border clips to its rectangle, not to its rounded
             corners, so the strip's square top corners were drawn over the frame's curve. -->
        <Setter Property="CornerRadius"    Value="5,5,0,0"/>
        <Setter Property="Padding"         Value="12,6"/>
    </Style>

    <!-- The action that belongs to one prompt box, on that box's own caption row. Icon only and
         pushed to the right: a word beside "System Prompt" would compete with the name of the field
         it sits in, and what it does is in the tooltip. -->
    <Style x:Key="PromptRoleAction" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Width"            Value="24"/>
        <Setter Property="Height"           Value="22"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Margin"           Value="8,0,0,0"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderBrush"      Value="Transparent"/>
        <Setter Property="FontFamily"       Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize"         Value="12"/>
        <Setter Property="Foreground"       Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Left-aligned and small. "System Prompt" is a term of art the reader either knows or is
         about to learn from the box under it; centring it would make a banner of a label. -->
    <!-- A field label with a sentence of its own directly underneath it. FieldLabel is secondary
         and so is FieldHint, which leaves the two reading as one paragraph in two sizes; this one
         takes the primary colour and a step of weight so the label is the label and the line under
         it is a note about it. Colour alone was not enough beside a control as loud as the
         segmented switch it shares its row with. -->
    <Style x:Key="FieldLabelStrong" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- A step up from the 11 a section header takes: these name the box under them rather than a
         region of the card, and at 11 they were smaller than the prose they introduce. -->
    <Style x:Key="PromptRoleLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PromptRoleBodyText" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"     Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground"   Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="TextBlock.LineHeight" Value="21"/>
        <Setter Property="LineHeight"   Value="21"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Says the half is deliberately empty. Without it an unused role is an unexplained blank
         panel, which reads as something failing to load. -->
    <Style x:Key="PromptRoleEmptyText" TargetType="TextBlock" BasedOn="{StaticResource PromptRoleBodyText}">
        <Setter Property="Opacity"    Value="0.55"/>
        <Setter Property="FontStyle"  Value="Italic"/>
    </Style>

    <!-- The editor's copy of the frame. The focus ring belongs to the whole panel rather than to
         the box inside it: the header is part of the field, and a ring drawn around only the prose
         would cut the panel in half at the moment the user is working in it. -->
    <Style x:Key="PromptRoleEditFrame" TargetType="Border" BasedOn="{StaticResource PromptRoleFrame}">
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush"     Value="{DynamicResource AppInputFocusBorder}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Borderless, because the frame above draws the border and the focus ring. Everything else is
         SettingsMultilineTextBox, so what is typed is set the same way the preview shows it. -->
    <Style x:Key="PromptRoleTextBox" TargetType="TextBox" BasedOn="{StaticResource SettingsMultilineTextBox}">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost"
                                  Padding="{TemplateBinding Padding}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The well a sliding two-way switch sits in: the pair of halves, the marker behind them and
         nothing else. Deliberately not a shared-size scope of its own — every tray on a page names
         the same group for its two halves, so that 自動／固定 and 隨機／固定 come out the same width
         and the trays line up in one column down the card rather than each fitting its own words. -->
    <Style x:Key="SegmentedTray" TargetType="Border">
        <Setter Property="Background"        Value="{DynamicResource AppButtonBg}"/>
        <Setter Property="BorderBrush"       Value="{DynamicResource AppButtonBorder}"/>
        <Setter Property="BorderThickness"   Value="1"/>
        <Setter Property="CornerRadius"      Value="8"/>
        <Setter Property="Padding"           Value="3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- One half of the sliding two-way switch in 偵錯工具. It paints no background of its own,
         checked or not: the marker behind it is what says which half is chosen, and a fill here
         would cover it. The button contributes the label, the hover step, and nothing else.
         Nothing about the text changes with the state either — a weight that thickened on the
         chosen half would widen its column and shift the switch under the pointer. -->
    <Style x:Key="SegmentedTrackRadio" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
        <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Height"     Value="28"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <!-- Transparent rather than unpainted, so the whole half takes the click
                         and not just the glyphs of the label. -->
                    <Border Background="Transparent" Padding="16,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked"   Value="False"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
