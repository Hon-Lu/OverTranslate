<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <!-- Debug and below stay out of the shipped log: that level carries the recognised text, which is
       whatever happened to be on the user's screen. 設定 → 進階設定 → 記錄詳細資訊 raises the app's
       own loggers to Debug at runtime (LogLevelService), which is the route a user has. Setting
       OVERTRANSLATE_LOGLEVEL still overrides that from the very first startup line; autoReload above
       means editing this file works too. -->
  <variable name="minLevel" value="${environment:OVERTRANSLATE_LOGLEVEL:whenEmpty=Info}"/>

  <targets>
    <!-- Beside the settings file in Roaming AppData, not under the install directory: Velopack
         installs each version into its own folder, so a log written next to the executable is lost
         on the very update the user is most likely to be reporting a problem about.

         15 MB in all: the current file and fourteen archives at 1 MB each. Small files and many of
         them, because what decides how far back a report can reach is the count, not the size: a
         new file is started every day, and at the default level a day is at most a few hundred KB,
         so each day the app is used is one file — fourteen archives is about two weeks of use,
         where five 2.5 MB ones were five days and never full. With 記錄詳細資訊 on, 即時翻譯 writes
         about 80 KB a minute and splits a day into several files instead, so the same 15 MB still
         holds roughly three hours of it. Zipped into a diagnostic bundle, 15 MB is about 1.2 MB,
         well under the 5 MB upload limit (DiagnosticUploadService.MaxUploadBytes). -->
    <target xsi:type="File"
            name="file"
            fileName="${specialfolder:folder=ApplicationData}/OverTranslate/logs/app.log"
            archiveFileName="${specialfolder:folder=ApplicationData}/OverTranslate/logs/app.{###}.log"
            archiveNumbering="Rolling"
            archiveEvery="Day"
            archiveAboveSize="1048576"
            maxArchiveFiles="14"
            layout="${longdate} [${level:uppercase=true}] ${logger:shortName=true} — ${message}${onexception:${newline}EXCEPTION\: ${exception:format=toString}}"
            keepFileOpen="true"
            encoding="utf-8" />

    <target xsi:type="Debugger"
            name="debug"
            layout="${time} [${level:uppercase=true}] ${logger:shortName=true} — ${message}${onexception: | ${exception:format=message}}" />
  </targets>

  <rules>
    <logger name="OverTranslate.*" minlevel="${var:minLevel}" writeTo="file,debug" />
    <!-- Warnings and above for everything else -->
    <logger name="*" minlevel="Warn" writeTo="file,debug" />
  </rules>

</nlog>
