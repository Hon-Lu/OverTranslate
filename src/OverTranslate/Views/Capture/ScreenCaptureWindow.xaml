<Window x:Class="OverTranslate.Views.Capture.ScreenCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <!-- Frozen screenshot as background -->
        <Image x:Name="ScreenshotImage" Stretch="Fill"/>

        <!-- Semi-transparent dim layer, with a hole cut for the selection from the first pixel of
             the drag onwards: what the user is framing is the one thing on screen they need to see
             clearly, and the frame's own fill is deliberately light enough not to tint it. -->
        <Path x:Name="DimPath" Fill="#80000000"/>

        <!-- Absolute-positioned canvas for selection rect -->
        <Canvas x:Name="OverlayCanvas">
            <!-- The tint over the framed content, light enough to read as a wash rather than as a
                 filter — the whole point of cutting the dim away here is that this area is legible. -->
            <Rectangle x:Name="SelectionFill"
                       RadiusX="3"
                       RadiusY="3"
                       Visibility="Collapsed"
                       Fill="#1C99C8F0"/>

            <!-- Where the 標記 marks are shown. They belong to the overlay, which owns and draws
                 them; they are hung here because this window is opaque and that one is not. A
                 transparent window is presented by copying all of its content out of video memory
                 and back whenever any of it changes, which for a window the size of the desktop
                 measured 2.38ms each time against 0.035ms here, and was what an eraser dropping
                 frames was made of.

                 Above the tint and below the frame. Under the tint the marks came out washed out on
                 screen while the saved picture — which has no selection furniture in it at all —
                 showed them at full strength, so what the user was aiming with and what they got
                 were two different colours. -->
            <Canvas x:Name="OverlayContentHost" IsHitTestVisible="False"/>

            <!-- Same frame the realtime edit layer draws: a solid edge with a shadow under it, so it
                 stays legible over a bright screenshot as well as a dark one. Carries no fill of its
                 own, deliberately — an Effect shadows whatever silhouette its element has, and a
                 translucent fill here would lay a soft grey wash back over the content the hole in
                 the dim layer just uncovered. -->
            <Rectangle x:Name="SelectionRect"
                       Stroke="#E61E90D5"
                       StrokeThickness="2"
                       RadiusX="3"
                       RadiusY="3"
                       Visibility="Collapsed">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.45" Color="Black"/>
                </Rectangle.Effect>
            </Rectangle>

            <!-- Drag the middle to move the whole selection, as on the realtime edit layer. A
                 separate transparent thumb rather than the rectangle itself: the rectangle is also
                 the drawing preview, and it must not start capturing the pointer mid-draw. Declared
                 before the corner handles so those stay on top and keep resize reachable at a
                 corner, where the two overlap. -->
            <Thumb x:Name="SelectionBody"
                   Visibility="Collapsed"
                   Cursor="SizeAll"
                   DragDelta="SelectionBody_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="TopLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="TopLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="TopRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="TopRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomLeftHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNESW"
                   DragDelta="BottomLeftHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomRightHandle"
                   Width="14" Height="14"
                   Visibility="Collapsed"
                   Cursor="SizeNWSE"
                   DragDelta="BottomRightHandle_DragDelta">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="White"
                                BorderBrush="#CC1E90D5"
                                BorderThickness="2"
                                CornerRadius="7"/>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Canvas>

        <!-- Info card, repeated once per monitor (see BuildHintSpots): on a multi-monitor desktop a
             single card sits on whichever screen holds the virtual desktop's top-left corner, which
             may not be the one the user is looking at. -->
        <ItemsControl x:Name="HintHost">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource AppCardBg}"
                            BorderBrush="{DynamicResource AppBorder}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="8,8,18,8">
                        <!-- This window spans every monitor and so renders at one DPI; without this
                             the card is undersized on a monitor running at a higher scale. -->
                        <Border.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"/>
                        </Border.LayoutTransform>

                        <!-- Deeper than the app's usual card shadow on purpose: this one floats over
                             the user's frozen desktop, which is busy and unpredictable, so it needs
                             more separation than a card on a known background would. -->
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="2" Direction="270"
                                              Opacity="0.28" Color="#000000"/>
                        </Border.Effect>

                        <!-- No reveal animation, deliberately: the toolbar, the processing card and
                             the toolbar's notice all appear instantly, and one element easing itself in reads
                             as an inconsistency rather than as polish. -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Leading position: before a selection exists this is the only
                                 clickable way out, so it reads first instead of trailing the copy. -->
                            <Button Content="✕"
                                    Style="{StaticResource IconButton}"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource S.Capture.CancelTip}"
                                    Click="CancelCaptureBtn_Click"/>

                            <Rectangle Width="1" Height="34"
                                       Margin="8,0,14,0"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AppSeparator}"/>

                            <StackPanel VerticalAlignment="Center">
                                <!-- Tracking is size-specific: the heading tightens slightly as it
                                     grows, the smaller line opens up a touch to stay legible. -->
                                <TextBlock Foreground="{DynamicResource AppTextPrimary}"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{DynamicResource S.Capture.DragPrompt}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource S.Capture.PressPrefix}"/>

                                    <!-- Drawn as a keycap so the shortcut reads as a physical key
                                         rather than as prose. -->
                                    <Border Background="{DynamicResource AppButtonBg}"
                                            BorderBrush="{DynamicResource AppButtonBorder}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            Margin="5,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Text="ESC"/>
                                    </Border>

                                    <TextBlock Foreground="{DynamicResource AppTextSecondary}"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource S.Capture.CancelSuffix}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
