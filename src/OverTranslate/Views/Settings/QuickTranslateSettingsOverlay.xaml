<UserControl x:Class="OverTranslate.Views.Settings.QuickTranslateSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OverTranslate.Controls"
             Visibility="Collapsed"
             Focusable="True">
    <!-- The settings page's own two, which the rows in here came from. -->
    <UserControl.Resources>
        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
        </Style>
        <Style x:Key="OptionDescription" TargetType="TextBlock" BasedOn="{StaticResource FieldHint}">
            <Setter Property="Margin"       Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>
    <!-- 替換翻譯's languages, in a card over the shell the way a service's settings are, rather than
         unfolding inside the shortcut row: they are a second level of setting under one shortcut, and
         opened in place they pushed the rest of the page about. -->
    <Grid x:Name="Scrim"
          Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border x:Name="Card"
                Width="560"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <Grid Margin="24,18,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" Style="{StaticResource CardHeaderIcon}" FontSize="18"/>
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center">
                            <Run Text="{DynamicResource S.Settings.QuickTranslateHotkey}"/><Run Text=" · "/><Run Text="{DynamicResource S.Settings.QuickTranslateSettings}"/>
                        </TextBlock>
                    </StackPanel>
                    <Button x:Name="CloseBtn"
                            Style="{StaticResource OverlayCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-8,0"
                            ToolTip="{DynamicResource S.Common.Close}"
                            Click="CloseBtn_Click"/>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <!-- 雙語互譯 first, because it decides what the pickers under it mean: off, they are
                         the fixed 來源／目標 pair; on, they are the two languages the direction is chosen
                         between. Same name, wording and rules as 取詞翻譯's (#322) — one feature, two
                         places. -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{DynamicResource S.QuickLookup.Bilingual}"
                                       Style="{StaticResource OptionTitle}"/>
                            <TextBlock Text="{DynamicResource S.Settings.QuickTranslateBilingualHint}"
                                       Style="{StaticResource OptionDescription}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" x:Name="QuickTranslateBilingualToggle"
                                  Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{DynamicResource S.QuickLookup.Bilingual}"
                                  Checked="QuickTranslateBilingual_Toggled"
                                  Unchecked="QuickTranslateBilingual_Toggled"/>
                    </Grid>

                    <!-- The two sets of pickers take turns in one place rather than stacking: the switch
                         changes what the languages mean, not where they are set. -->
                    <Grid x:Name="QuickTranslateFixedPair">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Realtime.SourceLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QuickTranslateSourceBox"
                                      ctl:ComboBoxSearch.IsEnabled="True"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Code"
                                      AutomationProperties.Name="{DynamicResource S.Realtime.SourceLanguage}"
                                      SelectionChanged="QuickTranslateLanguage_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource S.Realtime.TargetLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="QuickTranslateTargetBox"
                                      ctl:ComboBoxSearch.IsEnabled="True"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Display" SelectedValuePath="Code"
                                      AutomationProperties.Name="{DynamicResource S.Realtime.TargetLanguage}"
                                      SelectionChanged="QuickTranslateLanguage_Changed"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="QuickTranslateBilingualPair" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource S.QuickLookup.BilingualFirst}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox Grid.Row="1" x:Name="QuickTranslateBilingualFirstBox"
                                  ctl:ComboBoxSearch.IsEnabled="True"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="Display" SelectedValuePath="Code"
                                  AutomationProperties.Name="{DynamicResource S.QuickLookup.BilingualFirst}"
                                  SelectionChanged="QuickTranslateBilingualPair_Changed"/>
                        <!-- Punctuation rather than a control, as in 取詞翻譯: the order is the fallback
                             order, and swapping is picking the other language in either box. -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="⇄"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{DynamicResource S.QuickLookup.BilingualSecond}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox Grid.Row="1" Grid.Column="2" x:Name="QuickTranslateBilingualSecondBox"
                                  ctl:ComboBoxSearch.IsEnabled="True"
                                  Style="{StaticResource ModernComboBox}"
                                  DisplayMemberPath="Display" SelectedValuePath="Code"
                                  AutomationProperties.Name="{DynamicResource S.QuickLookup.BilingualSecond}"
                                  SelectionChanged="QuickTranslateBilingualPair_Changed"/>
                    </Grid>
                    <!-- Names whichever language is first, so it is written from code. -->
                    <TextBlock x:Name="QuickTranslateBilingualFallbackHint"
                               Style="{StaticResource FieldHint}"
                               Visibility="Collapsed"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="{DynamicResource S.Settings.QuickTranslateLanguageNote}"
                               Style="{StaticResource FieldHint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
