<UserControl x:Class="OverTranslate.Views.Settings.PromptEditOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
             Visibility="Collapsed"
             Focusable="True">

    <UserControl.Resources>
        <!-- ══════════ Section heading ══════════ -->
        <!-- 翻譯模式 and 提示詞 name the two halves of the card below the fold, at one size. -->
        <Style x:Key="EditorHeading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══════════ Advanced parameter card ══════════ -->
        <!-- One parameter: the tick that sends it, its name with the mark that explains it, the
             range under the name, the value at the end. Two to a row, so the four fit in the space
             one stacked list of them took for two. -->
        <Style x:Key="ParamCard" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource AppHeaderBg}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AppSubtleBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="12,9"/>
        </Style>

        <Style x:Key="ParamName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ParamRange" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Margin"     Value="0,2,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- The mark beside a parameter's name. What the parameter does is a paragraph, and a
             paragraph under every card would push them apart until the fold read as a page; asked
             for rather than displayed is the right trade for prose that is read once. A button
             rather than a glyph so it takes keyboard focus, and the tooltip opens on focus as it does
             on hover. -->
        <Style x:Key="ParamInfoButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width"      Value="20"/>
            <Setter Property="Height"     Value="20"/>
            <Setter Property="Margin"     Value="4,0,0,0"/>
            <Setter Property="Cursor"     Value="Help"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
            <Setter Property="ToolTipService.ShowDuration" Value="20000"/>
            <!-- However the focus arrived - Tab, or a screen reader moving it. -->
            <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <TextBlock Text="&#xE946;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParamValueBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Width"  Value="64"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══════════ Way-of-sending card ══════════ -->
        <!-- Each way with what it does under its name, both on screen at once: the choice is
             between the two, and showing only the chosen one hid what the other would do. The name
             is the Tag and the content is what goes under it: a sentence, two ticked strengths and
             the screens it suits, read down the two cards side by side line for line. -->
        <Style x:Key="ModeBodyText" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="LineHeight"   Value="19"/>
            <Setter Property="Foreground"   Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- A strength, ticked. The tick takes the accent with the card it is on. -->
        <Style x:Key="ModePro" TargetType="ContentControl">
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       Style="{StaticResource ModeBodyText}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A screen the way suits. Filled and borderless, so it reads as a label on the card
             rather than one more thing on it to click. The fill is a tint laid over the card, not a
             colour of its own, so it sits on either card ground in either theme: the text colour on
             the card's own, the accent on the chosen one. Its text stays as quiet as the strengths
             above it; the strengths are why the way is chosen. -->
        <Style x:Key="ModeTag" TargetType="ContentControl">
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border x:Name="Tint"
                                    Background="{DynamicResource AppTextPrimary}"
                                    Opacity="0.08"
                                    CornerRadius="4"/>
                            <TextBlock x:Name="Label"
                                       Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="12"
                                       Margin="7,1,7,2"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                <Setter TargetName="Tint" Property="Background" Value="{DynamicResource AppAccent}"/>
                                <Setter TargetName="Tint" Property="Opacity" Value="0.2"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCard" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="{DynamicResource AppHeaderBg}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="14,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                    <Ellipse x:Name="Ring"
                                             Width="16" Height="16"
                                             Stroke="{DynamicResource AppTextSecondary}"
                                             StrokeThickness="1.5"
                                             VerticalAlignment="Center"
                                             Margin="0,0,9,0"/>
                                    <TextBlock Text="{TemplateBinding Tag}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                </StackPanel>
                                <ContentPresenter Margin="0,6,0,0"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppButtonBorder}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppInputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ Text buttons ══════════ -->
        <!-- A word that is a button: 還原預設 beside its heading, 刪除 in the footer. Nothing is
             filled under the pointer but a faint ground, and the colour is the text's. -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="Padding"    Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 可用參數 table ══════════ -->
        <Style x:Key="ParamTableName" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource AppAccentSubtle}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding"      Value="5,1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment"   Value="Top"/>
        </Style>
        <Style x:Key="ParamTableNameText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono"/>
            <Setter Property="FontSize"   Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
        </Style>
        <Style x:Key="ParamTableText" TargetType="TextBlock">
            <Setter Property="FontFamily"   Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="LineHeight"   Value="18"/>
            <Setter Property="Foreground"   Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ParamTableRow" TargetType="Border">
            <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="12,8"/>
        </Style>

        <!-- ══════════ Danger button ══════════ -->
        <!-- AccentButton names the accent brushes inside its own hover and pressed triggers, so a
             red one cannot be derived from it — it has to carry its own template. This is the only
             destructive confirmation in the app; the colour is what stops the two buttons on that
             card reading as a pair of equals. -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="FontFamily"      Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"        Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground"      Value="#FFFFFFFF"/>
            <Setter Property="Background"      Value="{DynamicResource AppError}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Lifted and dropped by opacity rather than by two more brushes:
                                 AppError is one colour per theme, and hover and pressed states
                                 defined here would be a third and a fourth to keep in step. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Scrim: swallows clicks so the panel underneath stays inert. It does not dismiss on
             click, unlike every other scrim in the app: what is behind it saves as you type and this
             card is the one place that does not, so a stray click beside it would silently throw
             away a prompt someone had just written. -->
        <Grid x:Name="Scrim"
              Background="#8C000000"
              MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

            <Border x:Name="Card"
                    Width="660"
                    MaxHeight="680"
                    UseLayoutRounding="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid Margin="24,18,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE70F;" Style="{StaticResource CardHeaderIcon}" FontSize="18"/>
                            <TextBlock x:Name="TitleText"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Style="{StaticResource OverlayCloseButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,-8,0"
                                ToolTip="{DynamicResource S.Common.Close}"
                                Click="CancelButton_Click"/>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppSeparator}"/>

                    <ScrollViewer x:Name="Scroller"
                                  Grid.Row="2"
                                  Focusable="False"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,18,0,0"
                                  Padding="0,0,8,0">
                        <StackPanel>
                            <!-- The two that say what the setting is, a label beside each. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{DynamicResource S.Settings.PromptName}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="2,0,16,0"/>
                                <Grid Grid.Row="0" Grid.Column="1">
                                    <TextBox x:Name="NameBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="36"
                                             Padding="11,0"
                                             TextChanged="NameBox_TextChanged"/>
                                    <TextBlock x:Name="NamePlaceholder"
                                               IsHitTestVisible="False"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               Opacity="0.7"
                                               Margin="13,0,13,0"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource S.Settings.PromptNamePlaceholder}"/>
                                </Grid>

                                <!-- The model this card's prompts were written for. Required, and with
                                     no default of its own: this provider talks to whatever server the
                                     user pointed it at, so a name shipped here would be a guess about
                                     someone else's Ollama. The reset puts back the model the guide
                                     recommends, which is a suggestion rather than a fallback — it only
                                     arrives because someone asked for it. -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{DynamicResource S.Settings.ModelName}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="2,12,16,0"/>
                                <Grid Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                    <TextBox x:Name="ModelBox"
                                             Style="{StaticResource ModernTextBox}"
                                             Height="36"
                                             Padding="11,0,40,0"
                                             FontFamily="Consolas, Cascadia Mono"
                                             TextChanged="ModelBox_TextChanged"/>
                                    <TextBlock x:Name="ModelPlaceholder"
                                               IsHitTestVisible="False"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               Opacity="0.7"
                                               Margin="13,0,40,0"
                                               VerticalAlignment="Center"
                                               Text="{DynamicResource S.Settings.ModelRequired}"/>
                                    <!-- Inside the box's right end, as the eye of the key box is. -->
                                    <Button x:Name="ModelResetButton"
                                            Style="{StaticResource IconButton}"
                                            Width="28" Height="28"
                                            Margin="0,0,4,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            ToolTip="{DynamicResource S.Settings.ModelResetTip}"
                                            AutomationProperties.Name="{DynamicResource S.Settings.ModelResetTip}"
                                            Click="ModelResetButton_Click">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13"/>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Folded, and folded again every time the card opens: a temperature is a
                                 number a model's documentation asks for, and someone whose model never
                                 disagrees with the shipped ones has no reason to read the cards under
                                 it. Under the model rather than at the end, because it belongs to the
                                 model named above it. -->
                            <Button x:Name="AdvancedToggle"
                                    Style="{StaticResource AdvancedToggleRow}"
                                    Margin="0,12,0,0"
                                    Click="AdvancedToggle_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource S.Settings.OpenAiAdvanced}"
                                               VerticalAlignment="Center"/>
                                    <Path Width="9" Height="6"
                                          VerticalAlignment="Center"
                                          Margin="8,1,0,0"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.4"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M1,1 L5,5 L9,1"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform x:Name="AdvancedChevronRotation"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </StackPanel>
                            </Button>

                            <!-- Closed by height and IsEnabled rather than by Visibility, so the
                                 content can be animated out of a zero height and still leaves the
                                 tab order when it is shut. -->
                            <Border x:Name="AdvancedHost"
                                    ClipToBounds="True"
                                    Height="0"
                                    Opacity="0"
                                    IsEnabled="False">
                                <StackPanel x:Name="AdvancedContent" Margin="0,6,0,0">
                                    <!-- One sentence for the whole fold rather than one under each
                                         card: all four carry the same caveat - which server accepts
                                         which, in what range. What each one does is on the mark
                                         beside its name, where it is asked for rather than in the way. -->
                                    <TextBlock Text="{DynamicResource S.Settings.AdvancedHint}"
                                               Style="{StaticResource FieldHint}"
                                               FontSize="12"
                                               Margin="2,0,0,10"/>

                                    <!-- Thinking first, above the sampling numbers: it is the one card
                                         that decides whether a general chat model is usable at all -
                                         left thinking, one screen outlasts the timeout - while the
                                         three after it only shade what comes back. -->
                                    <UniformGrid Columns="2">
                                        <Border Style="{StaticResource ParamCard}" Margin="0,0,5,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="ThinkingOffCheckBox"
                                                          Grid.Column="0"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          AutomationProperties.Name="{DynamicResource S.Settings.ThinkingOff}"
                                                          Checked="AdvancedParam_Toggled"
                                                          Unchecked="AdvancedParam_Toggled"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="ThinkingOffName"
                                                                   Text="{DynamicResource S.Settings.ThinkingOff}"
                                                                   Style="{StaticResource ParamName}"/>
                                                        <Button Style="{StaticResource ParamInfoButton}"
                                                                ToolTip="{DynamicResource S.Settings.ThinkingOffTip}"
                                                                AutomationProperties.Name="{DynamicResource S.Settings.ThinkingOff}"
                                                                AutomationProperties.HelpText="{DynamicResource S.Settings.ThinkingOffTip}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.ThinkingOffDetail}"
                                                               Style="{StaticResource ParamRange}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- How strongly the likeliest wording is favoured. -->
                                        <Border Style="{StaticResource ParamCard}" Margin="5,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="TemperatureEnabledCheckBox"
                                                          Grid.Column="0"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          AutomationProperties.Name="{DynamicResource S.Settings.Temperature}"
                                                          Checked="AdvancedParam_Toggled"
                                                          Unchecked="AdvancedParam_Toggled"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="TemperatureName"
                                                                   Text="{DynamicResource S.Settings.Temperature}"
                                                                   Style="{StaticResource ParamName}"/>
                                                        <Button Style="{StaticResource ParamInfoButton}"
                                                                ToolTip="{DynamicResource S.Settings.TemperatureTip}"
                                                                AutomationProperties.Name="{DynamicResource S.Settings.Temperature}"
                                                                AutomationProperties.HelpText="{DynamicResource S.Settings.TemperatureTip}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.TemperatureRange}"
                                                               Style="{StaticResource ParamRange}"/>
                                                </StackPanel>
                                                <TextBox x:Name="TemperatureBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource ParamValueBox}"
                                                         AutomationProperties.Name="{DynamicResource S.Settings.Temperature}"
                                                         TextChanged="AdvancedParam_TextChanged"
                                                         LostFocus="TemperatureBox_LostFocus"/>
                                            </Grid>
                                        </Border>

                                        <!-- How many candidates there are to favour between. -->
                                        <Border Style="{StaticResource ParamCard}" Margin="0,0,5,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="TopPEnabledCheckBox"
                                                          Grid.Column="0"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          AutomationProperties.Name="{DynamicResource S.Settings.TopP}"
                                                          Checked="AdvancedParam_Toggled"
                                                          Unchecked="AdvancedParam_Toggled"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="TopPName"
                                                                   Text="{DynamicResource S.Settings.TopP}"
                                                                   Style="{StaticResource ParamName}"/>
                                                        <Button Style="{StaticResource ParamInfoButton}"
                                                                ToolTip="{DynamicResource S.Settings.TopPTip}"
                                                                AutomationProperties.Name="{DynamicResource S.Settings.TopP}"
                                                                AutomationProperties.HelpText="{DynamicResource S.Settings.TopPTip}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.TopPRange}"
                                                               Style="{StaticResource ParamRange}"/>
                                                </StackPanel>
                                                <TextBox x:Name="TopPBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource ParamValueBox}"
                                                         AutomationProperties.Name="{DynamicResource S.Settings.TopP}"
                                                         TextChanged="AdvancedParam_TextChanged"
                                                         LostFocus="TopPBox_LostFocus"/>
                                            </Grid>
                                        </Border>

                                        <!-- What makes the result repeatable at a temperature above zero. -->
                                        <Border Style="{StaticResource ParamCard}" Margin="5,0,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="SeedEnabledCheckBox"
                                                          Grid.Column="0"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,10,0"
                                                          AutomationProperties.Name="{DynamicResource S.Settings.Seed}"
                                                          Checked="AdvancedParam_Toggled"
                                                          Unchecked="AdvancedParam_Toggled"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="SeedName"
                                                                   Text="{DynamicResource S.Settings.Seed}"
                                                                   Style="{StaticResource ParamName}"/>
                                                        <Button Style="{StaticResource ParamInfoButton}"
                                                                ToolTip="{DynamicResource S.Settings.SeedTip}"
                                                                AutomationProperties.Name="{DynamicResource S.Settings.Seed}"
                                                                AutomationProperties.HelpText="{DynamicResource S.Settings.SeedTip}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.SeedRange}"
                                                               Style="{StaticResource ParamRange}"/>
                                                </StackPanel>
                                                <TextBox x:Name="SeedBox"
                                                         Grid.Column="2"
                                                         Style="{StaticResource ParamValueBox}"
                                                         AutomationProperties.Name="{DynamicResource S.Settings.Seed}"
                                                         TextChanged="AdvancedParam_TextChanged"
                                                         LostFocus="SeedBox_LostFocus"/>
                                            </Grid>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- A text at a time or as few requests as fit. Above the template because
                                 each way has its own default template: switching is a change to what
                                 the box below sends. -->
                            <TextBlock Text="{DynamicResource S.Settings.OpenAiMode}"
                                       Style="{StaticResource EditorHeading}"
                                       Margin="0,22,0,10"/>
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="SegmentRadio"
                                             GroupName="PromptMode"
                                             Style="{StaticResource ModeCard}"
                                             Margin="0,0,5,0"
                                             Tag="{DynamicResource S.Settings.OpenAiModeSegment}"
                                             AutomationProperties.Name="{DynamicResource S.Settings.OpenAiModeSegment}"
                                             Checked="Mode_Changed">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource S.Settings.OpenAiModeSuits}"
                                                       Style="{StaticResource ModeBodyText}"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource ModeTag}"
                                                            Content="{DynamicResource S.Settings.OpenAiModeSegmentTag1}"/>
                                            <ContentControl Style="{StaticResource ModeTag}"
                                                            Content="{DynamicResource S.Settings.OpenAiModeSegmentTag2}"/>
                                        </WrapPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Settings.OpenAiModeSegmentHint}"
                                                       Style="{StaticResource ModeBodyText}"/>
                                            <ContentControl Style="{StaticResource ModePro}" Margin="0,6,0,0"
                                                            Content="{DynamicResource S.Settings.OpenAiModeSegmentPro1}"/>
                                            <ContentControl Style="{StaticResource ModePro}"
                                                            Content="{DynamicResource S.Settings.OpenAiModeSegmentPro2}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                                <RadioButton x:Name="BatchRadio"
                                             GroupName="PromptMode"
                                             Style="{StaticResource ModeCard}"
                                             Margin="5,0,0,0"
                                             Tag="{DynamicResource S.Settings.OpenAiModeBatch}"
                                             AutomationProperties.Name="{DynamicResource S.Settings.OpenAiModeBatch}"
                                             Checked="Mode_Changed">
                                    <DockPanel>
                                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                            <TextBlock Text="{DynamicResource S.Settings.OpenAiModeSuits}"
                                                       Style="{StaticResource ModeBodyText}"
                                                       Opacity="0.75"
                                                       VerticalAlignment="Center"/>
                                            <ContentControl Style="{StaticResource ModeTag}"
                                                            Content="{DynamicResource S.Settings.OpenAiModeBatchTag1}"/>
                                            <ContentControl Style="{StaticResource ModeTag}"
                                                            Content="{DynamicResource S.Settings.OpenAiModeBatchTag2}"/>
                                        </WrapPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Settings.OpenAiModeBatchHint}"
                                                       Style="{StaticResource ModeBodyText}"/>
                                            <ContentControl Style="{StaticResource ModePro}" Margin="0,6,0,0"
                                                            Content="{DynamicResource S.Settings.OpenAiModeBatchPro1}"/>
                                            <ContentControl Style="{StaticResource ModePro}"
                                                            Content="{DynamicResource S.Settings.OpenAiModeBatchPro2}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- The whole of what each request says. It opens on the application's
                                 own wording rather than an empty box, so what is sent is on screen
                                 before anything is changed, and changing a word is all it takes to
                                 make it one's own. -->
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{DynamicResource S.Settings.PromptTemplate}"
                                           Style="{StaticResource EditorHeading}"/>
                                <!-- Greyed while the box already reads as the default, so the button
                                     also says whether anything has been changed. Its ground ends where
                                     the box's edge does: drawn past the content it is cut off by the
                                     scroller. -->
                                <Button Grid.Column="1"
                                        x:Name="TemplateResetButton"
                                        Style="{StaticResource TextButton}"
                                        AutomationProperties.Name="{DynamicResource S.Settings.PromptTemplateReset}"
                                        Click="TemplateResetButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,7,0"/>
                                        <TextBlock Text="{DynamicResource S.Settings.PromptTemplateReset}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldHint}"
                                       Text="{DynamicResource S.Settings.PromptTemplateHint}"
                                       FontSize="12"
                                       Margin="0,4,0,0"/>

                            <!-- The known placeholders in the accent, painted over the box rather
                                 than by it — see PlaceholderLayer. -->
                            <Grid Margin="0,10,0,0">
                                <TextBox x:Name="TemplateBox"
                                         Style="{StaticResource SettingsMultilineTextBox}"
                                         MinHeight="150"
                                         TextChanged="TemplateBox_TextChanged"/>
                                <controls:PlaceholderLayer x:Name="TemplateLayer"
                                                           Target="{Binding ElementName=TemplateBox}"
                                                           Foreground="{DynamicResource AppAccent}"
                                                           Highlight="{DynamicResource AppAccentSubtle}"/>
                            </Grid>

                            <!-- 可用參數: reference for the box above, always shown. It is the last
                                 thing on the card, so open it pushes nothing out of sight, and folded
                                 it only cost a click to reach what the box is written with. -->
                            <TextBlock Text="{DynamicResource S.Settings.PromptParams}"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="{StaticResource AppFontSize}"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="0,16,0,0"/>

                            <StackPanel Margin="0,8,0,0">
                                <!-- Two columns, the name and what it becomes, the example after the
                                     description in the quieter colour. The two that carry the
                                     content come first, in the order the default template has them;
                                     {text} is described for the way picked above - see
                                     ShowParamDescriptions. -->
                                <!-- {} escapes the brace: XAML reads a leading { as a markup extension. -->
                                <Border BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        ClipToBounds="True">
                                    <Grid Grid.IsSharedSizeScope="True">
                                        <StackPanel>
                                            <Border Style="{StaticResource ParamTableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ParamTableName}">
                                                        <TextBlock Text="{}{context}" Style="{StaticResource ParamTableNameText}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="14,0,0,0"
                                                               Text="{DynamicResource S.Settings.PromptParamContext}"
                                                               Style="{StaticResource ParamTableText}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource ParamTableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ParamTableName}">
                                                        <TextBlock Text="{}{text}" Style="{StaticResource ParamTableNameText}"/>
                                                    </Border>
                                                    <TextBlock x:Name="ParamTextDescription"
                                                               Grid.Column="1" Margin="14,0,0,0"
                                                               Style="{StaticResource ParamTableText}"/>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource ParamTableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ParamTableName}">
                                                        <TextBlock Text="{}{source_name}" Style="{StaticResource ParamTableNameText}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource ParamTableText}">
                                                        <Run Text="{DynamicResource S.Settings.PromptParamSourceName}"/><Run Text="　"/><Run Text="{DynamicResource S.Settings.PromptParamSourceNameExample}" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource ParamTableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ParamTableName}">
                                                        <TextBlock Text="{}{source_code}" Style="{StaticResource ParamTableNameText}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource ParamTableText}">
                                                        <Run Text="{DynamicResource S.Settings.PromptParamSourceCode}"/><Run Text="　"/><Run Text="en" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource ParamTableRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ParamTableName}">
                                                        <TextBlock Text="{}{target_name}" Style="{StaticResource ParamTableNameText}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource ParamTableText}">
                                                        <Run Text="{DynamicResource S.Settings.PromptParamTargetName}"/><Run Text="　"/><Run Text="{DynamicResource S.Settings.PromptParamTargetNameExample}" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource ParamTableRow}" BorderThickness="0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ParamName"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource ParamTableName}">
                                                        <TextBlock Text="{}{target_code}" Style="{StaticResource ParamTableNameText}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource ParamTableText}">
                                                        <Run Text="{DynamicResource S.Settings.PromptParamTargetCode}"/><Run Text="　"/><Run Text="ja" Foreground="{DynamicResource AppTextSecondary}"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Settings.PromptParamsTipAuto}"
                                           Style="{StaticResource FieldHint}"
                                           FontSize="12"
                                           Margin="2,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Rectangle Grid.Row="3" Height="1" Margin="0,16,0,0" Fill="{DynamicResource AppSeparator}"/>

                    <!-- The one card in 設定 with buttons on it. Everything else here saves as it is
                         typed; a half-written prompt saved that way would be sent to the model on
                         the next capture, so this one is confirmed before it counts. 取消 leaves without
                         saving, as the close button and Escape do. -->
                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Button x:Name="DeleteButton"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TextButton}"
                                Foreground="{DynamicResource AppError}"
                                Height="34"
                                Padding="12,0"
                                Margin="-12,0,0,0"
                                Content="{DynamicResource S.Settings.PromptDelete}"
                                Click="DeleteButton_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelButton"
                                    Style="{StaticResource FlatButton}"
                                    Height="34"
                                    Padding="18,0"
                                    Content="{DynamicResource S.Common.Cancel}"
                                    Click="CancelButton_Click"/>
                            <Button x:Name="SaveButton"
                                    Style="{StaticResource AccentButton}"
                                    Height="34"
                                    Margin="10,0,0,0"
                                    Padding="22,0"
                                    Content="{DynamicResource S.Common.Save}"
                                    Click="SaveButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ Delete confirmation ══════════ -->
        <!-- The only confirmation in the application, and it earns the exception: a prompt is prose
             someone wrote, a deleted one has no undo, and the button that deletes it shares a row
             with the one that saves. A layer of this control rather than a card of its own, so the
             prompt being deleted is still on screen behind the question about it. -->
        <Grid x:Name="ConfirmLayer"
              Visibility="Collapsed"
              Background="#8C000000"
              MouseLeftButtonDown="ConfirmScrim_MouseLeftButtonDown">
            <Border Width="400"
                    UseLayoutRounding="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <StackPanel Margin="24,20,24,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AppError}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource S.Settings.PromptDeleteTitle}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ConfirmMessage"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{StaticResource AppFontSize}"
                               Foreground="{DynamicResource AppTextSecondary}"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <!-- 取消 first and focused, so a key someone is already holding down does not
                         land on the destructive half. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancelButton"
                                Style="{StaticResource FlatButton}"
                                Height="34"
                                Padding="18,0"
                                Content="{DynamicResource S.Common.Cancel}"
                                Click="ConfirmCancelButton_Click"/>
                        <Button Style="{StaticResource DangerButton}"
                                Margin="10,0,0,0"
                                Padding="18,0"
                                Content="{DynamicResource S.Settings.PromptDelete}"
                                Click="ConfirmDeleteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════ Switching the way with a template of the user's own ══════════ -->
        <!-- The delete confirmation's frame. Asked because the default of the other way would write
             over prose the user wrote; the way switches whichever is answered, so this is only about
             the box. Keeping is the main button, on the right where the eye ends, focused, and what
             Escape answers: the safe half. -->
        <Grid x:Name="ModeConfirmLayer"
              Visibility="Collapsed"
              Background="#8C000000"
              MouseLeftButtonDown="ConfirmScrim_MouseLeftButtonDown">
            <Border Width="420"
                    UseLayoutRounding="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <StackPanel Margin="24,20,24,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="{DynamicResource AppAccent}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource S.Settings.PromptModeSwitchTitle}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ModeConfirmMessage"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="{StaticResource AppFontSize}"
                               Foreground="{DynamicResource AppTextSecondary}"
                               LineHeight="20"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ModeUseDefaultButton"
                                Style="{StaticResource FlatButton}"
                                Height="34"
                                Padding="16,0"
                                Content="{DynamicResource S.Settings.PromptModeUseDefault}"
                                Click="ModeUseDefaultButton_Click"/>
                        <Button x:Name="ModeKeepButton"
                                Style="{StaticResource AccentButton}"
                                Height="34"
                                Margin="10,0,0,0"
                                Padding="20,0"
                                Content="{DynamicResource S.Settings.PromptModeKeep}"
                                Click="ModeKeepButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
