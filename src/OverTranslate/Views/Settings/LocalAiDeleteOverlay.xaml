<UserControl x:Class="OverTranslate.Views.Settings.LocalAiDeleteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True">

    <!-- The frame of the prompt editor's delete confirmation. The scrim swallows the click:
         dismissing on it would answer the question by accident. -->
    <Grid Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border Width="400"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <StackPanel Margin="24,20,24,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AppError}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{DynamicResource S.LocalAi.DeleteModel}"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock x:Name="ConfirmMessage"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="{StaticResource AppFontSize}"
                           Foreground="{DynamicResource AppTextSecondary}"
                           LineHeight="20"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"/>

                <TextBlock x:Name="FailureText"
                           Visibility="Collapsed"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppError}"
                           TextWrapping="Wrap"
                           Margin="0,-8,0,14"
                           Text="{DynamicResource S.LocalAi.DeleteFailed}"/>

                <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource FlatButton}"
                            Height="34"
                            Padding="18,0"
                            Content="{DynamicResource S.Common.Cancel}"
                            Click="CancelButton_Click"/>
                    <Button Style="{StaticResource DangerButton}"
                            Margin="10,0,0,0"
                            Padding="18,0"
                            Content="{DynamicResource S.LocalAi.Delete}"
                            Click="DeleteButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
