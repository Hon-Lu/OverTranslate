<UserControl x:Class="OverTranslate.Views.Settings.ServiceSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
             xmlns:settings="clr-namespace:OverTranslate.Views.Settings"
             Visibility="Collapsed"
             Focusable="True">

    <UserControl.Resources>

        <!-- ══════════ Model setting row ══════════ -->
        <!-- One row of the list, and the control that picks it: the whole row takes the click, and
             the ring at its start is what says which setting is sent - a filled row alone reads as a
             hover, on a row that also carries a button. Three lines, because a name means nothing
             without the model it is for, and the parameters below that are what makes two settings
             for one model different; what used to be a second pane beside the list is now the row. -->
        <Style x:Key="ProfileRow" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="16,12,10,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Ring"
                                         Grid.Column="0"
                                         Width="18" Height="18"
                                         Stroke="{DynamicResource AppTextSecondary}"
                                         StrokeThickness="1.5"
                                         VerticalAlignment="Center"
                                         Margin="0,0,14,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover only where it means something: a checked row is already
                                 filled, and lighting it again on the way to its button would read
                                 as the click having changed the selection. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppButtonHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="5.5"/>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppAccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The small tags after a row's name. 整批 carries the accent because it is the one that
             changes what is sent; 唯讀 and 自訂提示詞 describe the row and stay quiet. -->
        <Style x:Key="ProfileTag" TargetType="Border">
            <Setter Property="Background"        Value="{DynamicResource AppButtonBg}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="9"/>
            <Setter Property="Padding"           Value="7,0,7,1"/>
            <Setter Property="Margin"            Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- The last row of the same list, and the only one that is an action. It keeps the rows'
             shape so the list reads as one block, and loses the separator because nothing follows
             it. Disabled at the cap rather than hidden: a row that vanishes takes the bottom of
             the list with it, and the count on it is what explains why it stopped. -->
        <Style x:Key="PromptAddRow" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                Padding="16,0">
                            <ContentPresenter Height="44" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>

    <!-- Scrim: swallows clicks so the page underneath stays inert, and dismisses on click -->
    <Grid x:Name="Scrim"
          Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

        <!-- Layout rounding for the same reason the about card uses it: a centred card at an odd
             window width lands on a half pixel and every glyph inside it is then sub-pixel
             positioned, which reads as a soft card rather than a misplaced one. -->
        <Border x:Name="Card"
                Width="620"
                MaxHeight="720"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" Style="{StaticResource CardHeaderIcon}" FontSize="18"/>
                        <TextBlock x:Name="TitleText"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource OverlayCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-8,0"
                            ToolTip="{DynamicResource S.Common.Close}"
                            Click="CloseBtn_Click"/>
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppSeparator}"/>

                <!-- The OpenAI panel is taller than any window is guaranteed to be, so the fields
                     scroll inside the card rather than the card growing past the screen. -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,16,0,0"
                              Padding="0,0,8,0">
                    <Grid Grid.IsSharedSizeScope="True">

                        <!-- ══════════ DeepL ══════════ -->
                        <Grid x:Name="DeepLPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="{DynamicResource S.Common.ApiKey}"
                                       Style="{StaticResource FieldLabel}"/>
                            <controls:SecretBox Grid.Column="1" Grid.Row="0" x:Name="ApiKeyBox"
                                                SecretChanged="ApiKeyBox_SecretChanged"/>
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{DynamicResource S.Provider.DeepLHint}"
                                       Style="{StaticResource FieldHint}"/>
                        </Grid>

                        <!-- ══════════ OpenAI ══════════ -->
                        <Grid x:Name="OpenAiPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- The guide comes before the fields rather than after them: this
                                 provider is aimed at a local model, and someone who has not
                                 installed one yet cannot fill in a single box below until they
                                 have. Spanning both columns and tinted like the note it is, so it
                                 reads as the way in rather than as a first field to fill. -->
                            <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource InfoCardBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- An open book, drawn rather than set in an icon font: the two
                                         glyph fonts this app can rely on (Segoe Fluent Icons, Segoe
                                         MDL2 Assets) are not on every supported Windows build, and a
                                         missing glyph next to a link reads as a broken image.
                                         Stroked, not filled, so it carries the same weight as the
                                         text beside it, and drawn on a 16-unit grid so it stays
                                         crisp. Accent-coloured to match the link it labels. -->
                                    <Path x:Name="OllamaGuideIcon"
                                          Width="17" Height="17"
                                          Margin="0,0,11,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppAccent}"
                                          StrokeThickness="1.15"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M8,4.3 C6.7,3.3 4.9,2.9 3,2.9 L1.7,2.9 L1.7,12.1 L3,12.1
                                                C4.9,12.1 6.7,12.5 8,13.5
                                                M8,4.3 C9.3,3.3 11.1,2.9 13,2.9 L14.3,2.9 L14.3,12.1 L13,12.1
                                                C11.1,12.1 9.3,12.5 8,13.5
                                                M8,4.3 L8,13.5"/>

                                    <TextBlock FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap">
                                        <Hyperlink x:Name="OllamaGuideLink"
                                                   Foreground="{DynamicResource AppAccent}"
                                                   RequestNavigate="OllamaGuideLink_RequestNavigate"><Run Text="{DynamicResource S.Settings.OllamaGuide}"/></Hyperlink>
                                    </TextBlock>
                                    <!-- Says the link opens a page outside the app, drawn for the
                                         book's reason. -->
                                    <Path Width="10" Height="10"
                                          Margin="8,1,0,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppAccent}"
                                          StrokeThickness="1.3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M1,9 L9,1 M3,1 L9,1 L9,7"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{DynamicResource S.Settings.ApiBaseUrl}"
                                       Margin="0,16,12,0"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1" Grid.Row="1" Margin="0,16,0,0">
                                <TextBox x:Name="OpenAiBaseUrlBox"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="OpenAiSetting_TextChanged"/>
                                <TextBlock x:Name="OpenAiBaseUrlPlaceholder"
                                           IsHitTestVisible="False"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="{StaticResource AppFontSize}"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Opacity="0.7"
                                           Margin="10,0,10,0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Column="0" Grid.Row="2" Text="{DynamicResource S.Common.ApiKey}"
                                       Margin="0,12,12,0"
                                       Style="{StaticResource FieldLabel}"/>
                            <controls:SecretBox Grid.Column="1" Grid.Row="2" x:Name="OpenAiApiKeyBox"
                                                Margin="0,12,0,0"
                                                SecretChanged="OpenAiSecret_SecretChanged"/>

                            <!-- Digits only, empty for the default the placeholder shows. Narrow
                                 because it holds a few digits: a full-width box reads as a place
                                 for an address. The IME is off so a CJK keyboard types digits
                                 here rather than composing. -->
                            <TextBlock Grid.Column="0" Grid.Row="3" Text="{DynamicResource S.Settings.OpenAiTimeout}"
                                       Margin="0,12,12,0"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Grid.Row="3" Margin="0,12,0,0"
                                        Orientation="Horizontal" HorizontalAlignment="Left">
                                <Grid Width="120">
                                    <TextBox x:Name="OpenAiTimeoutBox"
                                             Style="{StaticResource ModernTextBox}"
                                             MaxLength="4"
                                             InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="OpenAiTimeoutBox_PreviewTextInput"
                                             PreviewKeyDown="OpenAiTimeoutBox_PreviewKeyDown"
                                             DataObject.Pasting="OpenAiTimeoutBox_Pasting"
                                             TextChanged="OpenAiTimeoutBox_TextChanged"
                                             LostKeyboardFocus="OpenAiTimeoutBox_LostKeyboardFocus"/>
                                    <TextBlock x:Name="OpenAiTimeoutPlaceholder"
                                               IsHitTestVisible="False"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               Opacity="0.7"
                                               Margin="10,0,10,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <!-- The unit after the number rather than in the label: "Timeout (s)"
                                     reads oddly, and every language puts the unit after the value. -->
                                <TextBlock Text="{DynamicResource S.Settings.OpenAiTimeoutUnit}"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Grid.Row="4" x:Name="OpenAiTimeoutError"
                                       Style="{StaticResource FieldHint}"
                                       Foreground="{DynamicResource AppError}"/>




                            <!-- Everything above is the server; everything below is the model. The
                                 two boxes above are set once and forgotten, while which model is
                                 loaded decides what a translation reads like — so the model, the
                                 prompt written for it and the temperature its documentation asks
                                 for are one saved thing, named and picked from a list, rather than
                                 three fields that have to be changed together and can be left
                                 disagreeing. -->
                            <StackPanel Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2"
                                        Orientation="Horizontal"
                                        Margin="0,26,0,0">
                                <TextBlock Text="{DynamicResource S.Settings.ModelProfiles}"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimary}"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Text="{DynamicResource S.Settings.ProfileListHint}"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Bottom"
                                           Margin="10,0,0,1"/>
                            </StackPanel>

                            <!-- One column: each row says what it is - the model, the parameters
                                 it sends, whether it is a batch and whose prompt it carries - so
                                 the pane beside the list that used to say it for the picked row
                                 only repeated one of them. The built-in row carries the copy
                                 rather than a pencil: it cannot be edited, because it is what
                                 everyone who never writes one keeps following as the shipped
                                 wording improves, and a copy of it is how to keep today's. -->
                            <Border x:Name="PromptLibraryCard"
                                    Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <StackPanel SizeChanged="PromptLibraryBody_SizeChanged">
                                    <ItemsControl x:Name="PromptPresetList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="PromptPreset"
                                                             Style="{StaticResource ProfileRow}"
                                                             Tag="{Binding Id}"
                                                             AutomationProperties.Name="{Binding Name}"
                                                             IsChecked="{Binding IsSelected, Mode=OneTime}"
                                                             Checked="PromptPreset_Checked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           MaxWidth="320"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <StackPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border x:Name="Tag" Style="{StaticResource ProfileTag}">
                                                                                <TextBlock x:Name="TagText"
                                                                                           Text="{Binding Text}"
                                                                                           FontFamily="{DynamicResource AppFont}"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource AppTextSecondary}"/>
                                                                            </Border>
                                                                            <DataTemplate.Triggers>
                                                                                <DataTrigger Binding="{Binding Accent}" Value="True">
                                                                                    <Setter TargetName="Tag" Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
                                                                                    <Setter TargetName="Tag" Property="BorderBrush" Value="{DynamicResource AppAccentSubtle}"/>
                                                                                    <Setter TargetName="TagText" Property="Foreground" Value="{DynamicResource AppAccent}"/>
                                                                                </DataTrigger>
                                                                            </DataTemplate.Triggers>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <!-- An identifier, matched character by
                                                                 character against what is installed,
                                                                 which is what a fixed pitch is for. -->
                                                            <TextBlock Text="{Binding Model}"
                                                                       FontFamily="Consolas, Cascadia Mono"
                                                                       FontSize="12.5"
                                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                                       Margin="0,4,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Text="{Binding Parameters}"
                                                                       Visibility="{Binding ParametersVisibility}"
                                                                       FontFamily="{DynamicResource AppFont}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                                       Opacity="0.85"
                                                                       Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>

                                                        <!-- Exactly one of the two is ever on a row. -->
                                                        <Button Grid.Column="1"
                                                                Visibility="{Binding EditVisibility}"
                                                                Style="{StaticResource IconButton}"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Tag="{Binding Id}"
                                                                ToolTip="{DynamicResource S.Settings.PromptEditTitle}"
                                                                AutomationProperties.Name="{DynamicResource S.Settings.PromptEditTitle}"
                                                                Click="PromptEditPreset_Click">
                                                            <TextBlock Text="&#xE70F;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="14"/>
                                                        </Button>
                                                        <!-- ToolTipService.ShowOnDisabled: at the cap the
                                                             button greys, and the tip still says what it
                                                             would have done. -->
                                                        <Button Grid.Column="1"
                                                                Visibility="{Binding CopyVisibility}"
                                                                IsEnabled="{Binding CopyEnabled}"
                                                                Style="{StaticResource IconButton}"
                                                                Margin="8,0,0,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip="{DynamicResource S.Settings.ProfileCopy}"
                                                                ToolTipService.ShowOnDisabled="True"
                                                                AutomationProperties.Name="{DynamicResource S.Settings.ProfileCopy}"
                                                                Click="ProfileCopy_Click">
                                                            <TextBlock Text="&#xE8C8;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="14"/>
                                                        </Button>
                                                    </Grid>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button x:Name="PromptAddButton"
                                            Style="{StaticResource PromptAddRow}"
                                            Click="PromptAddButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock x:Name="PromptAddText"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- What used to be a card of its own above the list: the built-in row is
                                 the one thing here nobody owns, rewritten by every update, so a setup
                                 somebody is happy with can change under them without their having
                                 touched anything. One line under the list says so and where the copy
                                 is. -->
                            <TextBlock Grid.Column="0" Grid.Row="8" Grid.ColumnSpan="2"
                                       Text="{DynamicResource S.Settings.ProfileBuiltInNote}"
                                       Style="{StaticResource FieldHint}"
                                       FontSize="12"
                                       LineHeight="18"
                                       Margin="2,8,0,0"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- The page's own auto-save line is behind the scrim, so the same contract is
                     restated here rather than leaving this card looking like it needs an OK. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="&#xE945;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource AppAccent}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource S.Settings.AutoSaveHint}"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Beside the scrim rather than inside it: this card's own scrim swallows the click, and a
         click that reached the one above would close the panel out from under the prompt being
         written. -->
    <settings:PromptEditOverlay x:Name="PromptEditor"/>
    </Grid>
</UserControl>
