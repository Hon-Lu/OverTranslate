<UserControl x:Class="OverTranslate.Views.Settings.ServiceSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OverTranslate.Views.Controls"
             xmlns:settings="clr-namespace:OverTranslate.Views.Settings"
             Visibility="Collapsed"
             Focusable="True">

    <UserControl.Resources>

        <!-- ══════════ Prompt library row ══════════ -->
        <!-- One row of the list, and the control that picks it. A full-width row rather than a
             tile like ChoiceTile: the list runs to six entries, and six tiles is a wall. The tick
             is what says which prompt gets sent — a filled row alone reads as a hover, on a row
             that also carries a button. The tick keeps its width while unchecked so the names
             stay in one column. -->
        <Style x:Key="PromptPresetRow" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="12,0">
                            <Grid Height="42">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Tick"
                                           Grid.Column="0"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppAccent}"
                                           Opacity="0"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover only where it means something: a checked row is already
                                 filled, and lighting it again on the way to its edit button would
                                 read as the click having changed the selection. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppButtonHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppAccentSubtle}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The last row of the same list, and the only one that is an action. It keeps the rows'
             shape so the list reads as one block, and loses the separator because nothing follows
             it. Disabled at the cap rather than hidden: a row that vanishes takes the bottom of
             the list with it, and the count on it is what explains why it stopped. -->
        <Style x:Key="PromptAddRow" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="12,0">
                            <ContentPresenter Height="42" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ Advanced toggle ══════════ -->
    </UserControl.Resources>

    <Grid>

    <!-- Scrim: swallows clicks so the page underneath stays inert, and dismisses on click -->
    <Grid x:Name="Scrim"
          Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

        <!-- Layout rounding for the same reason the about card uses it: a centred card at an odd
             window width lands on a half pixel and every glyph inside it is then sub-pixel
             positioned, which reads as a soft card rather than a misplaced one. -->
        <Border x:Name="Card"
                Width="620"
                MaxHeight="640"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="24,18,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" Style="{StaticResource CardHeaderIcon}" FontSize="18"/>
                        <TextBlock x:Name="TitleText"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource OverlayCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,-8,0"
                            ToolTip="{DynamicResource S.Common.Close}"
                            Click="CloseBtn_Click"/>
                </Grid>

                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppSeparator}"/>

                <!-- The OpenAI panel is taller than any window is guaranteed to be, so the fields
                     scroll inside the card rather than the card growing past the screen. -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,16,0,0"
                              Padding="0,0,8,0">
                    <Grid Grid.IsSharedSizeScope="True">

                        <!-- ══════════ DeepL ══════════ -->
                        <Grid x:Name="DeepLPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="{DynamicResource S.Common.ApiKey}"
                                       Style="{StaticResource FieldLabel}"/>
                            <controls:SecretBox Grid.Column="1" Grid.Row="0" x:Name="ApiKeyBox"
                                                SecretChanged="ApiKeyBox_SecretChanged"/>
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{DynamicResource S.Provider.DeepLHint}"
                                       Style="{StaticResource FieldHint}"/>
                        </Grid>

                        <!-- ══════════ OpenAI ══════════ -->
                        <Grid x:Name="OpenAiPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="ServiceLabel"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- The guide comes before the fields rather than after them: this
                                 provider is aimed at a local model, and someone who has not
                                 installed one yet cannot fill in a single box below until they
                                 have. Spanning both columns and tinted like the note it is, so it
                                 reads as the way in rather than as a first field to fill. -->
                            <Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                    Style="{StaticResource InfoCardBorder}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- An open book, drawn rather than set in an icon font: the two
                                         glyph fonts this app can rely on (Segoe Fluent Icons, Segoe
                                         MDL2 Assets) are not on every supported Windows build, and a
                                         missing glyph next to a link reads as a broken image.
                                         Stroked, not filled, so it carries the same weight as the
                                         text beside it, and drawn on a 16-unit grid so it stays
                                         crisp. Accent-coloured to match the link it labels. -->
                                    <Path x:Name="OllamaGuideIcon"
                                          Width="17" Height="17"
                                          Margin="0,0,11,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppAccent}"
                                          StrokeThickness="1.15"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Data="M8,4.3 C6.7,3.3 4.9,2.9 3,2.9 L1.7,2.9 L1.7,12.1 L3,12.1
                                                C4.9,12.1 6.7,12.5 8,13.5
                                                M8,4.3 C9.3,3.3 11.1,2.9 13,2.9 L14.3,2.9 L14.3,12.1 L13,12.1
                                                C11.1,12.1 9.3,12.5 8,13.5
                                                M8,4.3 L8,13.5"/>

                                    <TextBlock FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap">
                                        <Hyperlink x:Name="OllamaGuideLink"
                                                   Foreground="{DynamicResource AppAccent}"
                                                   RequestNavigate="OllamaGuideLink_RequestNavigate"><Run Text="{DynamicResource S.Settings.OllamaGuide}"/></Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Column="0" Grid.Row="1" Text="{DynamicResource S.Settings.ApiBaseUrl}"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid Grid.Column="1" Grid.Row="1">
                                <TextBox x:Name="OpenAiBaseUrlBox"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="OpenAiSetting_TextChanged"/>
                                <TextBlock x:Name="OpenAiBaseUrlPlaceholder"
                                           IsHitTestVisible="False"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="{StaticResource AppFontSize}"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Opacity="0.7"
                                           Margin="10,0,10,0"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Grid.Column="0" Grid.Row="2" Text="{DynamicResource S.Common.ApiKey}"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource FieldLabel}"/>
                            <controls:SecretBox Grid.Column="1" Grid.Row="2" x:Name="OpenAiApiKeyBox"
                                                Margin="0,10,0,0"
                                                SecretChanged="OpenAiSecret_SecretChanged"/>

                            <!-- Digits only, empty for the default the placeholder shows. Narrow
                                 because it holds a few digits: a full-width box reads as a place
                                 for an address. The IME is off so a CJK keyboard types digits
                                 here rather than composing. -->
                            <TextBlock Grid.Column="0" Grid.Row="3" Text="{DynamicResource S.Settings.OpenAiTimeout}"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Column="1" Grid.Row="3" Margin="0,10,0,0"
                                        Orientation="Horizontal" HorizontalAlignment="Left">
                                <Grid Width="120">
                                    <TextBox x:Name="OpenAiTimeoutBox"
                                             Style="{StaticResource ModernTextBox}"
                                             MaxLength="4"
                                             InputMethod.IsInputMethodEnabled="False"
                                             PreviewTextInput="OpenAiTimeoutBox_PreviewTextInput"
                                             PreviewKeyDown="OpenAiTimeoutBox_PreviewKeyDown"
                                             DataObject.Pasting="OpenAiTimeoutBox_Pasting"
                                             TextChanged="OpenAiTimeoutBox_TextChanged"
                                             LostKeyboardFocus="OpenAiTimeoutBox_LostKeyboardFocus"/>
                                    <TextBlock x:Name="OpenAiTimeoutPlaceholder"
                                               IsHitTestVisible="False"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               Opacity="0.7"
                                               Margin="10,0,10,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <!-- The unit after the number rather than in the label: "Timeout (s)"
                                     reads oddly, and every language puts the unit after the value. -->
                                <TextBlock Text="{DynamicResource S.Settings.OpenAiTimeoutUnit}"
                                           Margin="8,0,0,0"
                                           Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Grid.Row="4" x:Name="OpenAiTimeoutError"
                                       Style="{StaticResource FieldHint}"
                                       Foreground="{DynamicResource AppError}"/>



                            <!-- Everything above is the server; everything below is the model. The
                                 two boxes above are set once and forgotten, while which model is
                                 loaded decides what a translation reads like — so the model, the
                                 prompts written for it and the temperature its documentation asks
                                 for are one saved thing, named and picked from a list, rather than
                                 three fields that have to be changed together and can be left
                                 disagreeing. A heading rather than the rule that used to sit here:
                                 a rule says the fields stopped, a heading says what starts. -->
                            <TextBlock Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2"
                                       Text="{DynamicResource S.Settings.ModelProfiles}"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,22,0,0"/>

                            <!-- The list and what the picked row resolves to, side by side. The
                                 two were stacked, which put the settings that actually get sent
                                 below the fold on a card this tall — and the names in the list mean
                                 nothing without them. Beside each other, picking a row and reading
                                 the result is one glance.

                                 Named so LayoutProbe can render this one card offscreen; that is
                                 the only reason the name exists. -->
                            <Border x:Name="PromptLibraryCard"
                                    Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2"
                                    Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource AppBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- The names are short and the prompt is a
                                                         paragraph, so the split is not even. -->
                                                    <ColumnDefinition Width="4*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="6*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- ── The library ──────────────────────────── -->
                                                <!-- The built-in prompt is its first row and carries
                                                     no button: it cannot be edited, because it is
                                                     what everyone who never writes one keeps
                                                     following as the shipped wording improves.
                                                     Editing it means adding one of your own, which
                                                     is the row at the bottom. -->
                                                <Grid Grid.Column="0" Margin="14,12,14,12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{DynamicResource S.Settings.ProfileListTitle}"
                                                               Style="{StaticResource SectionHeader}"
                                                               Margin="2,0,0,8"/>

                                                    <!-- The built-in row is the one thing in this
                                                         list nobody owns: it is rewritten by every
                                                         update, model and prompts together, which is
                                                         the point of it. That also means a setup
                                                         somebody is happy with disappears the next
                                                         time they update, without their having
                                                         touched anything. The card says so, and the
                                                         button turns this version's wording into a
                                                         row of their own before that happens. -->
                                                    <Border Grid.Row="1"
                                                            Style="{StaticResource InfoCardBorder}"
                                                            Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="&#xE946;"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="15"
                                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                                       VerticalAlignment="Top"
                                                                       Margin="0,1,10,0"/>

                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{DynamicResource S.Settings.ProfileSnapshotTitle}"
                                                                           FontFamily="{DynamicResource AppFont}"
                                                                           FontSize="{StaticResource AppFontSize}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AppTextPrimary}"
                                                                           TextWrapping="Wrap"/>

                                                                <TextBlock Text="{DynamicResource S.Settings.ProfileSnapshotBody}"
                                                                           FontFamily="{DynamicResource AppFont}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource AppTextSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="17"
                                                                           Margin="0,3,0,0"/>

                                                                <Button x:Name="ProfileSnapshotButton"
                                                                        Style="{StaticResource FlatButton}"
                                                                        Height="28"
                                                                        HorizontalAlignment="Left"
                                                                        Margin="0,9,0,0"
                                                                        Click="ProfileSnapshotButton_Click">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE8C8;"
                                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                   FontSize="12"
                                                                                   VerticalAlignment="Center"
                                                                                   Margin="0,0,8,0"/>
                                                                        <TextBlock Text="{DynamicResource S.Settings.ProfileSnapshotAction}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <Border Grid.Row="2"
                                                            BorderBrush="{DynamicResource AppBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="6">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Room for three rows whether or not
                                                                 there are three: the box would
                                                                 otherwise change height as prompts
                                                                 are added and deleted, and take the
                                                                 preview beside it with it. -->
                                                            <ItemsControl x:Name="PromptPresetList"
                                                                          Grid.Row="0"
                                                                          MinHeight="126"
                                                                          VerticalAlignment="Top">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <RadioButton GroupName="PromptPreset"
                                                                                     Style="{StaticResource PromptPresetRow}"
                                                                                     Tag="{Binding Id}"
                                                                                     IsChecked="{Binding IsSelected, Mode=OneTime}"
                                                                                     Checked="PromptPreset_Checked">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding Name}"
                                                                                           VerticalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"/>

                                                                                <!-- The badge and the
                                                                                     button share the
                                                                                     column: exactly one
                                                                                     of the two is ever
                                                                                     on a row. -->
                                                                                <Border Grid.Column="1"
                                                                                        Visibility="{Binding BuiltInBadgeVisibility}"
                                                                                        BorderBrush="{DynamicResource AppBorder}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="4"
                                                                                        Padding="6,1"
                                                                                        Margin="8,0,2,0"
                                                                                        VerticalAlignment="Center">
                                                                                    <TextBlock Text="{DynamicResource S.Settings.PromptReadOnly}"
                                                                                               FontFamily="{DynamicResource AppFont}"
                                                                                               FontSize="11"
                                                                                               Foreground="{DynamicResource AppTextSecondary}"/>
                                                                                </Border>

                                                                                <Button Grid.Column="1"
                                                                                        Visibility="{Binding ActionsVisibility}"
                                                                                        Style="{StaticResource IconButton}"
                                                                                        Width="30" Height="30"
                                                                                        Margin="8,0,0,0"
                                                                                        Tag="{Binding Id}"
                                                                                        ToolTip="{DynamicResource S.Settings.PromptEditTitle}"
                                                                                        Click="PromptEditPreset_Click">
                                                                                    <TextBlock Text="&#xE70F;"
                                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                               FontSize="13"
                                                                                               Foreground="{DynamicResource AppTextSecondary}"/>
                                                                                </Button>
                                                                            </Grid>
                                                                        </RadioButton>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <Button x:Name="PromptAddButton"
                                                                    Grid.Row="1"
                                                                    Style="{StaticResource PromptAddRow}"
                                                                    BorderBrush="{DynamicResource AppBorder}"
                                                                    BorderThickness="0,1,0,0"
                                                                    Click="PromptAddButton_Click">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE710;"
                                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,10,0"/>
                                                                    <TextBlock x:Name="PromptAddText"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <Rectangle Grid.Column="1"
                                                           Width="1"
                                                           Fill="{DynamicResource AppBorder}"/>

                                                <!-- ── What the picked row says ─────────────── -->
                                                <!-- Unfilled, and read-only for the same reason the
                                                     built-in row has no pencil on it: the list is
                                                     names, and a name is not a prompt. -->
                                                <Grid Grid.Column="2" Margin="14,12,14,12">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0"
                                                               Text="{DynamicResource S.Settings.ProfileInUse}"
                                                               Style="{StaticResource SectionHeader}"
                                                               Margin="2,0,0,8"/>

                                                    <!-- The two settings that are not prose, above the
                                                         two that are. They are what makes this a model
                                                         setting rather than a prompt: the wording below
                                                         was written for this model, at this
                                                         temperature, and reading one without the other
                                                         two is how they come to disagree. -->
                                                    <StackPanel Grid.Row="1">
                                                        <!-- The model on a card of its own, above
                                                             the three numbers. It is the answer to a
                                                             different question - which model this
                                                             setting is for, rather than how it is
                                                             asked - and it is the one value a reader
                                                             takes away with them, which is what the
                                                             copy beside it is for. -->
                                                        <Border Style="{StaticResource ProfileCard}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- The glyph inside the well
                                                                     rather than stacked on top of
                                                                     it in the same cell: two
                                                                     siblings each centre themselves
                                                                     against the row, which is
                                                                     taller than the well, and the
                                                                     two centres are not the same
                                                                     point. -->
                                                                <Border Grid.Column="0"
                                                                        Style="{StaticResource ProfileCardIconWell}">
                                                                    <TextBlock Text="&#xF158;"
                                                                               Style="{StaticResource ProfileCardIcon}"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Margin="10,0,8,0">
                                                                    <TextBlock Text="{DynamicResource S.Settings.ModelName}"
                                                                               Style="{StaticResource ProfileCardLabel}"/>
                                                                    <TextBlock x:Name="ProfileModelText"
                                                                               Style="{StaticResource ProfileCardMono}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="2"
                                                                        x:Name="ProfileModelCopyButton"
                                                                        Width="34" Height="34"
                                                                        Padding="0"
                                                                        VerticalAlignment="Center"
                                                                        Style="{StaticResource FlatButton}"
                                                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                        FontSize="14"
                                                                        Foreground="{DynamicResource AppTextSecondary}"
                                                                        Content="&#xE8C8;"
                                                                        ToolTip="{DynamicResource S.Settings.CopyModelName}"
                                                                        AutomationProperties.Name="{DynamicResource S.Settings.CopyModelName}"
                                                                        Click="ProfileModelCopy_Click"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- The three side by side rather than
                                                             stacked: each is a number two or three
                                                             characters long, and they are read
                                                             together - what a temperature means
                                                             depends on the Top P beside it. -->
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0"
                                                                Style="{StaticResource ProfileCard}"
                                                                Margin="0,0,4,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                                        Style="{StaticResource ProfileCardIconWell}">
                                                                    <TextBlock Text="&#xE9CA;"
                                                                               Style="{StaticResource ProfileCardIcon}"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Margin="10,0,0,0">
                                                                    <TextBlock Text="{DynamicResource S.Settings.Temperature}"
                                                                               Style="{StaticResource ProfileCardLabel}"/>
                                                                    <TextBlock x:Name="ProfileTemperatureText"
                                                                               Style="{StaticResource ProfileCardValue}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Column="1"
                                                                Style="{StaticResource ProfileCard}"
                                                                Margin="4,0,4,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                                        Style="{StaticResource ProfileCardIconWell}">
                                                                    <TextBlock Text="&#xE9E9;"
                                                                               Style="{StaticResource ProfileCardIcon}"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Margin="10,0,0,0">
                                                                    <TextBlock Text="{DynamicResource S.Settings.TopP}"
                                                                               Style="{StaticResource ProfileCardLabel}"/>
                                                                    <TextBlock x:Name="ProfileTopPText"
                                                                               Style="{StaticResource ProfileCardValue}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <Border Grid.Column="2"
                                                                Style="{StaticResource ProfileCard}"
                                                                Margin="4,0,0,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0"
                                                                        Style="{StaticResource ProfileCardIconWell}">
                                                                    <TextBlock Text="&#xE943;"
                                                                               Style="{StaticResource ProfileCardIcon}"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1"
                                                                            VerticalAlignment="Center"
                                                                            Margin="10,0,0,0">
                                                                    <TextBlock Text="{DynamicResource S.Settings.Seed}"
                                                                               Style="{StaticResource ProfileCardLabel}"/>
                                                                    <TextBlock x:Name="ProfileSeedText"
                                                                               Style="{StaticResource ProfileCardValue}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        </Grid>
                                                    </StackPanel>

                                                    <Rectangle Grid.Row="2"
                                                               Height="1"
                                                               Margin="0,12,0,0"
                                                               Fill="{DynamicResource AppSeparator}"/>

                                                    <!-- The pair of tabs used to sit above the whole
                                                         card, where it read as choosing how the app
                                                         translates. All it has ever picked is which of
                                                         the two sets of prompts is on screen, and now
                                                         that the card also holds a model and a
                                                         temperature - which the pair does not scope -
                                                         it has to sit against the prompts themselves. -->
                                                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                                        <Border BorderBrush="{DynamicResource AppBorder}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                ClipToBounds="True">
                                                            <Grid>
                                                                <!-- An even split rather than tabs sized
                                                                     to their own labels: the two names
                                                                     run to a similar length in every
                                                                     language this ships in, and two tabs
                                                                     of different widths read as one
                                                                     being the main one. -->
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Neither tab is checked here: a
                                                                     checked state set in markup raises
                                                                     Checked while the panel is still
                                                                     being constructed, before the
                                                                     debounce timers its handler writes
                                                                     through exist. Opening the panel
                                                                     sets it. -->
                                                                <RadioButton x:Name="PromptAutoTab"
                                                                             Grid.Column="0"
                                                                             GroupName="PromptTab"
                                                                             Style="{StaticResource PromptTab}"
                                                                             Content="{DynamicResource S.Settings.PromptAuto}"
                                                                             Checked="PromptTab_Checked"/>
                                                                <RadioButton x:Name="PromptExplicitTab"
                                                                             Grid.Column="1"
                                                                             GroupName="PromptTab"
                                                                             Style="{StaticResource PromptTab}"
                                                                             Content="{DynamicResource S.Settings.PromptExplicit}"
                                                                             Checked="PromptTab_Checked"/>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Says when the prompt on screen is the one
                                                             that gets sent: the tab names alone leave a
                                                             reader to guess whether the other one is
                                                             off. -->
                                                        <TextBlock x:Name="PromptTabHint"
                                                                   Style="{StaticResource FieldHint}"
                                                                   Margin="2,8,0,0"/>
                                                    </StackPanel>

                                                    <!-- One panel per chat role, stacked in the order
                                                         they are sent. Both halves are always drawn,
                                                         at the same height, whichever one the prompt
                                                         fills: the pair is the shape of the thing
                                                         being previewed, and a panel that appears
                                                         only when it has content would make the
                                                         other one move every time the picked row
                                                         changes. An unused half says so — see
                                                         PromptRoleEmptyText. -->
                                                    <Grid Grid.Row="4" Margin="0,10,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="10"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <Border Grid.Row="0" Style="{StaticResource PromptRoleFrame}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" Style="{StaticResource PromptRoleHeaderBar}">
                                                                    <TextBlock Text="System Prompt"
                                                                               Style="{StaticResource PromptRoleLabel}"/>
                                                                </Border>
                                                                <ScrollViewer Grid.Row="1"
                                                                              Padding="14,11"
                                                                              VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Disabled">
                                                                    <Grid>
                                                                        <TextBlock x:Name="PromptPreviewSystemText"
                                                                                   Style="{StaticResource PromptRoleBodyText}"/>
                                                                        <TextBlock x:Name="PromptPreviewSystemEmpty"
                                                                                   Style="{StaticResource PromptRoleEmptyText}"
                                                                                   Text="{DynamicResource S.Settings.PromptRoleEmpty}"
                                                                                   Visibility="Collapsed"/>
                                                                    </Grid>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </Border>

                                                        <Border Grid.Row="2" Style="{StaticResource PromptRoleFrame}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Grid.Row="0" Style="{StaticResource PromptRoleHeaderBar}">
                                                                    <TextBlock Text="User Prompt"
                                                                               Style="{StaticResource PromptRoleLabel}"/>
                                                                </Border>
                                                                <ScrollViewer Grid.Row="1"
                                                                              Padding="14,11"
                                                                              VerticalScrollBarVisibility="Auto"
                                                                              HorizontalScrollBarVisibility="Disabled">
                                                                    <Grid>
                                                                        <TextBlock x:Name="PromptPreviewUserText"
                                                                                   Style="{StaticResource PromptRoleBodyText}"/>
                                                                        <TextBlock x:Name="PromptPreviewUserEmpty"
                                                                                   Style="{StaticResource PromptRoleEmptyText}"
                                                                                   Text="{DynamicResource S.Settings.PromptRoleEmpty}"
                                                                                   Visibility="Collapsed"/>
                                                                    </Grid>
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- The page's own auto-save line is behind the scrim, so the same contract is
                     restated here rather than leaving this card looking like it needs an OK. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="&#xE945;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource AppAccent}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource S.Settings.AutoSaveHint}"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <!-- Beside the scrim rather than inside it: this card's own scrim swallows the click, and a
         click that reached the one above would close the panel out from under the prompt being
         written. -->
    <settings:PromptEditOverlay x:Name="PromptEditor"/>
    </Grid>
</UserControl>
