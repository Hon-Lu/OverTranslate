<UserControl x:Class="OverTranslate.Views.Settings.MangaModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- One of the card's pills: what the models do, an accent mark and grey words. -->
        <Style x:Key="MangaFeaturePill" TargetType="Border">
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource AppBorder}"/>
            <Setter Property="Background"      Value="{DynamicResource MangaCardChipBg}"/>
            <Setter Property="Padding"         Value="8,2,9,3"/>
            <Setter Property="Margin"          Value="0,0,6,6"/>
        </Style>
        <Style x:Key="MangaFeatureText" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="11.5"/>
            <Setter Property="Margin"            Value="5,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="{DynamicResource AppTextSecondary}"/>
        </Style>

        <!-- The card's quiet actions: 取消, 刪除模型. Text in the accent colour, nothing around it. -->
        <Style x:Key="MangaCardLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- In the settings page's 辨識模型 section, beside the recognition languages: the same parts as the
         rest of the page - a 34px accent tile, small pills, the page's own buttons - and one thing of its
         own, the tint that runs from the corner, so it is still the first thing in the section that is
         seen. Beside the list it stacks; where the section is one column (Horizontal) its download or
         progress moves to the right of the text, as a strip across the section. -->
    <Border x:Name="MangaCard"
            CornerRadius="8"
            BorderThickness="1"
            Padding="16,14"
            Background="{DynamicResource MangaCardBg}"
            BorderBrush="{DynamicResource MangaCardBorder}"
            TextElement.Foreground="{DynamicResource MangaCardFg}"
            TextElement.FontFamily="{DynamicResource AppFont}">
        <Grid x:Name="MangaCardBody" SizeChanged="MangaCardBody_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="MangaSideColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <!-- Tile, name and state chip on one line, what it is for under the name. The name
                     wraps rather than trims where it runs long: it is the one word that says what
                     the card is. -->
                <Grid x:Name="MangaCardHead">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The tile the shortcut rows use, with the card's own drawing in it: vertical
                         columns in a speech bubble. -->
                    <Border Grid.Column="0" Grid.RowSpan="2"
                            Width="34" Height="34" CornerRadius="8"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AppAccentSubtle}"
                            BorderBrush="{DynamicResource AppAccentSubtleHover}"
                            BorderThickness="1">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="48" Height="48">
                                <Path Stroke="{DynamicResource AppAccent}" StrokeThickness="3" StrokeLineJoin="Round"
                                      Data="M 21,12.5 c 8,0,13.5,4.6,13.5,10.8 S 29,34,21,34 c -1.3,0,-2.6,-.1,-3.8,-.4 c -1.9,2.2,-4.7,3.9,-8.2,4.6 c 1.4,-1.5,2.3,-3.3,2.6,-5.3 C 8.6,31,7.5,27.4,7.5,23.3 C 7.5,17.1,13,12.5,21,12.5 Z"/>
                                <Path Stroke="{DynamicResource AppAccent}" StrokeThickness="3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 27,18.5 L 27,28.5 M 21,18.5 L 21,26 M 15,18.5 L 15,23.5"/>
                                <Path Fill="{DynamicResource AppAccent}"
                                      Data="M 38.5,5.5 c .5,3.2,1.8,4.5,5,5 c -3.2,.5,-4.5,1.8,-5,5 c -.5,-3.2,-1.8,-4.5,-5,-5 c 3.2,-.5,4.5,-1.8,5,-5 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock x:Name="MangaCardTitle" Grid.Column="1"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{DynamicResource S.Settings.MangaModels}"/>
                    <TextBlock x:Name="MangaCardDesc1" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                               Margin="12,2,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextSecondary}"
                               Text="{DynamicResource S.Settings.MangaModelsDesc1}"/>
                    <!-- At the card's right edge beside the list; just after the name in a strip,
                         where the right edge belongs to the download (PlaceFoot). -->
                    <Border x:Name="MangaChip" Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            CornerRadius="10"
                            Padding="8,2,9,3"
                            BorderThickness="1"
                            Background="{DynamicResource MangaCardChipBg}"
                            BorderBrush="{DynamicResource MangaCardChipBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MangaChipDot" Width="7" Height="7"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="MangaChipText" Margin="6,0,0,0"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- What the models are for, as pills under the name. -->
                <WrapPanel x:Name="MangaFeatures" Margin="0,12,0,0">
                    <Border Style="{StaticResource MangaFeaturePill}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource AppAccent}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 13.5,3.5 L 13.5,16.5 M 9.5,3.5 L 9.5,12.5 M 5.5,3.5 L 5.5,9.5"/>
                            <TextBlock x:Name="MangaFeature1" Style="{StaticResource MangaFeatureText}"
                                       Text="{DynamicResource S.Settings.MangaModelsFeatureVertical}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MangaFeaturePill}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{DynamicResource AppAccent}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 3.5,10 A 6.5,6.5 0 1 1 16.5,10 A 6.5,6.5 0 1 1 3.5,10 Z M 7,10 L 9,12 L 13,7.8"/>
                            <TextBlock x:Name="MangaFeature2" Style="{StaticResource MangaFeatureText}"
                                       Text="{DynamicResource S.Settings.MangaModelsFeatureMissed}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MangaFeaturePill}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource AppAccent}"
                                  Data="M 11.2,2 L 4.5,11 h 4.3 L 8,18 l 6.8,-9.2 h -4.3 L 11.2,2 Z"/>
                            <TextBlock x:Name="MangaFeature3" Style="{StaticResource MangaFeatureText}"
                                       Text="{DynamicResource S.Settings.MangaModelsFeatureFast}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- The requirement, as a note in grey text. It is a condition for using the
                     models, not one of the things they do. -->
                <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondary}">
                    <Run Text="{DynamicResource S.Settings.NotePrefix}"/><Run x:Name="MangaCardDesc2" Text="{DynamicResource S.Settings.MangaModelsDesc2}"/>
                </TextBlock>
            </StackPanel>

            <!-- The foot: one of these three at a time, cross-faded. Under the text, or on its right
                 while the card is a strip (Horizontal). -->
            <Grid x:Name="MangaFoot" Grid.Row="1" Margin="0,12,0,0">
                <!-- 下載, or 不支援 greyed out; with models already here on a machine that cannot run
                     them (a graphics card changed since), a way to delete them under it. -->
                <StackPanel x:Name="MangaModelsDownloadPanel">
                    <!-- Over the button when an earlier version is here: what was had is gone
                         from use, and this download is how to get it back. -->
                    <TextBlock x:Name="MangaModelsUpdatedNote"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppWarning}"
                               Text="{DynamicResource S.Settings.MangaModelsUpdated}"/>
                    <!-- The assets location is on a drive that is not connected. -->
                    <TextBlock x:Name="MangaModelsUnreachableNote"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource AppError}"
                               Text="{DynamicResource S.Assets.StoreUnreachable}"/>
                    <Button x:Name="MangaModelsDownloadBtn"
                            Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Right"
                            Height="30" Padding="14,0"
                            Click="MangaModelsDownloadBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="MangaModelsDownloadIcon" Width="14" Height="14" VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 8,2.5 L 8,10.5 M 4.5,7.5 L 8,11 l 3.5,-3.5 M 3,13.5 h 10"/>
                            <TextBlock x:Name="MangaModelsDownloadText" Margin="7,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MangaModelsUnsupportedDeleteBtn"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            Style="{StaticResource MangaCardLink}"
                            Content="{DynamicResource S.Settings.MangaModelsDelete}"
                            Click="MangaModelsDeleteBtn_Click"/>
                </StackPanel>

                <StackPanel x:Name="MangaModelsProgressPanel" Visibility="Collapsed">
                    <Border x:Name="MangaModelsProgressTrack"
                            Height="4" CornerRadius="2"
                            Background="{DynamicResource MangaCardTrack}"
                            SizeChanged="MangaModelsProgressTrack_SizeChanged">
                        <Border x:Name="MangaModelsProgressFill"
                                HorizontalAlignment="Left" Width="0" CornerRadius="2"
                                Background="{DynamicResource AppAccent}"/>
                    </Border>
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="MangaModelsProgressText" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="MangaModelsCancelBtn"
                                HorizontalAlignment="Right"
                                Margin="12,0,0,0"
                                Style="{StaticResource MangaCardLink}"
                                Content="{DynamicResource S.Settings.MangaModelsCancel}"
                                Click="MangaModelsCancelBtn_Click"/>
                    </Grid>
                </StackPanel>

                <!-- 已就緒 in green, 已停用 in grey, 無法使用 in amber, 下載失敗 in red.
                     With the models here the switch leads the line, and the whole line but
                     刪除模型 flips it (MangaModelsStatusBox_MouseLeftButtonDown): the sentence
                     beside the switch is what it switches, so it is part of the target. Where
                     the models cannot run (無法使用) the switch is there but dimmed, and the
                     sentence says why, as before. -->
                <Border x:Name="MangaModelsStatusBox"
                        Visibility="Collapsed"
                        CornerRadius="6" Padding="10,8" BorderThickness="1"
                        Background="Transparent"
                        MouseLeftButtonDown="MangaModelsStatusBox_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="MangaModelsSwitch" Grid.Column="0"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Style="{StaticResource ToggleSwitch}"
                                  AutomationProperties.Name="{DynamicResource S.Settings.MangaModelsEnabled}"
                                  Checked="MangaModelsSwitch_Changed"
                                  Unchecked="MangaModelsSwitch_Changed"/>
                        <TextBlock x:Name="MangaModelsStatus" Grid.Column="1"
                                   FontSize="12.5" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="MangaModelsDeleteBtn" Grid.Column="2"
                                Margin="10,0,0,0"
                                Style="{StaticResource MangaCardLink}"
                                Content="{DynamicResource S.Settings.MangaModelsDelete}"
                                Click="MangaModelsDeleteBtn_Click"/>
                        <Button x:Name="MangaModelsRetryBtn" Grid.Column="2"
                                Margin="10,0,0,0"
                                Height="28" Padding="12,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentButton}"
                                Content="{DynamicResource S.Settings.MangaModelsRetry}"
                                Click="MangaModelsDownloadBtn_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
