<UserControl x:Class="OverTranslate.Views.Settings.MangaModelCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- 漫畫直排模型's card. Its tile is drawn rather than a font glyph: it is the one thing on the
             page that is a separate download, and the drawing (.ai/vertical-ja3-handoff/ui) says what
             it is — vertical columns in a speech bubble — where a stock glyph would not. -->
        <DrawingImage x:Key="MangaModelIcon">
            <DrawingImage.Drawing>
                <DrawingGroup ClipGeometry="M0,0 H48 V48 H0 Z">
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#7C6CFF"/>
                                <GradientStop Offset="1" Color="#4F46E5"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,48,48" RadiusX="12" RadiusY="12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0"    Color="#38FFFFFF"/>
                                <GradientStop Offset="0.55" Color="#00FFFFFF"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,48,48" RadiusX="12" RadiusY="12"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#29FFFFFF" Thickness="1"/>
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0.5,0.5,47,47" RadiusX="11.5" RadiusY="11.5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFFFFF"
                                     Geometry="M 21,12.5 c 8,0,13.5,4.6,13.5,10.8 S 29,34,21,34 c -1.3,0,-2.6,-.1,-3.8,-.4 c -1.9,2.2,-4.7,3.9,-8.2,4.6 c 1.4,-1.5,2.3,-3.3,2.6,-5.3 C 8.6,31,7.5,27.4,7.5,23.3 C 7.5,17.1,13,12.5,21,12.5 Z"/>
                    <!-- Three columns read right to left. -->
                    <GeometryDrawing Geometry="M 27,18.5 L 27,28.5 M 21,18.5 L 21,26 M 15,18.5 L 15,23.5">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#5146E8" Thickness="2.6" StartLineCap="Round" EndLineCap="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <!-- The sparkle: a model, not a plain reader. -->
                    <GeometryDrawing Brush="#F2FFFFFF"
                                     Geometry="M 38.5,5.5 c .5,3.2,1.8,4.5,5,5 c -3.2,.5,-4.5,1.8,-5,5 c -.5,-3.2,-1.8,-4.5,-5,-5 c 3.2,-.5,4.5,-1.8,5,-5 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- The card's filled button. Pressing shrinks it a little, at once, so the press is felt before
             the download has anything to show; with animations off in Windows it simply snaps. -->
        <Style x:Key="MangaCardButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentFg}"/>
            <Setter Property="Background" Value="{DynamicResource AppAccent}"/>
            <Setter Property="FontSize"   Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AppAccentPressed}"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                                <MultiDataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Bg" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.ExitActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The card's quiet actions: 取消, 刪除模型. Text in the accent colour, nothing around it. -->
        <Style x:Key="MangaCardLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MangaCard"
            CornerRadius="12"
            BorderThickness="1"
            Background="{DynamicResource MangaCardBg}"
            BorderBrush="{DynamicResource MangaCardBorder}"
            TextElement.Foreground="{DynamicResource MangaCardFg}"
            TextElement.FontFamily="{DynamicResource AppFont}">
        <Grid x:Name="MangaCardBody" SizeChanged="MangaCardBody_SizeChanged">
            <!-- A glow from the top right corner, and a few faint columns under it:
                 vertical text, hinted at, rather than a picture of a manga page. -->
            <Rectangle Width="260" Height="180"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Fill="{DynamicResource MangaCardGlow}"
                       IsHitTestVisible="False"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,62,18,0"
                        IsHitTestVisible="False">
                <StackPanel.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0.3"  Color="#FF000000"/>
                        <GradientStop Offset="0.95" Color="#00000000"/>
                    </LinearGradientBrush>
                </StackPanel.OpacityMask>
                <Border Width="5" Height="120" CornerRadius="3" VerticalAlignment="Top"
                        Background="{DynamicResource MangaCardColumn}"/>
                <Border Width="5" Height="84" CornerRadius="3" VerticalAlignment="Top" Margin="9,0,0,0"
                        Background="{DynamicResource MangaCardColumn}"/>
                <Border Width="5" Height="140" CornerRadius="3" VerticalAlignment="Top" Margin="9,0,0,0"
                        Background="{DynamicResource MangaCardColumn}"/>
                <Border Width="5" Height="60" CornerRadius="3" VerticalAlignment="Top" Margin="9,0,0,0"
                        Background="{DynamicResource MangaCardColumn}"/>
                <Border Width="5" Height="100" CornerRadius="3" VerticalAlignment="Top" Margin="9,0,0,0"
                        Background="{DynamicResource MangaCardColumn}"/>
            </StackPanel>

            <StackPanel Margin="18,18,18,16">
                <!-- The chip sits beside the title when both fit, and under it when they do
                     not (PlaceMangaChip): a trimmed title would be the one word that says
                     what the card is. -->
                <Grid x:Name="MangaCardHead">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Column="0" Grid.RowSpan="2" Width="44" Height="44"
                           Source="{StaticResource MangaModelIcon}">
                        <Image.Effect>
                            <DropShadowEffect Color="#4F46E5" Opacity="0.45"
                                              BlurRadius="20" ShadowDepth="4" Direction="270"/>
                        </Image.Effect>
                    </Image>
                    <TextBlock x:Name="MangaCardTitle" Grid.Column="1"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="19" FontWeight="Bold"
                               TextWrapping="Wrap"
                               Text="{DynamicResource S.Settings.MangaModels}"/>
                    <Border x:Name="MangaChip" Grid.Column="2" Grid.RowSpan="2"
                            VerticalAlignment="Center"
                            CornerRadius="12"
                            Padding="8,4,10,4"
                            BorderThickness="1"
                            Background="{DynamicResource MangaCardChipBg}"
                            BorderBrush="{DynamicResource MangaCardChipBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="MangaChipDot" Width="7" Height="7"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="MangaChipText" Margin="6,0,0,0"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Margin="0,12,0,14"
                           FontSize="13"
                           LineHeight="20.8" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap"
                           Opacity="0.82">
                    <Run Text="{DynamicResource S.Settings.MangaModelsDesc1}"/>
                    <LineBreak/>
                    <Run Text="{DynamicResource S.Settings.MangaModelsDesc2}"/>
                </TextBlock>

                <Border CornerRadius="10"
                        Padding="4,10"
                        BorderThickness="1"
                        Background="{DynamicResource MangaCardFeatureBg}"
                        BorderBrush="{DynamicResource MangaCardFeatureBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Opacity="0.9">
                            <Path Width="20" Height="20"
                                  Stroke="{DynamicResource MangaCardFeatureIcon}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 13.5,3.5 L 13.5,16.5 M 9.5,3.5 L 9.5,12.5 M 5.5,3.5 L 5.5,9.5"/>
                            <TextBlock x:Name="MangaFeature1" Margin="4,5,4,0" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Text="{DynamicResource S.Settings.MangaModelsFeatureVertical}"/>
                        </StackPanel>
                        <Border Grid.Column="1" BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource MangaCardFeatureDivider}">
                            <StackPanel Opacity="0.9">
                                <Path Width="20" Height="20"
                                      Stroke="{DynamicResource MangaCardFeatureIcon}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 3.5,10 A 6.5,6.5 0 1 1 16.5,10 A 6.5,6.5 0 1 1 3.5,10 Z M 7,10 L 9,12 L 13,7.8"/>
                                <TextBlock x:Name="MangaFeature2" Margin="4,5,4,0" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{DynamicResource S.Settings.MangaModelsFeatureMissed}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource MangaCardFeatureDivider}">
                            <StackPanel Opacity="0.9">
                                <Path Width="20" Height="20"
                                      Fill="{DynamicResource MangaCardFeatureIcon}"
                                      Data="M 11.2,2 L 4.5,11 h 4.3 L 8,18 l 6.8,-9.2 h -4.3 L 11.2,2 Z"/>
                                <TextBlock x:Name="MangaFeature3" Margin="4,5,4,0" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Text="{DynamicResource S.Settings.MangaModelsFeatureFast}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- The foot: one of these three at a time, cross-faded. -->
                <Grid Margin="0,14,0,0">
                    <Button x:Name="MangaModelsDownloadBtn"
                            Style="{StaticResource MangaCardButton}"
                            Height="40"
                            Click="MangaModelsDownloadBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 8,2.5 L 8,10.5 M 4.5,7.5 L 8,11 l 3.5,-3.5 M 3,13.5 h 10"/>
                            <TextBlock x:Name="MangaModelsDownloadText" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="MangaModelsProgressPanel" Visibility="Collapsed">
                        <Border x:Name="MangaModelsProgressTrack"
                                Height="6" CornerRadius="3"
                                Background="{DynamicResource MangaCardTrack}"
                                SizeChanged="MangaModelsProgressTrack_SizeChanged">
                            <Border x:Name="MangaModelsProgressFill"
                                    HorizontalAlignment="Left" Width="0" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="#7C6CFF"/>
                                        <GradientStop Offset="1" Color="#52C4FA"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>
                        <Grid Margin="0,8,0,0" Opacity="0.8">
                            <TextBlock x:Name="MangaModelsProgressText" FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="MangaModelsCancelBtn"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource MangaCardLink}"
                                    Content="{DynamicResource S.Settings.MangaModelsCancel}"
                                    Click="MangaModelsCancelBtn_Click"/>
                        </Grid>
                    </StackPanel>

                    <!-- 已就緒 in green, 無法使用 in amber, 下載失敗 in red. -->
                    <Border x:Name="MangaModelsStatusBox"
                            Visibility="Collapsed"
                            CornerRadius="8" Padding="12,10" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="MangaModelsStatus" Grid.Column="0"
                                       FontSize="12.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="MangaModelsDeleteBtn" Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource MangaCardLink}"
                                    Content="{DynamicResource S.Settings.MangaModelsDelete}"
                                    Click="MangaModelsDeleteBtn_Click"/>
                            <Button x:Name="MangaModelsRetryBtn" Grid.Column="1"
                                    Margin="12,0,0,0"
                                    Height="28" Padding="14,0"
                                    FontSize="12.5"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MangaCardButton}"
                                    Content="{DynamicResource S.Settings.MangaModelsRetry}"
                                    Click="MangaModelsDownloadBtn_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
