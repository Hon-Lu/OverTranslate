<UserControl x:Class="OverTranslate.Views.Realtime.RealtimePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OverTranslate.Controls">

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Page header ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{DynamicResource S.Realtime.Title}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{DynamicResource S.Realtime.Subtitle}"
                       Style="{StaticResource PageSubtitle}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,8,0">
            <StackPanel MaxWidth="1040">

                <!-- ── 翻譯設定 ── -->
                <!-- One row of three, because they are one decision said three ways: what is being
                     read, what it becomes, and who does it. Stacked down the page they read as
                     three unrelated questions and pushed everything below them a screenful lower,
                     which matters on a page whose real work — the three steps — is underneath. -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Realtime.TranslationSettings}" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- OCR source languages only: this page recognises text off the screen,
                                 so a language the recogniser cannot read has nothing to offer here.
                                 Left unset on purpose — see RealtimePage.ApplyPageDefaults. -->
                            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                <TextBlock Text="{DynamicResource S.Realtime.SourceLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <!-- Placeholder rather than a line of help underneath: the field is
                                     empty because the user has to answer it, and saying so inside
                                     the empty space puts the instruction where they are already
                                     looking. Margin matches the selected item's own (9,0,28,0) so
                                     the prompt and the eventual answer occupy the same spot rather
                                     than shifting when one replaces the other. -->
                                <Grid>
                                    <ComboBox x:Name="SrcLangBox"
                                              Style="{StaticResource ModernComboBox}"
                                              SelectedValuePath="Code"/>
                                    <TextBlock x:Name="SrcLangPlaceholder"
                                               Text="{DynamicResource S.Realtime.SourceLanguagePrompt}"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextSecondary}"
                                               Margin="9,0,28,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="7,0,7,0">
                                <TextBlock Text="{DynamicResource S.Realtime.TargetLanguage}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="TgtLangBox"
                                          Style="{StaticResource ModernComboBox}"
                                          ctl:ComboBoxSearch.IsEnabled="True"
                                          SelectedValuePath="Code"/>
                            </StackPanel>

                            <!-- The hint stays under its own field rather than under the row: it is
                                 about the service and nothing else, and a warning about a missing
                                 API key is worth the uneven card it makes. -->
                            <StackPanel Grid.Column="2" Margin="7,0,0,0">
                                <TextBlock Text="{DynamicResource S.Realtime.Provider}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ProviderBox"
                                          Style="{StaticResource ModernComboBox}"
                                          SelectedValuePath="Provider"/>
                                <TextBlock x:Name="ProviderHint"
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 步驟 1：選擇擷取方式 ── -->
                <!-- Numbered from here on, because the three cards below are not three settings the
                     user may set in any order — the second one cannot be answered until the first
                     is, and the whole card changes with that answer. A number says that where a
                     heading only names it. -->
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="1" Style="{StaticResource StepBadgeText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Realtime.Step1Label}" Style="{StaticResource StepLabel}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource S.Realtime.Step1Name}" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{DynamicResource S.Realtime.Step1Desc}" Style="{StaticResource StepDescription}"/>
                        </StackPanel>

                        <!-- Two tiles rather than a dropdown or a pair of radio buttons: there are
                             exactly two, both fit side by side, and each needs a line of its own to
                             say what it does — which a closed dropdown cannot show at all. -->
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Grid.Column="0"
                                         x:Name="ScreenModeRadio"
                                         Style="{StaticResource ChoiceTile}"
                                         Margin="0,0,6,0"
                                         IsChecked="True"
                                         Checked="CaptureModeRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ChoiceTileIconBox}">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource ChoiceTileGlyph}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Realtime.CaptureSourceScreen}"
                                                   Style="{StaticResource ChoiceTileTitle}"/>
                                        <TextBlock Text="{DynamicResource S.Realtime.CaptureSourceScreenHint}"
                                                   Style="{StaticResource FieldHint}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="1"
                                         x:Name="WindowModeRadio"
                                         Style="{StaticResource ChoiceTile}"
                                         Margin="6,0,0,0"
                                         Checked="CaptureModeRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Border Style="{StaticResource ChoiceTileIconBox}">
                                        <TextBlock Text="&#xE737;" Style="{StaticResource ChoiceTileGlyph}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Realtime.CaptureSourceWindow}"
                                                   Style="{StaticResource ChoiceTileTitle}"/>
                                        <TextBlock Text="{DynamicResource S.Realtime.CaptureSourceWindowHint}"
                                                   Style="{StaticResource FieldHint}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                        </Grid>

                        <!-- Under both tiles rather than inside the greyed one: a disabled control
                             is the wrong place to put the sentence explaining why it is disabled —
                             it is dimmed along with everything else in the tile, which is exactly
                             the text the user needs to read. Spans the card so it reads as a fact
                             about this step, not a footnote to one option. -->
                        <Border x:Name="ScreenModeNotice"
                                Grid.Row="1" Grid.ColumnSpan="2"
                                Style="{StaticResource InfoCardBorder}"
                                Margin="0,14,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE946;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{DynamicResource S.Realtime.ScreenModeUnsupported}"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="{StaticResource AppFontSize}"
                                           Foreground="{DynamicResource AppTextPrimary}"
                                           TextWrapping="Wrap"
                                           LineHeight="18"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ── 步驟 2：選擇畫面或視窗 ── -->
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="2" Style="{StaticResource StepBadgeText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Realtime.Step2Label}" Style="{StaticResource StepLabel}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource S.Realtime.Step2Name}" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{DynamicResource S.Realtime.Step2Desc}" Style="{StaticResource StepDescription}"/>
                        </StackPanel>

                        <Grid Grid.Column="1">
                            <!-- One screen per session, chosen here rather than assumed: the primary
                                 monitor is not where the game or the video necessarily is.

                                 Hidden in 視窗擷取, where it is not a choice: the blocks have to be
                                 drawn over the chosen window, so the monitor is wherever that window
                                 is, and offering the other one would only let the user build a
                                 session whose framing layer is on a screen the source is not on. -->
                            <StackPanel x:Name="ScreenPanel">
                                <TextBlock Text="{DynamicResource S.Realtime.CaptureSourceScreen}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{DynamicResource S.Realtime.ScreenPrompt}"
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,4,0,8"/>
                                <ComboBox x:Name="ScreenBox"
                                          Style="{StaticResource ModernComboBox}"
                                          ctl:ComboBoxDropDown.FitsControlWidth="True"
                                          ctl:ComboBoxSearch.IsEnabled="True"
                                          SelectedValuePath="DeviceName"
                                          SelectionChanged="ScreenBox_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F4;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{DynamicResource S.Realtime.ScreenHint}"
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>

                            <!-- Collapsed rather than disabled in 螢幕擷取: a greyed-out window
                                 picker invites the reader to work out why it is off, and the answer
                                 is already on the tile they did not press. -->
                            <StackPanel x:Name="WindowPickerPanel" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource S.Realtime.CaptureSourceWindow}"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{DynamicResource S.Realtime.CaptureWindowPromptLine}"
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,4,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Same placeholder arrangement as 來源語言 above: the field is
                                         empty because the user has to answer it, and the prompt sits
                                         where the answer will be. -->
                                    <Grid Grid.Column="0">
                                        <!-- Window titles are somebody else's text and can be any
                                             length; the list stays the width of the picker and
                                             scrolls sideways instead of growing across the card. -->
                                        <ComboBox x:Name="WindowBox"
                                                  Style="{StaticResource ModernComboBox}"
                                                  ctl:ComboBoxDropDown.FitsControlWidth="True"
                                                  ctl:ComboBoxSearch.IsEnabled="True"
                                                  SelectionChanged="WindowBox_SelectionChanged"
                                                  DropDownOpened="WindowBox_DropDownStateChanged"
                                                  DropDownClosed="WindowBox_DropDownStateChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE737;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock x:Name="WindowPlaceholder"
                                                   Text="{DynamicResource S.Realtime.CaptureWindowPrompt}"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="{StaticResource AppFontSize}"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   Margin="9,0,28,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                    </Grid>

                                    <!-- Icon and word both: the list is a snapshot of what was open
                                         when the page last asked, and a user who has just opened the
                                         game needs to know there is something to press. A lone glyph
                                         beside a dropdown reads as part of the dropdown. -->
                                    <Button Grid.Column="1"
                                            x:Name="RefreshWindowsBtn"
                                            Style="{StaticResource IconTextButton}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource S.Realtime.RefreshWindows}"
                                            Click="RefreshWindowsBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Margin="0,1,6,0"/>
                                            <TextBlock Text="{DynamicResource S.Realtime.RefreshWindows}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock x:Name="WindowHint"
                                           Style="{StaticResource FieldHint}"
                                           Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── 步驟 3：設定翻譯區塊 ── -->
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepBadge}">
                                    <TextBlock Text="3" Style="{StaticResource StepBadgeText}"/>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Realtime.Step3Label}" Style="{StaticResource StepLabel}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource S.Realtime.Step3Name}" Style="{StaticResource StepTitle}"/>
                            <TextBlock Text="{DynamicResource S.Realtime.Step3Desc}" Style="{StaticResource StepDescription}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource S.Realtime.BlockCount}" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                            <!-- A stepper rather than a text field: the value is one of three, and a
                                 box that accepts typing invites 0, 99 and empty, each of which then
                                 needs its own rule. The number is display-only and the two buttons
                                 are the only way in, so no input can be wrong. -->
                            <Border Style="{StaticResource StepperBorder}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BlockCountDown"
                                            Style="{StaticResource StepperButton}"
                                            Content="&#xE949;"
                                            AutomationProperties.Name="{DynamicResource S.Realtime.DecreaseBlocks}"
                                            Click="BlockCountDown_Click"/>
                                    <TextBlock x:Name="BlockCountText"
                                               Style="{StaticResource StepperValue}"
                                               Text="1"/>
                                    <Button x:Name="BlockCountUp"
                                            Style="{StaticResource StepperButton}"
                                            Content="&#xE948;"
                                            AutomationProperties.Name="{DynamicResource S.Realtime.IncreaseBlocks}"
                                            Click="BlockCountUp_Click"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{DynamicResource S.Realtime.BlockCountHint}"
                                       Style="{StaticResource FieldHint}"
                                       Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── 顯示外觀 ── -->
                <!-- The one card on this page whose values are kept — see the class remarks for the
                     rule that separates these from the session parameters above. -->
                <!-- One row per thing the reader can see on screen: the text, the band behind it, and
                     the border around it. Each row carries its own 自動／固定 tray, because 自動 is not a
                     separate feature to be switched on further down the page — it is the other answer
                     to the question the row is already asking. It was exactly that before: two
                     switches in a 進階選項 group at the bottom of the card, which left the colour picked
                     above them looking like the one in force when it was not. -->
                <Border Style="{StaticResource CardBorder}">
                    <!-- Scoped here so the three trays line up down the card, and the three colour
                         buttons with them: the same two questions asked of three different things,
                         and a column that wanders says they are not. -->
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <!-- The heading and the reset on one line. The reset puts the whole card back
                             now, so it belongs to the name of the card rather than to any group under
                             it — there were three of them before, each inside a group, and none could
                             say how much of the card it was about to undo. -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource S.Realtime.Appearance}"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>
                            <Button x:Name="ResetAppearanceBtn"
                                    Style="{StaticResource IconTextButton}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="{DynamicResource S.Realtime.ResetAppearance}"
                                    AutomationProperties.Name="{DynamicResource S.Realtime.ResetAppearance}"
                                    Click="ResetAppearanceBtn_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               VerticalAlignment="Center"
                                               Margin="0,1,6,0"/>
                                    <TextBlock Text="{DynamicResource S.Common.Reset}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Preview first, above the controls that feed it. A session hides the
                             shell window, so this is the last moment the user can see their colours
                             together — after 選取翻譯區塊 there is no way back to this page without
                             ending the session. -->
                        <Border Style="{StaticResource InnerGroupBorder}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Realtime.Preview}"
                                           Style="{StaticResource FieldLabel}"
                                           Margin="0,0,0,8"/>
                                <!-- Two backdrops, one per mode, because the two modes answer
                                     different questions and a single backdrop can only serve one.

                                     固定 paints a colour of ours, and what is underneath has no say
                                     in it. The chequerboard is the honest ground for that: it says
                                     this page cannot know what is back there, and it lets a
                                     translucent band be judged on its own — the same thing a
                                     chequerboard means everywhere else it is used.

                                     自動 is the opposite. Its whole answer is "whatever is under it",
                                     and over a chequerboard there is nothing for it to be: with the
                                     band gone the preview read as no background at all, rather than
                                     as the background having become the picture. So 自動 swaps in a
                                     made-up frame — soft shapes over a dark wash, which is roughly
                                     what sits behind a subtitle in a video or a game. None of it is
                                     a real title. It is here to put several colours across the strip
                                     the translation lands on, so that "the background is the
                                     picture" is something the reader watches happen.

                                     Both are fixed in both themes: they stand for content, not for
                                     chrome, and a backdrop that went light with the theme would make
                                     a white band look invisible and a black one look far heavier
                                     than it is. -->
                                <Border x:Name="PreviewBackdrop"
                                        Height="96"
                                        CornerRadius="4"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Border x:Name="PreviewChecker"
                                                Background="{StaticResource TransparencyChecker}"/>

                                        <!-- Blurred as a group rather than drawn soft: a handful of
                                             hard ellipses put through one blur is what gives the
                                             out-of-focus look, and it keeps the shapes legible in
                                             the markup. Every piece is oversized and hangs past the
                                             frame, so the blur melts the shapes into each other
                                             instead of fading the frame out at its own edges — the
                                             Border above clips whatever spills. -->
                                        <Grid x:Name="PreviewScene" Visibility="Collapsed">
                                            <Grid.Effect>
                                                <BlurEffect Radius="26"/>
                                            </Grid.Effect>

                                            <Rectangle Margin="-40">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Offset="0"   Color="#0C2A34"/>
                                                        <GradientStop Offset="0.5" Color="#154654"/>
                                                        <GradientStop Offset="1"   Color="#07161F"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <!-- Placed so that the middle band — where the
                                                 translation goes — crosses three of them. A strip of
                                                 one flat colour would leave 自動 with nothing to
                                                 show. -->
                                            <Ellipse Width="240" Height="150" Opacity="0.55"
                                                     Fill="#3E9FB8"
                                                     HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Margin="-40,-44,0,0"/>
                                            <Ellipse Width="180" Height="130" Opacity="0.34"
                                                     Fill="#74D6C2"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     Margin="150,16,0,0"/>
                                            <Ellipse Width="230" Height="170" Opacity="0.38"
                                                     Fill="#D9A566"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Margin="0,0,30,0"/>
                                            <Ellipse Width="96" Height="96" Opacity="0.5"
                                                     Fill="#BFE9F2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,-26,150,0"/>

                                            <Rectangle Height="44" Margin="-40,0,-40,-12"
                                                       VerticalAlignment="Bottom">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#0005080C"/>
                                                        <GradientStop Offset="1" Color="#9905080C"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Grid>

                                        <Border x:Name="PreviewScrim"
                                                CornerRadius="3"
                                                Padding="14,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="PreviewText"
                                                       Text="{DynamicResource S.Realtime.PreviewText}"
                                                       FontFamily="Microsoft JhengHei, Segoe UI Variable Text, Segoe UI, Sans-Serif"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 文字顏色. The colour button stays where it is in 自動 rather than being
                             hidden: the row would otherwise change shape with the mode, and the colour
                             it holds is still what a sampled line falls back to when the sample is
                             unusable. Greyed, because in 自動 it is not what the reader is setting. -->
                        <Border Style="{StaticResource ToggleRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeAppearanceTray"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeAppearanceSwatch"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xEF3C;"
                                           Style="{StaticResource ToggleRowGlyph}"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Realtime.TextColor}"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Text="{DynamicResource S.Realtime.TextColorHint}"
                                               Style="{StaticResource FieldHint}"
                                               Margin="0,3,12,0"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Style="{StaticResource SegmentedTray}"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.TextColorMode}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeModeSegment"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeModeSegment"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="TextColorModeThumb"
                                                Grid.Column="0"
                                                Background="{DynamicResource AppAccent}"
                                                CornerRadius="6"
                                                SizeChanged="TextColorModeThumb_SizeChanged">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="TextColorModeThumbShift"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <RadioButton x:Name="TextColorAutoRadio" Grid.Column="0" GroupName="RealtimeTextColorMode"
                                                     Style="{StaticResource SegmentedTrackRadio}"
                                                     Content="{DynamicResource S.Realtime.ColorAuto}"/>
                                        <RadioButton x:Name="TextColorFixedRadio" Grid.Column="1" GroupName="RealtimeTextColorMode"
                                                     Style="{StaticResource SegmentedTrackRadio}"
                                                     Content="{DynamicResource S.Realtime.ColorFixed}"/>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="3"
                                        x:Name="TextColorBtn"
                                        Style="{StaticResource FlatButton}"
                                        Height="34"
                                        Padding="6,0"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.TextColor}"
                                        Click="TextColorBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="TextColorSwatch"
                                                Width="20" Height="20"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TextColorValue"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,6,0"/>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 底色 and how heavy it is drawn, in one group. The slider is not a setting of
                             its own — it says how much of the colour above it reaches the screen, and in
                             自動 there is no colour of ours left for it to weigh, which is why it goes
                             dim with the picker rather than sitting on in a group of its own. -->
                        <Border Style="{StaticResource ToggleRowBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeAppearanceTray"/>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeAppearanceSwatch"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="&#xE790;"
                                               Style="{StaticResource ToggleRowGlyph}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Realtime.ScrimColor}"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="{StaticResource AppFontSize}"
                                                   Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource S.Realtime.ScrimColorHint}"
                                                   Style="{StaticResource FieldHint}"
                                                   Margin="0,3,12,0"/>
                                    </StackPanel>

                                    <Border Grid.Column="2"
                                            Style="{StaticResource SegmentedTray}"
                                            AutomationProperties.Name="{DynamicResource S.Realtime.ScrimColorMode}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeModeSegment"/>
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeModeSegment"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="ScrimColorModeThumb"
                                                    Grid.Column="0"
                                                    Background="{DynamicResource AppAccent}"
                                                    CornerRadius="6"
                                                    SizeChanged="ScrimColorModeThumb_SizeChanged">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="ScrimColorModeThumbShift"/>
                                                </Border.RenderTransform>
                                            </Border>
                                            <RadioButton x:Name="ScrimColorAutoRadio" Grid.Column="0" GroupName="RealtimeScrimColorMode"
                                                         Style="{StaticResource SegmentedTrackRadio}"
                                                         Content="{DynamicResource S.Realtime.ColorAuto}"/>
                                            <RadioButton x:Name="ScrimColorFixedRadio" Grid.Column="1" GroupName="RealtimeScrimColorMode"
                                                         Style="{StaticResource SegmentedTrackRadio}"
                                                         Content="{DynamicResource S.Realtime.ColorFixed}"/>
                                        </Grid>
                                    </Border>

                                    <Button Grid.Column="3"
                                            x:Name="ScrimColorBtn"
                                            Style="{StaticResource FlatButton}"
                                            Height="34"
                                            Padding="6,0"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{DynamicResource S.Realtime.ScrimColor}"
                                            Click="ScrimColorBtn_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="ScrimColorSwatch"
                                                    Width="20" Height="20"
                                                    CornerRadius="3"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource AppBorder}"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock x:Name="ScrimColorValue"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,6,0"/>
                                            <TextBlock Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource AppTextSecondary}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,2,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- A rule rather than a gap: the slider is a second question inside
                                     this group, and without the line it reads as a caption to the
                                     picker above it. -->
                                <Border Height="1"
                                        Background="{DynamicResource AppSubtleBorder}"
                                        Margin="0,12,0,12"/>

                                <!-- Label, slider and number on one line. The slider is the one control
                                     here the user sets by watching something else — the preview above is
                                     what tells them when the band is right — so it gets the width that
                                     is left, and the number keeps a fixed column so the track does not
                                     shift under the thumb as the value goes from 7% to 72%. -->
                                <Grid x:Name="ScrimOpacityRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Capped rather than left to the sentence: an Auto column is as
                                         wide as the longest translation of the hint wants to be, and
                                         the track is what pays for it. -->
                                    <StackPanel Grid.Column="0" MaxWidth="360" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource S.Realtime.ScrimOpacity}"
                                                   FontFamily="{DynamicResource AppFont}"
                                                   FontSize="{StaticResource AppFontSize}"
                                                   Foreground="{DynamicResource AppTextPrimary}"/>
                                        <TextBlock Text="{DynamicResource S.Realtime.ScrimOpacityHint}"
                                                   Style="{StaticResource FieldHint}"
                                                   Margin="0,3,16,0"/>
                                    </StackPanel>
                                    <Slider Grid.Column="1"
                                            x:Name="ScrimOpacitySlider"
                                            Style="{StaticResource AppSlider}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            AutomationProperties.Name="{DynamicResource S.Realtime.ScrimOpacity}"
                                            ValueChanged="ScrimOpacitySlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2"
                                               x:Name="ScrimOpacityValue"
                                               Style="{StaticResource FieldLabel}"
                                               MinWidth="42"
                                               TextAlignment="Right"
                                               Margin="16,0,2,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 邊框: off by default. When on, 隨機 gives each translated group a colour of
                             its own, which also tells joined rows from their neighbours, and 固定 draws
                             every band in one colour. Its tray and its colour button sit in the same two
                             columns as the rows above, so the three read as one column asking the same
                             question rather than as three controls that happen to look alike. -->
                        <Border Style="{StaticResource ToggleRowBorder}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeAppearanceTray"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeAppearanceSwatch"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Grid.Row="0"
                                           Text="&#xE739;"
                                           Style="{StaticResource ToggleRowGlyph}"/>
                                <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource S.Realtime.Border}"
                                               FontFamily="{DynamicResource AppFont}"
                                               FontSize="{StaticResource AppFontSize}"
                                               Foreground="{DynamicResource AppTextPrimary}"/>
                                    <TextBlock Text="{DynamicResource S.Realtime.BorderHint}"
                                               Style="{StaticResource FieldHint}"
                                               Margin="0,3,12,0"/>
                                </StackPanel>
                                <!-- Right-aligned across the last two columns rather than given one of
                                     its own: the switch is the answer to this row, and it lines up with
                                     the right edge the two colour buttons already set. -->
                                <CheckBox Grid.Column="2" Grid.Row="0" Grid.ColumnSpan="2"
                                          x:Name="BorderToggle"
                                          Style="{StaticResource ToggleSwitch}"
                                          HorizontalAlignment="Right"
                                          Margin="14,0,2,0"
                                          AutomationProperties.Name="{DynamicResource S.Realtime.Border}"/>

                                <Border Grid.Column="2" Grid.Row="1"
                                        x:Name="BorderModeTray"
                                        Style="{StaticResource SegmentedTray}"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.BorderMode}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeModeSegment"/>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RealtimeModeSegment"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="BorderModeThumb"
                                                Grid.Column="0"
                                                Background="{DynamicResource AppAccent}"
                                                CornerRadius="6"
                                                SizeChanged="BorderModeThumb_SizeChanged">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="BorderModeThumbShift"/>
                                            </Border.RenderTransform>
                                        </Border>
                                        <RadioButton x:Name="BorderRandomRadio" Grid.Column="0" GroupName="RealtimeBorderMode"
                                                     Style="{StaticResource SegmentedTrackRadio}"
                                                     Content="{DynamicResource S.Realtime.BorderRandom}"/>
                                        <RadioButton x:Name="BorderFixedRadio" Grid.Column="1" GroupName="RealtimeBorderMode"
                                                     Style="{StaticResource SegmentedTrackRadio}"
                                                     Content="{DynamicResource S.Realtime.BorderFixed}"/>
                                    </Grid>
                                </Border>

                                <!-- Greyed in 隨機 rather than hidden, the same as the two colour rows
                                     above. Hiding it was defensible on its own — 隨機 has no single
                                     border colour for the swatch to be showing — but it left a hole
                                     in the one column the three rows share, and a row that loses a
                                     control when a mode is picked reads as something having gone
                                     wrong. The swatch keeps showing the stored 固定 colour, which is
                                     what switching back to 固定 would use. -->
                                <Button Grid.Column="3" Grid.Row="1"
                                        x:Name="BorderColorBtn"
                                        Style="{StaticResource FlatButton}"
                                        Height="34"
                                        Padding="6,0"
                                        Margin="12,10,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        ToolTip="{DynamicResource S.Realtime.BorderColor}"
                                        AutomationProperties.Name="{DynamicResource S.Realtime.BorderColor}"
                                        Click="BorderColorBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="BorderColorSwatch"
                                                Width="20" Height="20"
                                                CornerRadius="3"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                VerticalAlignment="Center"/>
                                        <TextBlock x:Name="BorderColorValue"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,6,0"/>
                                        <TextBlock Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,2,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Shown only while one of the rows above is in 自動, which is the only time it
                             is about anything on screen.

                             It is not a performance warning, and it used to read like one. Both
                             automatic modes work by reading the pixels already on screen: the colour
                             sampler reads once, when a line is rebuilt after the text changed, and the
                             background repair runs on its own thread at 4Hz over the strip belonging to
                             the block and stops at a fingerprint when the picture has not moved. What
                             actually decides whether they are worth having is the content: a picture
                             that holds still is one they can read correctly, and a picture that does
                             not is one they are always a moment behind. -->
                        <Grid x:Name="AutoModeNotice" Margin="4,0,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE946;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}"
                                       Margin="0,3,7,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{DynamicResource S.Realtime.AutoModeBestFor}"
                                       Style="{StaticResource FieldHint}"
                                       Margin="0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── 運作方式 ── -->
                <!-- Four lines, because the on-screen half of this feature is a mode the user has
                     not seen before: what the button does, what happens next, the one property that
                     is not obvious from looking at it (the blocks do not take the mouse), and the
                     way to put the overlays away for a scene without giving up the blocks. -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource S.Realtime.HowItWorks}" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,6"
                                   Text="{DynamicResource S.Realtime.Step1}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,6"
                                   Text="{DynamicResource S.Realtime.Step2}"/>
                        <TextBlock Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16"
                                   Text="{DynamicResource S.Realtime.Step3}"/>
                        <!-- Filled in by RenderPauseHint, which names the user's own shortcut and
                             drops the line entirely when they have cleared it. Its top margin sits
                             on this line rather than under the one above, so a hidden hint does not
                             leave a gap at the bottom of the card. -->
                        <TextBlock x:Name="PauseHint"
                                   Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="16"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ── -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center">
            <Button x:Name="PrimaryBtn"
                    Content="{DynamicResource S.Realtime.SelectBlocks}"
                    Style="{StaticResource AccentButton}"
                    Height="36" MinWidth="140" Padding="16,0"
                    DockPanel.Dock="Left"
                    Margin="0,0,14,0"
                    Click="PrimaryBtn_Click"/>
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{DynamicResource AppFont}"
                       FontSize="12"
                       Foreground="{DynamicResource AppTextSecondary}"/>
        </DockPanel>
    </Grid>
</UserControl>
