<Window x:Class="OverTranslate.Views.Realtime.RealtimeFramingPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0">

    <Window.Resources>
        <!-- One kept framing. The whole row is the control, as in a menu: its name over how many
             blocks and which application, with a tick on the one this target opens on. -->
        <Style x:Key="FramingMenuRow" TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="10,5">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A row that is not pressed as a whole: the framing on the screen now, the one changed
             since it was applied (its two buttons are the controls), one that cannot be placed, and
             the save row while there is nothing to save. Same size as a pressable row, no hover. -->
        <Style x:Key="FramingStaticRow" TargetType="Border">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextElement.FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="TextElement.FontSize" Value="12.5"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource AppTextPrimary}"/>
        </Style>

        <!-- 還原 and 更新 on a changed framing's row: small text buttons, always shown rather than on
             hover, so the two choices are read with the row. 還原 outlined, 更新 filled and last. -->
        <Style x:Key="FramingRowButton" TargetType="Button" BasedOn="{StaticResource ToolbarFlatButton}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FramingRowPrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolbarAccentButton}">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- The margin is the room the shadow is drawn in, as on the capsule and its panels; the
         LayoutTransform is set in code for the same mixed-DPI reason. No background: the rest of the
         window is fully transparent, which lets presses through. -->
    <Border x:Name="RootChrome" Margin="18,16,18,22">
        <Grid>
            <!-- Shadow on an empty twin: an Effect on the surface that carries the text would cost it
                 ClearType. -->
            <Border Background="{DynamicResource ToolbarBg}" Margin="2" CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect x:Name="Shadow"
                                      BlurRadius="24" ShadowDepth="4" Direction="270"
                                      Opacity="0.45" Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Chrome"
                    Background="{DynamicResource ToolbarBg}"
                    BorderBrush="{DynamicResource ToolbarMenuBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="8,4,8,8"
                    RenderOptions.ClearTypeHint="Enabled">
                <StackPanel>
                    <!-- The heading and the way out: the list is put away by picking a row, by this ✕,
                         or by pressing the bar's button again. -->
                    <DockPanel Height="34" Margin="10,0,0,0">
                        <Button x:Name="CloseBtn"
                                DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarIconButton}"
                                Focusable="False"
                                ToolTip="{DynamicResource S.Common.Close}"
                                AutomationProperties.Name="{DynamicResource S.Common.Close}"
                                Click="CloseBtn_Click">
                            <TextBlock Text="&#xE8BB;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="9.5"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <TextBlock Text="{DynamicResource S.Realtime.Framings}"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Filled in code (see RealtimeFramingPanel), one row per framing kept for this
                         monitor or application: the usable ones newest first, then the ones that
                         cannot be placed now. It scrolls once the rows outgrow the room the screen
                         leaves above or below the bar. -->
                    <ScrollViewer x:Name="RowsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  AutomationProperties.AutomationId="FramingListScroll">
                        <StackPanel x:Name="RowsHost"/>
                    </ScrollViewer>

                    <!-- 儲存目前框選, always at the bottom and outside the scrolling rows, so it is in
                         the same place however many framings are kept. A rule sets it apart from the
                         rows above it when there are any. -->
                    <Border x:Name="SaveRule"
                            Height="1"
                            Margin="10,4,10,4"
                            Background="{DynamicResource AppBorder}"/>
                    <ContentControl x:Name="SaveHost" Focusable="False"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
