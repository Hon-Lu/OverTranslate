<UserControl x:Class="OverTranslate.Views.Realtime.RealtimeFramingEditOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True">

    <!-- 編輯翻譯區域預設, from the ✎ on a row of the 即時翻譯 page's 翻譯區域預設 card: the name, and
         what the preset is. The blocks are not edited here — they are edited where they are drawn,
         and the hint says where. The scrim cancels, as the other one-field panels do. -->
    <Grid x:Name="Scrim"
          Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

        <Border x:Name="Card"
                Width="420"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <StackPanel Margin="24,20,24,20">
                <TextBlock Text="{DynamicResource S.Realtime.FramingEditTitle}"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           Margin="0,0,0,16"/>

                <TextBlock Text="{DynamicResource S.Realtime.FramingEditName}"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox"
                         Style="{StaticResource ModernTextBox}"
                         MaxLength="60"
                         AutomationProperties.Name="{DynamicResource S.Realtime.FramingEditName}"
                         AutomationProperties.AutomationId="FramingEditName"
                         KeyDown="NameBox_KeyDown"/>

                <!-- What the preset is: its picture, then whose it is, at what size, how many blocks. -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="Thumbnail" Focusable="False" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="DetailText"
                               Grid.Column="1"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12"
                               LineHeight="16"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextSecondary}"/>
                </Grid>

                <!-- Where the blocks are changed. -->
                <Border Margin="0,14,0,0" Padding="11,9,12,9" CornerRadius="6"
                        Background="{DynamicResource AppSurfaceBg}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppAccent}"
                                   VerticalAlignment="Top"
                                   Margin="0,2,9,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{DynamicResource S.Realtime.FramingEditHint}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Style="{StaticResource FlatButton}"
                            Height="34"
                            Padding="18,0"
                            Content="{DynamicResource S.Common.Cancel}"
                            AutomationProperties.AutomationId="FramingEditCancel"
                            Click="CancelButton_Click"/>
                    <Button Style="{StaticResource AccentButton}"
                            Height="34"
                            Margin="10,0,0,0"
                            Padding="18,0"
                            Content="{DynamicResource S.Common.Save}"
                            AutomationProperties.AutomationId="FramingEditSave"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
