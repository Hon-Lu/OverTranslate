<Window x:Class="OverTranslate.Views.Realtime.RealtimeBlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        IsHitTestVisible="False">

    <!-- One window per watched block rather than a single desktop-spanning layer: a translucent
         window is composed in software, so redrawing a subtitle-sized surface a few times a minute
         costs nothing, while redrawing the whole desktop for the same change would not. Natural mode
         leans on that further — it refreshes only these small surfaces, so a repaired background can
         follow video or game motion without a whole-screen overlay being redrawn behind it. -->
    <Grid x:Name="Root">
        <!-- Every background is drawn before any text, so a line whose background overlaps the line
             above can never cover that line's words. Two overlapping backgrounds sitting on each
             other is fine — they are only there to hide what is underneath — but text disappearing
             behind one is the feature failing at the only thing it does. The repaired patches make
             that sharper than the translucent bands did: a patch is opaque, so it would not merely
             darken a translation it covered. -->
        <Canvas x:Name="ScrimCanvas"/>
        <Canvas x:Name="TextCanvas"/>
        <!-- Which block this is, while the running bar's 模式 panel is open — see SetMarker. Drawn
             here rather than in a window of its own: a new window is a change to the capture's
             exclusion list, which costs a poll (see the exclusion notes in RealtimeSessionController),
             and this window is already left out of every frame, so the frame is never read with it. -->
        <Border x:Name="Marker" Visibility="Collapsed" BorderThickness="2" CornerRadius="4"
                BorderBrush="{DynamicResource AppAccent}">
            <Border x:Name="MarkerTag" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="{DynamicResource AppAccent}" CornerRadius="0,0,4,0" Padding="6,1,7,2">
                <TextBlock x:Name="MarkerText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           FontFamily="{DynamicResource AppFont}"/>
            </Border>
        </Border>
    </Grid>
</Window>
