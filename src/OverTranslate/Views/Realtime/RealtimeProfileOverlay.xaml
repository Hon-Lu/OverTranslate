<UserControl x:Class="OverTranslate.Views.Realtime.RealtimeProfileOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True"
             AutomationProperties.AutomationId="ProfileOverlay">

    <UserControl.Resources>
        <!-- The small tag after a preset's name and after a value only horizontal text reads. -->
        <Style x:Key="ProfileTag" TargetType="Border">
            <Setter Property="Background"        Value="{DynamicResource AppButtonBg}"/>
            <Setter Property="BorderBrush"       Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="CornerRadius"      Value="9"/>
            <Setter Property="Padding"           Value="7,0,7,1"/>
            <Setter Property="Margin"            Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- One preset in the new mode's template list: the service panel's ProfileRow — a ring at
             its start, the whole row taking the click, the chosen row filled. -->
        <Style x:Key="TemplateRow" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="16,12,10,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="Ring" Width="18" Height="18"
                                         Stroke="{DynamicResource AppTextSecondary}" StrokeThickness="1.5"
                                         VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccent}"/>
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="5.5"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Scrim" Background="#8C000000" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
            <!-- Wider and taller than the service panel's card (620): the rows are a name, the
                 自動｜手動 switch, a slot of 240 and a value column of 112, and the user found the
                 first version cramped. Width and the height cap follow the window — see OnSizeChanged. -->
            <Border x:Name="Card"
                    Width="800"
                    UseLayoutRounding="True"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="12"
                    Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
                </Border.Effect>

                <Grid Margin="24,18,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9E9;" Style="{StaticResource CardHeaderIcon}" FontSize="18"/>
                            <TextBlock x:Name="TitleText"
                                       FontFamily="{DynamicResource AppFont}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimary}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="560"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="PresetTag" Style="{StaticResource ProfileTag}">
                                <TextBlock Text="{DynamicResource S.Realtime.ProfilePresetTag}" FontSize="11"
                                           FontFamily="{DynamicResource AppFont}"
                                           Foreground="{DynamicResource AppTextSecondary}"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource OverlayCloseButton}"
                                VerticalAlignment="Center" Margin="0,0,-8,0"
                                ToolTip="{DynamicResource S.Common.Close}"
                                AutomationProperties.Name="{DynamicResource S.Common.Close}"
                                AutomationProperties.AutomationId="ProfileCloseBtn"
                                Click="CloseBtn_Click"/>
                    </Grid>

                    <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppSeparator}"/>

                    <ScrollViewer x:Name="BodyScroller" Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,16,0,0" Padding="0,0,8,0">
                        <Grid>
                            <!-- ══════════ New: name and template ══════════ -->
                            <StackPanel x:Name="NewPanel" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Realtime.ProfileName}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NewNameBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                             MaxLength="32"
                                             AutomationProperties.Name="{DynamicResource S.Realtime.ProfileName}"
                                             AutomationProperties.AutomationId="ProfileNewNameBox"
                                             TextChanged="NewNameBox_TextChanged"
                                             PreviewKeyDown="NewNameBox_PreviewKeyDown"/>
                                </Grid>
                                <TextBlock x:Name="NewNameError" Style="{StaticResource FieldHint}"
                                           Foreground="{DynamicResource AppError}" Margin="2,4,0,0"/>
                                <TextBlock Text="{DynamicResource S.Realtime.ProfileTemplate}" Style="{StaticResource FieldLabel}"
                                           Margin="0,14,0,6"/>
                                <Border x:Name="TemplateList" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                                        CornerRadius="10" SizeChanged="TemplateList_SizeChanged">
                                    <StackPanel x:Name="TemplateRows"/>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Realtime.ProfileTemplateHint}" Style="{StaticResource FieldHint}"
                                           FontSize="11.5" Margin="2,8,0,0"/>
                            </StackPanel>

                            <!-- ══════════ A mode: the same rows for a preset (locked) and a custom mode ══════════ -->
                            <StackPanel x:Name="EditPanel" Grid.IsSharedSizeScope="True">
                                <!-- Preset: what the window is, and the way to a mode that can be changed. -->
                                <Border x:Name="ReadOnlyNote" Background="{DynamicResource AppHeaderBg}" CornerRadius="6"
                                        Padding="10,7" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Top"
                                                   Margin="0,2,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{DynamicResource S.Realtime.ProfilePresetReadOnly}"
                                                   FontFamily="{DynamicResource AppFont}" FontSize="12"
                                                   Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>

                                <!-- Custom: its name, and the preset it follows with a way back to it. -->
                                <StackPanel x:Name="CustomHeader">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource S.Realtime.ProfileName}" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                                                 MaxLength="32"
                                                 AutomationProperties.Name="{DynamicResource S.Realtime.ProfileName}"
                                                 AutomationProperties.AutomationId="ProfileNameBox"
                                                 PreviewKeyDown="NameBox_PreviewKeyDown"
                                                 TextChanged="NameBox_TextChanged"
                                                 LostKeyboardFocus="NameBox_LostKeyboardFocus"/>
                                    </Grid>
                                    <TextBlock x:Name="NameError" Style="{StaticResource FieldHint}"
                                               Foreground="{DynamicResource AppError}" Margin="2,4,0,0"/>
                                    <Grid Margin="0,6,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TemplateLineText" FontFamily="{DynamicResource AppFont}" FontSize="12"
                                                   Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"
                                                   TextWrapping="Wrap"/>
                                        <Button x:Name="ResetAllBtn" Grid.Column="1" Style="{StaticResource IconTextButton}"
                                                AutomationProperties.AutomationId="ProfileResetAllBtn"
                                                Click="ResetAllBtn_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="13" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                                <TextBlock Text="{DynamicResource S.Realtime.ProfileResetAll}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- The values, one card per question, filled in code. No heading on a
                                     card: the user found 版面／時機／辨識 said nothing the rows inside did
                                     not. A preset's are the same rows, locked: see
                                     RealtimeProfileOverlay.ApplyLock. -->
                                <StackPanel x:Name="MainGroups">
                                    <Border Style="{StaticResource InnerGroupBorder}">
                                        <StackPanel x:Name="LayoutGroup"/>
                                    </Border>
                                    <Border Style="{StaticResource InnerGroupBorder}">
                                        <StackPanel x:Name="TimingGroup"/>
                                    </Border>
                                    <Border Style="{StaticResource InnerGroupBorder}">
                                        <StackPanel x:Name="RecognitionGroup"/>
                                    </Border>
                                </StackPanel>

                                <!-- Folding is reading, not editing: it works on a preset too. -->
                                <Button x:Name="AdvancedToggle" Style="{StaticResource AdvancedToggleRow}"
                                        AutomationProperties.AutomationId="ProfileAdvancedToggle"
                                        Click="AdvancedToggle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="AdvancedChevron" Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                   VerticalAlignment="Center" Margin="0,1,8,0"/>
                                        <TextBlock x:Name="AdvancedText" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <Border Style="{StaticResource InnerGroupBorder}" Margin="0">
                                        <StackPanel x:Name="AdvancedRecognitionGroup"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Rectangle x:Name="FootRule" Grid.Row="3" Height="1" Fill="{DynamicResource AppSeparator}" Margin="0,14,0,0"/>

                    <!-- A custom mode: 刪除 on the left, the auto-save contract on the right. -->
                    <Grid x:Name="EditFooter" Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="DeleteBtn" Style="{StaticResource IconTextButton}" Margin="-10,0,0,0"
                                AutomationProperties.AutomationId="ProfileDeleteBtn"
                                Click="DeleteBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource AppError}" VerticalAlignment="Center" Margin="0,1,6,0"/>
                                <TextBlock Text="{DynamicResource S.Realtime.ProfileDelete}" Foreground="{DynamicResource AppError}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource AppAccent}"
                                     VerticalAlignment="Center" Margin="0,1,8,0"/>
                            <TextBlock x:Name="SaveGlyph" Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="{DynamicResource AppAccent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="StatusText" FontFamily="{DynamicResource AppFont}" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- The new step: 取消 and 建立. -->
                    <StackPanel x:Name="NewFooter" Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,14,0,0" Visibility="Collapsed">
                        <Button Style="{StaticResource FlatButton}" Height="34" Padding="18,0"
                                Content="{DynamicResource S.Common.Cancel}"
                                AutomationProperties.AutomationId="ProfileNewCancelBtn"
                                Click="NewCancel_Click"/>
                        <Button x:Name="CreateBtn" Style="{StaticResource AccentButton}" Height="34" Padding="20,0"
                                Margin="10,0,0,0"
                                Content="{DynamicResource S.Realtime.ProfileCreate}"
                                AutomationProperties.AutomationId="ProfileCreateBtn"
                                Click="Create_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Delete, asked over the card the way the prompt editor asks. -->
        <Grid x:Name="ConfirmLayer" Visibility="Collapsed" Background="#8C000000"
              MouseLeftButtonDown="ConfirmScrim_MouseLeftButtonDown">
            <Border Width="400" UseLayoutRounding="True" HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="12" Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
                </Border.Effect>
                <StackPanel Margin="24,20,24,20">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource AppError}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource S.Realtime.ProfileDeleteTitle}"
                                   FontFamily="{DynamicResource AppFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="ConfirmMessage" FontFamily="{DynamicResource AppFont}"
                               FontSize="{StaticResource AppFontSize}" Foreground="{DynamicResource AppTextSecondary}"
                               LineHeight="20" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <!-- 取消 first and focused, so a key already held down does not land on 刪除. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancelBtn" Style="{StaticResource FlatButton}" Height="34" Padding="18,0"
                                Content="{DynamicResource S.Common.Cancel}"
                                AutomationProperties.AutomationId="ProfileConfirmCancelBtn"
                                Click="ConfirmCancel_Click"/>
                        <Button Style="{StaticResource DangerButton}" Margin="10,0,0,0" Padding="18,0"
                                Content="{DynamicResource S.Realtime.ProfileDelete}"
                                AutomationProperties.AutomationId="ProfileConfirmDeleteBtn"
                                Click="ConfirmDelete_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
