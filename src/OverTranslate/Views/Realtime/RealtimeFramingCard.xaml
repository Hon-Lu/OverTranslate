<UserControl x:Class="OverTranslate.Views.Realtime.RealtimeFramingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- ✎ and 🗑 at a row's right, drawn on a 16 grid like the bar's capsule marks: quiet in the
             secondary colour until the pointer is on one. Tab stops, with the accent ring when the
             keyboard is on one. -->
        <Style x:Key="FramingRowIconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A pencil, and a bin with its lid. -->
        <Geometry x:Key="FramingEditGlyph">M10.6,2.6 A1.5,1.5 0 0 1 12.7,4.7 L5.5,11.9 L2.7,12.6 L3.4,9.8 Z M9.6,3.6 L12.4,6.4</Geometry>
        <Geometry x:Key="FramingDeleteGlyph">M3,4.5 H13 M6.5,4.5 V3 H9.5 V4.5 M4.5,4.5 L5.1,13 H10.9 L11.5,4.5 M6.8,7 V11 M9.2,7 V11</Geometry>

        <!-- A kept framing: its picture, its name over the size and blocks, ✎ and 🗑. Not a control:
             which one a target opens on is chosen on the floating bar, where the blocks are. -->
        <Style x:Key="FramingRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="14,9,8,9"/>
        </Style>

        <!-- 選用中, after the name of the preset 開始 would put on this target: an accent word on a
             pale accent capsule, the size of the detail line. -->
        <Style x:Key="FramingInUseBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="8,1,8,2"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 其他螢幕或視窗: one row as tall and as framed as the list's, which opens into the list of
             every other target's presets under it. Its corners come in through Tag: all four while
             closed, the top two while the list hangs from it. The whole row is the control. -->
        <Style x:Key="FramingOthersToggle" TargetType="Button">
            <!-- A row is 54 high and its rule 1: the same 55 with this row's own two edges. -->
            <Setter Property="MinHeight" Value="55"/>
            <Setter Property="Padding" Value="14,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>10</CornerRadius>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent"
                                BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 復原 in the line a deletion leaves: an accent word that lightens under the pointer. -->
        <Style x:Key="FramingUndoButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppAccent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="5"
                                BorderBrush="Transparent" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <!-- The heading as on the rest of the page (RealtimeCardTitle), with its hint close under
                 it as 模式's is: the two cards are read the same way. -->
            <TextBlock Text="{DynamicResource S.Realtime.Framings}" Style="{StaticResource RealtimeCardTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="HintText" Text="{DynamicResource S.Realtime.FramingsHint}" Style="{StaticResource FieldHint}"
                       LineHeight="16" Margin="0,0,0,12"/>

            <!-- The screen or window chosen in 步驟 1／2, by name, and its presets: the one 開始
                 would put on it first, marked 選用中. Swapped, with a short fade, when the choice
                 changes. Filled in code (see RealtimeFramingCard). -->
            <StackPanel x:Name="CurrentPanel">
                <TextBlock x:Name="CurrentCaption"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,0,2,7"
                           AutomationProperties.AutomationId="FramingCurrentTarget"/>

                <Border x:Name="ListBorder" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10"
                        SizeChanged="ListBorder_SizeChanged">
                    <StackPanel x:Name="ListHost" AutomationProperties.AutomationId="FramingPresetList"/>
                </Border>

                <!-- Nothing kept for this target: a dashed frame with the one sentence that says where
                     a framing is kept from, rather than an empty list to fill in from here. -->
                <Grid x:Name="EmptyBox">
                    <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1" StrokeDashArray="4 3"
                               Stroke="{DynamicResource AppBorder}" SnapsToDevicePixels="True"/>
                    <TextBlock Text="{DynamicResource S.Realtime.FramingsEmpty}"
                               Style="{StaticResource FieldHint}" TextWrapping="Wrap" LineHeight="17"
                               Margin="14,11,14,12" AutomationProperties.AutomationId="FramingEmpty"/>
                </Grid>
            </StackPanel>

            <!-- 其他螢幕或視窗: every other target's presets, folded into one row until it is opened.
                 Not remembered: the page opens with it closed. -->
            <StackPanel x:Name="OthersPanel" Margin="0,14,0,0">
                <Button x:Name="OthersToggle" Style="{StaticResource FramingOthersToggle}"
                        Click="OthersToggle_Click"
                        AutomationProperties.AutomationId="FramingOthersToggle">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Realtime.FramingOthers}"
                                       FontFamily="{DynamicResource AppFont}"
                                       FontSize="{StaticResource AppFontSize}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource FramingInUseBadge}" Background="{DynamicResource AppSurfaceBg}">
                                <TextBlock x:Name="OthersCount"
                                           FontFamily="{DynamicResource AppFont}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource AppTextSecondary}"/>
                            </Border>
                        </StackPanel>
                        <!-- ChevronDown, turned half a turn while open. Drawn by the icon font, whose
                             glyph sits on the middle of its em box, so centring the box centres the
                             mark on the text's x-height. -->
                        <TextBlock x:Name="OthersChevron" Grid.Column="1"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="OthersChevronTurn" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Button>

                <!-- Hangs from the row above: no top edge of its own (the row's bottom edge is the
                     rule between them) and only the bottom corners rounded. -->
                <Border x:Name="OthersListBorder" BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Visibility="Collapsed"
                        SizeChanged="OthersListBorder_SizeChanged">
                    <StackPanel x:Name="OthersHost" AutomationProperties.AutomationId="FramingOthersList"/>
                </Border>
            </StackPanel>

            <!-- What a deletion leaves for a few seconds: what went, and 復原. -->
            <Border x:Name="UndoBar" Margin="0,12,0,0" Padding="14,4,4,4" CornerRadius="8"
                    Background="{DynamicResource AppSurfaceBg}"
                    BorderBrush="{DynamicResource AppBorder}" BorderThickness="1"
                    Visibility="Collapsed"
                    MouseEnter="UndoBar_MouseEnter" MouseLeave="UndoBar_MouseLeave">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UndoText"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextPrimary}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               AutomationProperties.AutomationId="FramingUndoText"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="UndoButton" Grid.Column="1" Margin="12,0,0,0"
                            Style="{StaticResource FramingUndoButton}"
                            Content="{DynamicResource S.Realtime.FramingUndo}"
                            FontFamily="{DynamicResource AppFont}"
                            FontSize="13"
                            Click="UndoButton_Click"
                            AutomationProperties.AutomationId="FramingUndo"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
