<UserControl x:Class="OverTranslate.Views.Realtime.RealtimeProfilesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Keyboard focus on a row: a 2-wide ring in the accent, inside the row's own bounds, so
             the list's border and the next row's rule stay where they are. A focus visual rather
             than an IsKeyboardFocused trigger, because a row clicked with the mouse keeps keyboard
             focus too and would keep the ring after the overlay it opened is closed. -->
        <Style x:Key="ProfileRowFocus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{DynamicResource AppAccent}" BorderThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One mode in the list, its name over its description: the whole row opens it. No
             selected look — the list says which modes there are, not which one is in use; each
             block has its own. The last row of a group drops its rule (BorderThickness 0), so it
             does not double the list's own border. -->
        <Style x:Key="ProfileListRow" TargetType="Button">
            <Setter Property="FontFamily"       Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"         Value="{StaticResource AppFontSize}"/>
            <Setter Property="Foreground"       Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ProfileRowFocus}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" Padding="16,9,0,9"
                                BorderBrush="{DynamicResource AppBorder}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The square at a row's left. A preset's is the accent's tint with its own glyph, so the
             three read as built in and are told apart; every custom mode's is the same neutral
             square with the same glyph, so they read as one kind. Steps a shade with its row. -->
        <Style x:Key="ProfileIconTile" TargetType="Border">
            <Setter Property="Width"        Value="30"/>
            <Setter Property="Height"       Value="30"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin"       Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background"   Value="{DynamicResource AppAccentSubtle}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppAccentSubtleHover}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProfileIconTileCustom" TargetType="Border" BasedOn="{StaticResource ProfileIconTile}">
            <Setter Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppButtonPressedBg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileChevron" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The two groups' headings: 預設, and 自訂模式 with how many of the allowed there are. -->
        <Style x:Key="ProfileGroupCaption" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        </Style>

        <!-- A mode's icon, drawn rather than a font glyph: a line drawing on a 16 grid, the same
             in every icon, and on Windows 10 too, whose MDL2 font lacks a sparkle. The brush is
             set per row (accent for a preset, secondary for a custom mode). Round caps and joins
             because the shapes are small and a square end reads as a stray pixel at 1.2 wide. -->
        <Style x:Key="ProfileIconPath" TargetType="Path">
            <Setter Property="Width"              Value="16"/>
            <Setter Property="Height"             Value="16"/>
            <Setter Property="StrokeThickness"    Value="1.2"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap"   Value="Round"/>
            <Setter Property="StrokeLineJoin"     Value="Round"/>
            <Setter Property="Stretch"            Value="None"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <StackPanel>
            <!-- The heading as on the rest of the page (RealtimeCardTitle). The hint under it is the
                 heading's subtitle, so it sits close, the 4 PageSubtitle leaves. -->
            <TextBlock Text="{DynamicResource S.Realtime.Profiles}" Style="{StaticResource RealtimeCardTitle}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="{DynamicResource S.Realtime.ProfilesHint}" Style="{StaticResource FieldHint}"
                       LineHeight="16" Margin="0,0,0,10"/>

            <!-- The list only: a mode is looked at and changed in RealtimeProfileOverlay, over the
                 shell, opened from its row. -->
            <TextBlock Text="{DynamicResource S.Realtime.ProfilesPreset}" Style="{StaticResource ProfileGroupCaption}"
                       Margin="2,2,0,6"/>
            <Border BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10">
                <StackPanel x:Name="PresetHost" SizeChanged="ListHost_SizeChanged"/>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,16,0,6">
                <TextBlock Text="{DynamicResource S.Realtime.ProfilesCustom}" Style="{StaticResource ProfileGroupCaption}"/>
                <TextBlock x:Name="CustomCount" Style="{StaticResource ProfileGroupCaption}" FontWeight="Normal"
                           Typography.NumeralAlignment="Tabular" Margin="8,0,0,0"/>
            </StackPanel>
            <!-- Only the custom modes scroll, and only past a few rows (MaxHeight set from the rows
                 themselves, see FitCustomScroll): ten of them made the card longer than the page
                 around it. The presets, the count and the add stay outside, always in view. -->
            <Border x:Name="CustomList" BorderBrush="{DynamicResource AppBorder}" BorderThickness="1" CornerRadius="10"
                    Margin="0,0,0,6">
                <ScrollViewer x:Name="CustomScroll"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False"
                              AutomationProperties.AutomationId="ProfileCustomScroll"
                              SizeChanged="CustomScroll_SizeChanged"
                              PreviewMouseWheel="CustomScroll_PreviewMouseWheel">
                    <StackPanel x:Name="CustomHost" SizeChanged="CustomHost_SizeChanged"/>
                </ScrollViewer>
            </Border>
            <!-- The add, as the app's other buttons are (FlatButton, as 開啟記錄資料夾), under the
                 custom list at its left. At the cap it greys and its text says why, rather than
                 going away. -->
            <Button x:Name="AddButton" Style="{StaticResource FlatButton}"
                    Height="32" Padding="14,0" Margin="0,2,0,0" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="ProfileAddRow"
                    Click="AddButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AddButtonGlyph" Text="&#xE710;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="AddButtonText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
