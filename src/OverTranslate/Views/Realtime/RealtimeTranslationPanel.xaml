<Window x:Class="OverTranslate.Views.Realtime.RealtimeTranslationPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0">

    <Window.Resources>
        <!-- One choice. The whole row is the control, as in any menu; the one in use is told by the
             accent and a tick rather than by a fill, so the fill stays free to say where the pointer
             or the keyboard is. The rows sit on the columns' grey, so the fill is the step above it. -->
        <Style x:Key="PanelRow" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A language: a little shorter than a service, because there are thirty of them to scroll
             through and twelve to see at once. -->
        <Style x:Key="LanguagePanelRow" TargetType="Button" BasedOn="{StaticResource PanelRow}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
        </Style>

        <Style x:Key="ColumnCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ToolbarGroupBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <!-- The card over the scrim: 模式's PanelCard, centred. The language pack card is only its
             contents, so this is its one frame. -->
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ToolbarBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,6,10,4"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        </Style>

        <Style x:Key="NoMatchText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- The search field: the app's own input colours, with the magnifier drawn rather than typed
             for the reason every mark on the capsule is — MDL2 on Windows 10 has a different one, and
             a Path has no fallback to lose. -->
        <Style x:Key="PanelSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AppAccent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{DynamicResource AppInputBg}"
                                BorderBrush="{DynamicResource AppInputBorder}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <Path Width="13" Height="13"
                                      Margin="10,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Stroke="{DynamicResource AppTextSecondary}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M9.5,5.5 A4,4 0 1 1 1.5,5.5 A4,4 0 1 1 9.5,5.5 Z M8.5,8.5 L11.5,11.5"/>
                                <TextBlock x:Name="Placeholder"
                                           Margin="30,0,10,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Text="{DynamicResource S.Common.SearchLanguage}"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="28,0,8,0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Focusable="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppInputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin is the room the shadow is drawn in, as on the capsule; the LayoutTransform is set
         in code for the same mixed-DPI reason. -->
    <Border x:Name="RootChrome" Margin="18,16,18,22" Background="Transparent">
        <Grid>
            <!-- Shadow on an empty twin, not on the panel: an Effect on the surface that carries the
                 text would cost it ClearType. -->
            <Border Background="{DynamicResource ToolbarBg}"
                    Margin="2"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect x:Name="Shadow"
                                      BlurRadius="24" ShadowDepth="4" Direction="270"
                                      Opacity="0.45" Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Chrome"
                    Background="{DynamicResource ToolbarBg}"
                    BorderBrush="{DynamicResource ToolbarMenuBorder}"
                    BorderThickness="1"
                    CornerRadius="14"
                    RenderOptions.ClearTypeHint="Enabled">
                <Grid>
                <StackPanel Margin="8,4,8,8">
                    <!-- One box for both language columns: either may be the one to find a name in,
                         and two boxes would be two places to type the same thing. -->
                    <Grid Height="40">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource PanelSearchBox}"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>

                    <!-- Service, source, target: the order the button reads in, mark first. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="ProviderColumn" Grid.Column="0" Style="{StaticResource ColumnCard}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ColumnHeader}" Text="{DynamicResource S.Realtime.Provider}"/>
                                <StackPanel x:Name="ProviderRows"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SourceColumn" Grid.Column="2" Style="{StaticResource ColumnCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}" Text="{DynamicResource S.Realtime.SourceLanguage}"/>
                                <Grid Height="320">
                                    <ScrollViewer x:Name="SourceScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel x:Name="SourceRows"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="SourceNoMatch" Style="{StaticResource NoMatchText}"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <Border x:Name="TargetColumn" Grid.Column="4" Style="{StaticResource ColumnCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource ColumnHeader}" Text="{DynamicResource S.Realtime.TargetLanguage}"/>
                                <Grid Height="320">
                                    <ScrollViewer x:Name="TargetScroll"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <StackPanel x:Name="TargetRows"/>
                                    </ScrollViewer>
                                    <TextBlock x:Name="TargetNoMatch" Style="{StaticResource NoMatchText}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- A language still to be downloaded asks over the whole panel, as 模式's cards do:
                     the same scrim, and a press on it puts the card away. The panel keeps its size.
                     Rounded with the chrome's inside corner, so the scrim does not show past it. -->
                <Border x:Name="PackLayer" Visibility="Collapsed"
                        Background="#8C000000" CornerRadius="13"
                        MouseLeftButtonDown="PackScrim_MouseLeftButtonDown">
                    <Border x:Name="PackCard" Style="{StaticResource PanelCard}"
                            MouseLeftButtonDown="PackCard_MouseLeftButtonDown">
                        <ContentControl x:Name="CardHost" Focusable="False"/>
                    </Border>
                </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
