<Window x:Class="OverTranslate.Views.Realtime.RealtimeLanguageMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        AllowsTransparency="True"
        Background="Transparent"
        Opacity="0">

    <Window.Resources>
        <!-- One language. The whole row is the control, as in any menu; the one in use is told by the
             accent and a tick rather than by a fill, so the fill stays free to say where the pointer
             or the keyboard is. -->
        <Style x:Key="LanguageRow" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupBg}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupBg}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ToolbarGroupHoverBg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The search field: the app's own input colours, with the magnifier drawn rather than typed
             for the reason every mark on the capsule is — MDL2 on Windows 10 has a different one, and
             a Path has no fallback to lose. -->
        <Style x:Key="MenuSearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AppAccent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{DynamicResource AppInputBg}"
                                BorderBrush="{DynamicResource AppInputBorder}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <Path Width="13" Height="13"
                                      Margin="10,0,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Stretch="None"
                                      Stroke="{DynamicResource AppTextSecondary}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M9.5,5.5 A4,4 0 1 1 1.5,5.5 A4,4 0 1 1 9.5,5.5 Z M8.5,8.5 L11.5,11.5"/>
                                <TextBlock x:Name="Placeholder"
                                           Margin="30,0,10,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"
                                           FontFamily="{TemplateBinding FontFamily}"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{DynamicResource AppTextSecondary}"
                                           Text="{DynamicResource S.Common.SearchLanguage}"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="28,0,8,0"
                                              VerticalAlignment="Center"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Focusable="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppInputFocusBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin is the room the shadow is drawn in, as on the capsule; the LayoutTransform is set
         in code for the same mixed-DPI reason. Deeper than the capsule's shadow, because this lies
         over the capsule's own neighbourhood and has to read as the thing in front. -->
    <Border x:Name="RootChrome" Margin="18,16,18,22" Background="Transparent">
        <Grid>
            <!-- Shadow on an empty twin, not on the menu: see the capsule for why an Effect on the
                 surface that carries the text would cost it ClearType. -->
            <Border Background="{DynamicResource ToolbarBg}"
                    Margin="2"
                    CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect x:Name="Shadow"
                                      BlurRadius="24" ShadowDepth="4" Direction="270"
                                      Opacity="0.45" Color="#000000"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Chrome"
                    Background="{DynamicResource ToolbarBg}"
                    BorderBrush="{DynamicResource ToolbarMenuBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6"
                    RenderOptions.ClearTypeHint="Enabled">
                <StackPanel>
                    <TextBlock x:Name="HeaderText"
                               Margin="10,4,10,6"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="11.5"
                               Foreground="{DynamicResource AppTextSecondary}"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource MenuSearchBox}"
                             Margin="2,2,2,6"
                             Visibility="Collapsed"
                             TextChanged="SearchBox_TextChanged"/>

                    <ScrollViewer x:Name="ItemsScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <StackPanel x:Name="ItemsPanel"/>
                    </ScrollViewer>

                    <TextBlock x:Name="NoResultsText"
                               Margin="10"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AppTextSecondary}"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
