<UserControl x:Class="OverTranslate.Views.Shell.ReleaseNotesList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="VersionRow" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource AppCardBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppButtonHoverBg}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card"
            Background="{DynamicResource AppCardBg}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid x:Name="Clipped" SizeChanged="Clipped_SizeChanged">
            <ScrollViewer x:Name="Scroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="Scroller_ScrollChanged">
                <StackPanel x:Name="Items"/>
            </ScrollViewer>

            <!-- WPF has no sticky positioning, so the open version's heading is a second row laid over
                 the top of the list once the real one has scrolled away. -->
            <ToggleButton x:Name="StickyRow"
                          Style="{StaticResource VersionRow}"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Left"
                          IsChecked="True"
                          Visibility="Collapsed"
                          Unchecked="StickyRow_Unchecked">
                <ToggleButton.RenderTransform>
                    <TranslateTransform x:Name="StickyShift"/>
                </ToggleButton.RenderTransform>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
