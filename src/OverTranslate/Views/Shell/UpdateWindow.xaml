<Window x:Class="OverTranslate.Views.Shell.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:OverTranslate.Views.Shell"
        Title="{DynamicResource S.Update.WindowTitle}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        WindowStyle="None"
        Closing="Window_Closing"
        Background="{DynamicResource AppWindowBg}">

    <!-- The same strip the shell draws, for the same reason: this was the last window in the
         application still wearing the system title bar, which follows the system's theme rather
         than the application's and so read as a different program's dialog in dark mode.

         ResizeBorderThickness is 0 where the shell has 6 — this window is sized to its own content
         and has nothing to resize. CaptionHeight still matches the title row below exactly, so the
         strip drags the window and the buttons on it say they are buttons. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════ Title bar ══════════ -->
        <!-- Carries the application's name, not this window's, exactly as the shell's does: the
             window's own title is already the heading below it, and a strip repeating it would say
             the same three words twice. Title is still set on the window itself, where the taskbar
             and Alt+Tab read it from. -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Image x:Name="TitleIcon"
                       Width="16" Height="16"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="OverTranslate"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondary}"/>
            </StackPanel>

            <!-- No maximise: this window is sized to its content and there is nothing to fill a
                 screen with. Close is disabled rather than hidden while the update runs — it says
                 why in a tooltip, which a missing button could not. The Closing handler still
                 refuses as well, because Alt+F4 and the taskbar never touch this button. -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeBtn"
                        Style="{StaticResource WindowCaptionButton}"
                        Content="&#xE921;"
                        Click="MinimizeBtn_Click"/>
                <Button x:Name="CloseBtn"
                        Style="{StaticResource WindowCloseButton}"
                        Content="&#xE8BB;"
                        ToolTipService.ShowOnDisabled="True"
                        Click="CloseBtn_Click"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════ Heading ══════════ -->
            <!-- Beside its mark rather than stacked under it: the height is worth more to the notes.
                 The heading follows what the window is doing, because it is the first thing the eye
                 lands on when 立即更新 is pressed. -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="HeadingMark"
                        Width="40" Height="40"
                        CornerRadius="20"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AppAccentSubtle}">
                    <TextBlock x:Name="HeadingGlyph"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="18" Text="&#xE895;"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppAccent}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadingText"
                               Text="{DynamicResource S.Update.Heading}"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource AppTextPrimary}"/>
                    <!-- Both versions on one line, with the arrow doing what two labels used to. The
                         one being offered carries the accent; the one in use is context. -->
                    <WrapPanel x:Name="VersionLine" Margin="0,2,0,0">
                        <TextBlock x:Name="CurrentVersionText"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="VersionArrow"
                                   Text="→"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   Margin="6,0"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock x:Name="LatestVersionText"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccent}"/>
                        <TextBlock x:Name="VersionCountText"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   Margin="6,0,0,0"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   Visibility="Collapsed"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ══════════ What is in the update ══════════ -->
            <!-- The star row: everything below claims what it needs and the notes take the rest, so
                 the download's progress and warnings shrink this instead of moving the buttons. -->
            <shell:ReleaseNotesList x:Name="NotesList" Grid.Row="1" Visibility="Collapsed"/>

            <!-- ══════════ What pressing update does ══════════ -->
            <StackPanel Grid.Row="2">
                <TextBlock x:Name="ExplanationText"
                           Text="{DynamicResource S.Update.Explanation}"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"
                           TextWrapping="Wrap"
                           Margin="0,8,0,12"
                           Visibility="Collapsed"/>

                <!-- Without notes there is nothing else to read, so the explanation and the way to
                     the notes on GitHub get a card of their own, as they always have. -->
                <Border x:Name="NoNotesCard" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="NoNotesText"
                                   Text="{DynamicResource S.Update.Explanation}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   TextWrapping="Wrap"/>
                        <TextBlock FontFamily="{DynamicResource AppFont}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondary}">
                            <Run x:Name="NotesBeforeRun" Text="{DynamicResource S.Update.NotesBefore}"/><Hyperlink x:Name="ReleaseNotesLink"
                                      Foreground="{DynamicResource AppAccent}"
                                      TextDecorations="None"
                                      RequestNavigate="ReleaseNotesLink_RequestNavigate"
                                      NavigateUri="https://github.com/Hon-Lu/OverTranslate/releases/latest"><Run Text="{DynamicResource S.Update.NotesLink}"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Failures are reported here rather than through a system MessageBox, which was
                     the only OS-styled dialog left in the app and matched nothing around it. -->
                <TextBlock x:Name="ErrorText"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppError}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,8,0,12"/>
            </StackPanel>

            <!-- ══════════ The download ══════════ -->
            <!-- A card in the accent's colours, because it has the notes above it to compete with: as
                 a thin bar and a line of grey text it was easy to press 立即更新 and think nothing
                 had happened. The live readout sits here rather than on the button, which is disabled
                 for part of this and is the lowest contrast in the window when it is. -->
            <Border x:Name="ProgressCard" Grid.Row="3"
                    Background="{DynamicResource AppAccentSubtle}"
                    BorderBrush="{DynamicResource AppAccent}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,10,0,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="PercentText" Grid.Column="1"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppAccent}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress"
                                 Style="{StaticResource SlimProgressBar}"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"/>
                    <!-- Only appears when Velopack gives up on the delta packages and starts the
                         full one. The bar returning to zero halfway through needs a reason given
                         to it, or it reads as the download having failed and silently restarted.
                         Not ErrorText: nothing has gone wrong, the update is simply taking the
                         long road. -->
                    <TextBlock x:Name="FallbackNote"
                               Text="{DynamicResource S.Update.FellBackToFull}"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="11"
                               Foreground="{DynamicResource AppTextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- ══════════ Taking too long ══════════ -->
            <!-- A download that is only slow never fails, so ErrorText never speaks up and the card
                 goes on saying 下載中 for as long as it takes. This appears on its own once the wait
                 has stopped looking normal, and goes away again the moment the update moves on to
                 applying, where fetching the installer by hand would no longer help.

                 In the warning colours rather than the card's own: the card describes the update,
                 and this describes a problem with the machinery delivering it.

                 The link is not touched by SetPhase, so it stays live while the buttons around it
                 are disabled. -->
            <Border x:Name="SlowHint" Grid.Row="4"
                    Padding="16,10"
                    CornerRadius="8"
                    Background="{DynamicResource AppWarningSubtle}"
                    BorderBrush="{DynamicResource AppWarningBorder}"
                    BorderThickness="1"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE823;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource AppWarning}"
                               Margin="0,1,9,0"
                               VerticalAlignment="Top"/>
                    <TextBlock Grid.Column="1"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextPrimary}"
                               TextWrapping="Wrap"><Run Text="{DynamicResource S.Update.SlowBefore}"/><Hyperlink x:Name="SlowHintLink"
                                  Foreground="{DynamicResource AppAccent}"
                                  RequestNavigate="ReleaseNotesLink_RequestNavigate"
                                  NavigateUri="https://github.com/Hon-Lu/OverTranslate/releases/latest"><Run Text="{DynamicResource S.Update.SlowLink}"/><Run Text=" &#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" TextDecorations="None"/></Hyperlink></TextBlock>
                </Grid>
            </Border>

            <!-- ══════════ Answers ══════════ -->
            <StackPanel Grid.Row="5">
                <!-- With no update on offer there is one answer left, and it takes the whole row. -->
                <Button x:Name="HistoryCloseBtn"
                        Content="{DynamicResource S.Common.Close}"
                        Style="{StaticResource FlatButton}"
                        Height="36"
                        Margin="0,12,0,0"
                        Visibility="Collapsed"
                        Click="DismissBtn_Click"/>

                <Grid x:Name="UpdateAnswers">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DismissBtn" Grid.Column="0" Content="{DynamicResource S.Update.Later}"
                            Style="{StaticResource FlatButton}"
                            Height="36"
                            Click="DismissBtn_Click"/>
                    <Button x:Name="DownloadBtn" Grid.Column="2"
                            Style="{StaticResource AccentButton}"
                            Height="36"
                            Click="DownloadBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DownloadBtnGlyph"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Text="&#xE896;"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="DownloadBtnText" Text="{DynamicResource S.Update.Now}"
                                       FontFamily="{DynamicResource AppFont}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Below the pair rather than beside it, and unstyled as a link rather than a third
                     button: Later and Update now are the two answers to the question being asked, while
                     this one changes what the application does in future. Giving it equal weight in the
                     row would put a lasting choice one mis-click away from the dismiss button it would
                     sit next to. -->
                <TextBlock x:Name="SkipLine"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}">
                    <Hyperlink x:Name="SkipVersionLink"
                               Foreground="{DynamicResource AppTextSecondary}"
                               TextDecorations="None"
                               Click="SkipVersionLink_Click"><Run Text="{DynamicResource S.Update.Skip}"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
