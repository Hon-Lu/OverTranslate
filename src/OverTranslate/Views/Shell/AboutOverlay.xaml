<UserControl x:Class="OverTranslate.Views.Shell.AboutOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="True">

    <!-- Scrim: swallows clicks so the page underneath stays inert, and dismisses on click -->
    <Grid x:Name="Scrim"
          Background="#8C000000"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

        <!-- The card is centred in the scrim, so at an odd window width its left edge lands on a
             half pixel and WPF's default Ideal text formatting happily sub-pixel-positions every
             glyph there, leaving the whole card looking soft. Layout rounding snaps the card to
             whole device pixels so the text inside always starts on the pixel grid. -->
        <Border x:Name="Card"
                Width="400"
                UseLayoutRounding="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="{DynamicResource AppCardBg}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1"
                RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Close button floats over the title block's top-right corner -->
                <Button Grid.Row="0"
                        Style="{StaticResource OverlayCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,-4,-8,0"
                        ToolTip="{DynamicResource S.Common.Close}"
                        Click="CloseBtn_Click"/>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="24,4,24,18">
                    <TextBlock Text="OverTranslate"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimary}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="VersionText"
                               FontFamily="{DynamicResource AppFont}"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppSeparator}"/>

                <StackPanel Grid.Row="2" Margin="0,16,0,16">
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource S.About.Author}"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   HorizontalAlignment="Left"/>
                        <TextBlock Text="Hon.Lu (asd880921)"
                                   FontFamily="{DynamicResource AppFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimary}"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- The site is the front door — feature tour, download, guides — and it picks
                         its language from the browser, so a single URL serves every locale. It
                         takes the accent so the card has one obvious destination; the repository
                         is still one click away from there. The icon inherits AppAccentFg from the
                         button rather than naming a brush, so it flips with the theme. -->
                    <Button Style="{StaticResource AccentButton}"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"
                            Click="WebsiteBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Text="&#xE774;"
                                       Width="22" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource S.About.Website}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppFont}"/>
                        </StackPanel>
                    </Button>

                    <!-- GitHub is worth a button, but reading the source is not what most people
                         open this card for — starring is the one thing they can do that helps. The
                         glyph is the same accent star the sentence below uses, so the button and
                         the ask read as one thought. -->
                    <Button Style="{StaticResource FlatButton}"
                            Height="34"
                            HorizontalAlignment="Stretch"
                            Click="StarBtn_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Text="&#xE735;"
                                       Width="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppAccent}"/>
                            <TextBlock Text="{DynamicResource S.About.Star}"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppFont}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- The reader is already using the app, so a feature pitch here has no audience.
                     What they cannot know from the UI is that it is free and open source, and that
                     starring it actually helps. It no longer names GitHub — the button directly
                     above says where, so this only has to say why. The star is drawn from the icon
                     font rather than the ⭐ emoji: WPF has no colour-font support, so the emoji
                     would fall back to a black-and-white glyph at an unpredictable size. -->
                <TextBlock Grid.Row="3"
                           FontFamily="{DynamicResource AppFont}"
                           FontSize="12"
                           Foreground="{DynamicResource AppTextSecondary}"
                           TextWrapping="Wrap"
                           LineHeight="18">
                    <Run Text="{DynamicResource S.About.OpenSourceBefore}"/>
                    <Run Text="&#xE735;"
                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                         FontSize="11"
                         Foreground="{DynamicResource AppAccent}"/>
                    <Run Text="{DynamicResource S.About.OpenSourceAfter}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
