<Project Sdk="Microsoft.NET.Sdk">

  <!-- The online engines the application talks to directly: the free Google, Microsoft and Bing,
       each spoken to in the request shape that serves it best rather than the one-text-per-call
       shape GTranslate offers for all of them, and DeepL with the user's own key. Plain net8.0
       and nothing from the application — no WPF, no settings, no OCR types — so what an engine
       accepts and returns can be read, tested and reasoned about without the rest of the program
       in the way.

       Named for what it does, which is the rule for every project split out of the application:
       one project per job, not one per vendor. Translation in every form belongs here — dictionary
       lookups when they leave GTranslate, and the OpenAI-compatible provider when it leaves the
       application. Reading text aloud is here too, in Speech/: it is the other half of what the
       translator does with a text, and it talks to the same endpoints with the same credentials. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OverTranslate.Translation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The application's own logger, so a request's timing and outcome land in the same file as
         everything else that happened around it. -->
    <PackageReference Include="NLog" Version="5.0.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OverTranslate.Tests" />
  </ItemGroup>

</Project>
